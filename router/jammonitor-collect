#!/bin/sh
# JamMonitor Historical Metrics Collector v5
# Collects metrics every MINUTE (not second) to minimize storage
# 24h = ~1,440 entries (~300KB) vs previous ~86,400 entries (~18MB)

LIB_ONLY="${JAMMONITOR_LIB_ONLY:-0}"
RUNTIME_DIR="${JAMMONITOR_RUNTIME_DIR:-/var/run/jammonitor}"
PIDFILE="${JAMMONITOR_PIDFILE:-/var/run/jammonitor-collect.pid}"
LOCK_FILE="${JAMMONITOR_LOCK_FILE:-${PIDFILE}.lock}"
SYSLOG_LOCK_FILE="${JAMMONITOR_SYSLOG_LOCK_FILE:-${RUNTIME_DIR}/syslog-stream.lock}"
PROC_ROOT="${JAMMONITOR_PROC_ROOT:-/proc}"
PROC_STAT_CMD="${JAMMONITOR_PROC_STAT_CMD:-cat}"
STATUS_FILE="${RUNTIME_DIR}/collector-status.json"
MOUNT_POINT="${JAMMONITOR_MOUNT_POINT:-/mnt/data}"
PROC_MOUNTS="${JAMMONITOR_PROC_MOUNTS:-/proc/mounts}"
PROC_MOUNTINFO="${JAMMONITOR_PROC_MOUNTINFO:-/proc/self/mountinfo}"
FDINFO_ROOT="${JAMMONITOR_FDINFO_ROOT:-/proc/self/fdinfo}"
FD_ROOT="${JAMMONITOR_FD_ROOT:-/proc/self/fd}"
SYS_CLASS_BLOCK_ROOT="${JAMMONITOR_SYS_CLASS_BLOCK_ROOT:-/sys/class/block}"
FSTAB_CONFIG="${JAMMONITOR_FSTAB_CONFIG:-/etc/config/fstab}"
STORAGE_RECOVERY_JOURNAL="${JAMMONITOR_STORAGE_RECOVERY_JOURNAL:-/etc/jammonitor_storage_mount_recovery.json}"
STORAGE_RECOVERY_FAILED="${JAMMONITOR_STORAGE_RECOVERY_FAILED:-/etc/jammonitor_storage_mount_recovery_failed}"
DATA_DIR="${MOUNT_POINT}/jammonitor"
DB_PATH="${DATA_DIR}/history.db"
LOG_PATH="${DATA_DIR}/syslog.txt"
SYSLOG_PID=""
WATCHDOG_SNAPSHOT_FILE=""
VOLATILE_SNAPSHOT_FILE=""
SQLITE_CMD="${JAMMONITOR_SQLITE_CMD:-sqlite3}"
TIMEOUT_CMD="${JAMMONITOR_TIMEOUT_CMD:-${JAMMONITOR_SQLITE_TIMEOUT_CMD:-timeout}}"
SQLITE_TIMEOUT_CMD="${JAMMONITOR_SQLITE_TIMEOUT_CMD:-$TIMEOUT_CMD}"
SQLITE_TIMEOUT_SECONDS="${JAMMONITOR_SQLITE_TIMEOUT_SECONDS:-15}"
CONNTRACK_CMD="${JAMMONITOR_CONNTRACK_CMD:-conntrack}"
CONNTRACK_TIMEOUT_SECONDS="${JAMMONITOR_CONNTRACK_TIMEOUT_SECONDS:-10}"
# ulimit -f is expressed in 512-byte blocks on the target BusyBox shell.
# Bound the complete producer before any parser reads it so a compromised or
# pathological conntrack command cannot fill the private runtime tmpfs.
CONNTRACK_SNAPSHOT_BLOCKS=2048
FLOCK_CMD="${JAMMONITOR_FLOCK_CMD:-flock}"
LOGREAD_CMD="${JAMMONITOR_LOGREAD_CMD:-logread}"
DD_CMD="${JAMMONITOR_DD_CMD:-dd}"
MKTEMP_CMD="${JAMMONITOR_MKTEMP_CMD:-mktemp}"
STAT_CMD="${JAMMONITOR_STAT_CMD:-stat}"
UCI_CMD="${JAMMONITOR_UCI_CMD:-uci}"
BLOCK_CMD="${JAMMONITOR_BLOCK_CMD:-block}"
SYNC_CMD="${JAMMONITOR_SYNC_CMD:-sync}"
RANDOM_UUID_FILE="${JAMMONITOR_RANDOM_UUID_FILE:-/proc/sys/kernel/random/uuid}"
EXPECTED_VOLATILE_UID="${JAMMONITOR_EXPECTED_VOLATILE_UID:-0}"
EXPECTED_STORAGE_UID="${JAMMONITOR_EXPECTED_STORAGE_UID:-0}"
EXPECTED_STORAGE_GID="${JAMMONITOR_EXPECTED_STORAGE_GID:-0}"
PINNED_STORAGE_TOKEN=""
PINNED_STORAGE_SOURCE=""
PINNED_STORAGE_UUID=""
PINNED_STORAGE_KERNEL_ID=""
PINNED_STORAGE_MOUNT_ID=""
WATCHDOG_SNAPSHOT_MAX_BYTES=65536
WATCHDOG_COPY_TIMEOUT_SECONDS=2
DHCP_LEASES_MAX_BYTES=262144
RESOLV_CONF_MAX_BYTES=65536
VOLATILE_COPY_TIMEOUT_SECONDS=2
SYSLOG_STOP_GRACE_SECONDS=3
LEGACY_SYSLOG_SCAN_BLOCKS=4096
LEGACY_SYSLOG_SCAN_TIMEOUT_SECONDS=10
LEGACY_SYSLOG_MAX_LEAVES=4096
STORAGE_SYNC_TIMEOUT_SECONDS=15

RETENTION_DAYS=30
RETENTION_DAYS_RAW=30      # Keep raw per-client data for 30 days
DISK_THRESHOLD=80          # Start cleanup when disk usage exceeds this %
MAX_LOG_SIZE=10485760      # Rotate the streamed system log at 10 MiB
WAN_CONFIG="/etc/jammonitor_wans"
# Counter baselines and scratch files are root-owned service state. Keeping
# their predictable names inside the collector's private runtime directory
# prevents an unprivileged /tmp symlink from redirecting root writes.
CLIENT_SNAPSHOT="${JAMMONITOR_CLIENT_SNAPSHOT:-${RUNTIME_DIR}/client-traffic}"
DHCP_LEASES="${JAMMONITOR_DHCP_LEASES:-/tmp/dhcp.leases}"
RESOLV_CONF="${JAMMONITOR_RESOLV_CONF:-/tmp/resolv.conf}"
ARP_TABLE="${JAMMONITOR_ARP_TABLE:-/proc/net/arp}"

umask 077
if [ "$LIB_ONLY" != "1" ]; then
    # /var/run is root-owned, but fail closed if the configured runtime path
    # is a symlink or cannot be made private. Every predictable scratch file
    # below inherits this directory as its trust boundary.
    if [ -L "$RUNTIME_DIR" ]; then
        exit 1
    fi
    mkdir -p "$RUNTIME_DIR" || exit 1
    [ -d "$RUNTIME_DIR" ] || exit 1
    chmod 0700 "$RUNTIME_DIR" || exit 1
fi

proc_start_ticks() {
    _lock_stat="$("$PROC_STAT_CMD" "$PROC_ROOT/$1/stat" 2>/dev/null)" ||
        return 1
    # The comm field is parenthesized and may itself contain spaces or right
    # parentheses. Strip through the final ") "; starttime (field 22 in the
    # complete record) is then field 20.
    _lock_tail="${_lock_stat##*) }"
    set -- $_lock_tail
    [ "$#" -ge 20 ] || return 1
    shift 19
    case "${1:-}" in
        ""|*[!0-9]*|0) return 1 ;;
        *) printf '%s\n' "$1" ;;
    esac
}

collector_generation_is_live() {
    _generation_pid="${1:-}"
    _generation_ticks="${2:-}"
    case "$_generation_pid" in
        ""|*[!0-9]*|0|1) return 1 ;;
    esac
    case "$_generation_ticks" in
        ""|*[!0-9]*|0) return 1 ;;
    esac

    _generation_stat="$("$PROC_STAT_CMD" \
        "$PROC_ROOT/$_generation_pid/stat" 2>/dev/null)" || return 1
    # After the final ") ", item 1 is state (field 3) and item 20 is
    # starttime (field 22). Checking both the immutable starttime and a
    # non-zombie state prevents PID reuse or an unreaped killed collector from
    # keeping its stream alive.
    _generation_tail="${_generation_stat##*) }"
    set -- $_generation_tail
    [ "$#" -ge 20 ] || return 1
    case "${1:-}" in
        Z|X|x|"") return 1 ;;
    esac
    shift 19
    [ "${1:-}" = "$_generation_ticks" ]
}

collector_identity() {
    _lock_identity="${0##*/}"
    _lock_identity="$(printf '%s' "$_lock_identity" |
        tr -cd 'A-Za-z0-9._-' | cut -c1-64)"
    [ -n "$_lock_identity" ] || _lock_identity="jammonitor-collect"
    printf '%s\n' "$_lock_identity"
}

acquire_collector_lock() {
    COLLECTOR_START_TICKS="$(proc_start_ticks "$$")" || {
        logger -t jammonitor \
            "FATAL: cannot prove collector process generation for PID $$"
        return 1
    }
    COLLECTOR_IDENTITY="$(collector_identity)"

    # Descriptor 9 remains open for the collector lifetime. The kernel lock,
    # not stale PID-file contents, is the singleton authority. This prevents
    # PID reuse and simultaneous check-then-write starts from creating two
    # writers. The persistent lock file is intentionally not unlinked.
    exec 9<>"$LOCK_FILE" || {
        logger -t jammonitor "FATAL: cannot open collector lock $LOCK_FILE"
        return 1
    }
    if ! "$FLOCK_CMD" -n 9; then
        logger -t jammonitor "Collector already owns $LOCK_FILE; exiting"
        return 2
    fi

    {
        printf 'pid=%s\n' "$$"
        printf 'start_ticks=%s\n' "$COLLECTOR_START_TICKS"
        printf 'identity=%s\n' "$COLLECTOR_IDENTITY"
    } > "$LOCK_FILE" || {
        logger -t jammonitor "FATAL: cannot publish collector lock metadata"
        return 1
    }

    _pid_tmp="${PIDFILE}.tmp.$$"
    if ! printf '%s\n' "$$" > "$_pid_tmp" ||
       ! mv -f "$_pid_tmp" "$PIDFILE"; then
        rm -f "$_pid_tmp"
        logger -t jammonitor "FATAL: cannot publish collector PID"
        return 1
    fi
    return 0
}

remove_owned_pidfile() {
    _owned_pid="$(cat "$PIDFILE" 2>/dev/null)"
    if [ "$_owned_pid" = "$$" ]; then
        rm -f "$PIDFILE"
    fi
}

release_watchdog_snapshot() {
    if [ -n "$WATCHDOG_SNAPSHOT_FILE" ]; then
        case "$WATCHDOG_SNAPSHOT_FILE" in
            "${RUNTIME_DIR}/tailscale-watchdog.snapshot."*)
                rm -f "$WATCHDOG_SNAPSHOT_FILE" 8>&- 9>&-
                ;;
        esac
        WATCHDOG_SNAPSHOT_FILE=""
    fi
}

release_volatile_snapshot() {
    if [ -n "$VOLATILE_SNAPSHOT_FILE" ]; then
        case "$VOLATILE_SNAPSHOT_FILE" in
            "${RUNTIME_DIR}/volatile."*)
                rm -f "$VOLATILE_SNAPSHOT_FILE" 8>&- 9>&-
                ;;
        esac
        VOLATILE_SNAPSHOT_FILE=""
    fi
}

cleanup_processes() {
    if [ -n "$SYSLOG_PID" ]; then
        kill "$SYSLOG_PID" 2>/dev/null || true
        wait "$SYSLOG_PID" 2>/dev/null || true
    fi
    release_watchdog_snapshot
    release_volatile_snapshot
    # Never unlink the persistent lock inode. Closing descriptor 9 releases
    # ownership atomically; removing only our legacy PID file cannot erase a
    # successor's metadata.
    remove_owned_pidfile
}

handle_signal() {
    exit 0
}

if [ "$LIB_ONLY" != "1" ]; then
    command -v "$FLOCK_CMD" >/dev/null 2>&1 || {
        logger -t jammonitor \
            "FATAL: kernel lock command is unavailable: $FLOCK_CMD"
        exit 1
    }
    acquire_collector_lock
    _lock_rc=$?
    if [ "$_lock_rc" -eq 2 ]; then
        exit 0
    elif [ "$_lock_rc" -ne 0 ]; then
        exit 1
    fi
    trap cleanup_processes EXIT
    trap handle_signal INT TERM
fi

# The mount must be a real filesystem, not the root overlay beneath an absent
# USB drive. Failing closed lets procd retry without filling internal flash.
data_mount_is_safe() {
    awk -v mount_point="$MOUNT_POINT" '
        $2 == mount_point {
            matches += 1
            options = "," $4 ","
            if ($3 == "ext4" &&
                options ~ /,rw,/ &&
                options !~ /,ro,/) {
                valid += 1
            }
        }
        END { exit(matches == 1 && valid == 1 ? 0 : 1) }
    ' "$PROC_MOUNTS" 2>/dev/null
}

storage_recovery_is_pending() {
    [ -e "$STORAGE_RECOVERY_JOURNAL" ] ||
        [ -L "$STORAGE_RECOVERY_JOURNAL" ] ||
        [ -e "$STORAGE_RECOVERY_FAILED" ] ||
        [ -L "$STORAGE_RECOVERY_FAILED" ]
}

storage_fstab_uuid() {
    [ -f "$FSTAB_CONFIG" ] && [ ! -L "$FSTAB_CONFIG" ] || return 1
    _storage_fstab_meta="$("$STAT_CMD" -c '%F|%u|%h|%s' \
        "$FSTAB_CONFIG" 2>/dev/null)" || return 1
    _storage_fstab_type="${_storage_fstab_meta%%|*}"
    _storage_fstab_rest="${_storage_fstab_meta#*|}"
    _storage_fstab_uid="${_storage_fstab_rest%%|*}"
    _storage_fstab_rest="${_storage_fstab_rest#*|}"
    _storage_fstab_links="${_storage_fstab_rest%%|*}"
    _storage_fstab_size="${_storage_fstab_rest##*|}"
    [ "$_storage_fstab_type" = "regular file" ] &&
        [ "$_storage_fstab_uid" = "$EXPECTED_STORAGE_UID" ] &&
        [ "$_storage_fstab_links" = "1" ] || return 1
    case "$_storage_fstab_size" in
        ""|*[!0-9]*) return 1 ;;
    esac
    [ "$_storage_fstab_size" -le 32768 ] || return 1

    _storage_fstab_dump="$(
        "$TIMEOUT_CMD" 5 "$UCI_CMD" -q show fstab 2>/dev/null
    )" || return 1
    [ "${#_storage_fstab_dump}" -le 32768 ] || return 1
    _storage_target_sections="$(
        printf '%s\n' "$_storage_fstab_dump" |
            awk -F= -v target="$MOUNT_POINT" '
                $1 ~ /^fstab\..+\.target$/ &&
                    $2 == "\047" target "\047" {
                    section = $1
                    sub(/^fstab\./, "", section)
                    sub(/\.target$/, "", section)
                    print section
                }
            '
    )"
    [ -n "$_storage_target_sections" ] || return 1
    [ "$(printf '%s\n' "$_storage_target_sections" | wc -l |
        tr -d ' ')" = "1" ] || return 1
    _storage_section="$_storage_target_sections"
    [ "${#_storage_section}" -le 128 ] || return 1

    _storage_type="$(
        "$TIMEOUT_CMD" 5 "$UCI_CMD" -q get \
            "fstab.${_storage_section}" 2>/dev/null
    )" || return 1
    [ "$_storage_type" = "mount" ] || return 1
    _storage_uuid="$(
        "$TIMEOUT_CMD" 5 "$UCI_CMD" -q get \
            "fstab.${_storage_section}.uuid" 2>/dev/null
    )" || return 1
    case "$_storage_uuid" in
        ""|*[!A-Fa-f0-9-]*) return 1 ;;
    esac
    [ "${#_storage_uuid}" -ge 8 ] &&
        [ "${#_storage_uuid}" -le 64 ] || return 1
    _storage_enabled="$(
        "$TIMEOUT_CMD" 5 "$UCI_CMD" -q get \
            "fstab.${_storage_section}.enabled" 2>/dev/null
    )" || return 1
    [ "$_storage_enabled" = "1" ] || return 1

    _storage_prefix="fstab.${_storage_section}"
    if printf '%s\n' "$_storage_fstab_dump" |
       grep -Fq "${_storage_prefix}.fstype="; then
        [ "$("$TIMEOUT_CMD" 5 "$UCI_CMD" -q get \
            "${_storage_prefix}.fstype" 2>/dev/null)" = "ext4" ] || return 1
    fi
    printf '%s\n' "$_storage_fstab_dump" |
        grep -Fq "${_storage_prefix}.options=" || return 1
    [ "$("$TIMEOUT_CMD" 5 "$UCI_CMD" -q get \
        "${_storage_prefix}.options" 2>/dev/null)" = \
        "rw,noatime,nosuid,nodev,noexec" ] || return 1
    if printf '%s\n' "$_storage_fstab_dump" |
       grep -Eq "^${_storage_prefix}\\.(device|label)="; then
        return 1
    fi
    printf '%s\n' "$_storage_uuid"
}

storage_mount_row() {
    awk -v mount_point="$MOUNT_POINT" '
        $2 == mount_point {
            matches += 1
            source = $1
            fstype = $3
            options = "," $4 ","
        }
        END {
            if (matches == 1 &&
                source ~ /^\/dev\/sd[a-z][1-9][0-9]*$/ &&
                fstype == "ext4" &&
                options ~ /,rw,/ &&
                options !~ /,ro,/ &&
                options ~ /,noatime,/ &&
                options ~ /,nosuid,/ &&
                options ~ /,nodev,/ &&
                options ~ /,noexec,/) {
                sub(/^,/, "", options)
                sub(/,$/, "", options)
                print source "|" options
                exit 0
            }
            exit 1
        }
    ' "$PROC_MOUNTS" 2>/dev/null
}

storage_mount_id() {
    awk -v mount_point="$MOUNT_POINT" '
        $5 == mount_point {
            matches += 1
            mount_id = $1
        }
        END {
            if (matches == 1 && mount_id ~ /^[1-9][0-9]*$/) {
                print mount_id
                exit 0
            }
            exit 1
        }
    ' "$PROC_MOUNTINFO" 2>/dev/null
}

pinned_fd_mount_id() {
    awk '
        $1 == "mnt_id:" && $2 ~ /^[1-9][0-9]*$/ {
            matches += 1
            mount_id = $2
        }
        END {
            if (matches == 1) {
                print mount_id
                exit 0
            }
            exit 1
        }
    ' "${FDINFO_ROOT}/8" 2>/dev/null
}

prove_storage_authority() {
    storage_recovery_is_pending && return 1
    _storage_mount_row="$(storage_mount_row)" || return 1
    _storage_source="${_storage_mount_row%%|*}"
    _storage_options="${_storage_mount_row#*|}"
    _storage_name="${_storage_source#/dev/}"
    _storage_disk="${_storage_name%%[0-9]*}"
    _storage_partition="${_storage_name#$_storage_disk}"
    case "$_storage_disk" in sd[a-z]) ;; *) return 1 ;; esac
    case "$_storage_partition" in
        ""|0|*[!0-9]*) return 1 ;;
    esac

    _storage_kernel_id="$(
        sed -n '1{s/[[:space:]]//g;p;}' \
            "${SYS_CLASS_BLOCK_ROOT}/${_storage_name}/dev" 2>/dev/null
    )" || return 1
    case "$_storage_kernel_id" in
        *[!0-9:]*|:*|*:) return 1 ;;
    esac
    [ "$(
        sed -n '1{s/[[:space:]]//g;p;}' \
            "${SYS_CLASS_BLOCK_ROOT}/${_storage_name}/partition" 2>/dev/null
    )" = "$_storage_partition" ] || return 1
    [ "$(
        sed -n '1{s/[[:space:]]//g;p;}' \
            "${SYS_CLASS_BLOCK_ROOT}/${_storage_disk}/removable" 2>/dev/null
    )" = "1" ] || return 1

    _storage_source_meta="$("$STAT_CMD" -L -c '%F|%t:%T' \
        "$_storage_source" 2>/dev/null)" || return 1
    [ "${_storage_source_meta%%|*}" = "block special file" ] || return 1

    _storage_fstab_uuid="$(storage_fstab_uuid)" || return 1
    _storage_selected_info="$(
        "$TIMEOUT_CMD" 5 "$BLOCK_CMD" info "$_storage_source" 2>/dev/null
    )" || return 1
    [ "${#_storage_selected_info}" -le 4096 ] || return 1
    _storage_selected="$(
        printf '%s\n' "$_storage_selected_info" |
            awk -v source="$_storage_source" '
                $1 == source ":" {
                    lines += 1
                    for (i = 2; i <= NF; i += 1) {
                        value = $i
                        if (value ~ /^UUID="/) {
                            sub(/^UUID="/, "", value)
                            sub(/"$/, "", value)
                            uuid = value
                        } else if (value ~ /^TYPE="/) {
                            sub(/^TYPE="/, "", value)
                            sub(/"$/, "", value)
                            type = value
                        } else if (value ~ /^MOUNT="/) {
                            sub(/^MOUNT="/, "", value)
                            sub(/"$/, "", value)
                            mount = value
                        }
                    }
                }
                END {
                    if (lines == 1 && uuid != "" && type != "" &&
                        mount != "") {
                        print uuid "|" type "|" mount
                        exit 0
                    }
                    exit 1
                }
            '
    )" || return 1
    _storage_live_uuid="${_storage_selected%%|*}"
    _storage_selected_rest="${_storage_selected#*|}"
    _storage_live_type="${_storage_selected_rest%%|*}"
    _storage_live_mount="${_storage_selected_rest#*|}"
    [ "$_storage_live_uuid" = "$_storage_fstab_uuid" ] &&
        [ "$_storage_live_type" = "ext4" ] &&
        [ "$_storage_live_mount" = "$MOUNT_POINT" ] || return 1

    _storage_all_info="$(
        "$TIMEOUT_CMD" 5 "$BLOCK_CMD" info 2>/dev/null
    )" || return 1
    [ "${#_storage_all_info}" -le 65536 ] || return 1
    _storage_uuid_count="$(
        printf '%s\n' "$_storage_all_info" |
            awk -v uuid="$_storage_fstab_uuid" '
                {
                    for (i = 2; i <= NF; i += 1) {
                        value = $i
                        if (value ~ /^UUID="/) {
                            sub(/^UUID="/, "", value)
                            sub(/"$/, "", value)
                            if (value == uuid) matches += 1
                        }
                    }
                }
                END { print matches + 0 }
            '
    )"
    [ "$_storage_uuid_count" = "1" ] || return 1

    _storage_mount_id="$(storage_mount_id)" || return 1
    _storage_root_meta="$("$STAT_CMD" -L -c '%F|%u|%g|%a|%d|%i' \
        "$MOUNT_POINT" 2>/dev/null)" || return 1
    IFS='|' read -r _storage_root_type _storage_root_uid \
        _storage_root_gid _storage_root_mode _storage_root_dev \
        _storage_root_ino <<EOF
$_storage_root_meta
EOF
    [ "$_storage_root_type" = "directory" ] &&
        [ "$_storage_root_uid" = "$EXPECTED_STORAGE_UID" ] &&
        [ "$_storage_root_gid" = "$EXPECTED_STORAGE_GID" ] || return 1
    case "$_storage_root_mode" in
        ""|*[!0-9]*|*[2367][0-7]|*[0-7][2367]) return 1 ;;
    esac
    [ -w "$MOUNT_POINT" ] || return 1

    PROVED_STORAGE_SOURCE="$_storage_source"
    PROVED_STORAGE_UUID="$_storage_live_uuid"
    PROVED_STORAGE_KERNEL_ID="$_storage_kernel_id"
    PROVED_STORAGE_MOUNT_ID="$_storage_mount_id"
    PROVED_STORAGE_ROOT_DEV="$_storage_root_dev"
    PROVED_STORAGE_ROOT_INO="$_storage_root_ino"
    PROVED_STORAGE_TOKEN="${_storage_source}|${_storage_live_uuid}|${_storage_kernel_id}|${_storage_mount_id}|${_storage_root_dev}|${_storage_root_ino}|${_storage_options}"
    return 0
}

storage_authority_is_current() {
    prove_storage_authority || return 1
    if [ -n "$PINNED_STORAGE_TOKEN" ]; then
        [ "$PROVED_STORAGE_TOKEN" = "$PINNED_STORAGE_TOKEN" ] || return 1
        _storage_fd_mount_id="$(pinned_fd_mount_id)" || return 1
        [ "$_storage_fd_mount_id" = "$PINNED_STORAGE_MOUNT_ID" ] &&
            [ "$_storage_fd_mount_id" = "$PROVED_STORAGE_MOUNT_ID" ] ||
            return 1
        _storage_fd_dev="$("$STAT_CMD" -L -c '%d' \
            "${FD_ROOT}/8" 2>/dev/null)" || return 1
        [ "$_storage_fd_dev" = "$PROVED_STORAGE_ROOT_DEV" ] || return 1
    fi
    return 0
}

require_data_mount() {
    if [ -L "$MOUNT_POINT" ] || [ ! -d "$MOUNT_POINT" ]; then
        logger -t jammonitor \
            "FATAL: $MOUNT_POINT is not a real mount directory"
        return 1
    fi
    if ! storage_authority_is_current; then
        logger -t jammonitor \
            "FATAL: $MOUNT_POINT source, UUID, fstab, mount generation, or ownership authority is unproven"
        return 1
    fi
    return 0
}

storage_leaf_names_are_line_safe() {
    _storage_name_dir="$1"
    _storage_name_timeout="$2"
    _storage_name_nonce="$(sed -n '1p' "$RANDOM_UUID_FILE" \
        2>/dev/null)" || return 1
    case "$_storage_name_nonce" in
        ""|*[!A-Fa-f0-9-]*) return 1 ;;
    esac

    # POSIX pathnames may contain newlines. Both bounded tree parsers below
    # are intentionally line-oriented, so prove first that every top-level
    # leaf name is line-safe. Any matching pathname contributes bytes before
    # the completion sentinel and therefore fails the exact comparison. head
    # bounds captured output, while timeout -k bounds a producer that ignores
    # TERM or scans an attacker-created directory with extreme fanout.
    _storage_name_newline='
'
    _storage_name_probe="$(
        {
            "$TIMEOUT_CMD" -s TERM -k 2 "$_storage_name_timeout" \
                find -H "$_storage_name_dir" -xdev \
                    -mindepth 1 -maxdepth 1 \
                    -name "*${_storage_name_newline}*" -print 2>/dev/null
            _storage_name_rc=$?
            printf '%s:%s\n' \
                "$_storage_name_nonce" "$_storage_name_rc"
        } | head -c 8192
    )"
    [ "$_storage_name_probe" = "${_storage_name_nonce}:0" ]
}

storage_sync_barrier() {
    "$TIMEOUT_CMD" -s TERM -k 2 \
        "$STORAGE_SYNC_TIMEOUT_SECONDS" "$SYNC_CMD"
}

storage_data_tree_is_safe() {
    _storage_data_dir="$1"
    [ -d "$_storage_data_dir" ] && [ ! -L "$_storage_data_dir" ] ||
        return 1

    _storage_meta="$("$STAT_CMD" -c '%F|%u|%g|%a' \
        "$_storage_data_dir" 2>/dev/null)" || return 1
    [ "$_storage_meta" = \
        "directory|${EXPECTED_STORAGE_UID}|${EXPECTED_STORAGE_GID}|700" ] ||
        return 1
    storage_leaf_names_are_line_safe "$_storage_data_dir" 5 || return 1

    # Bound the offline-controlled directory fanout before inspecting leaves.
    # The fresh kernel UUID makes a crafted filename unable to forge the
    # completion sentinel; head closes the producer after 65 entries.
    _storage_walk_nonce="$(sed -n '1p' "$RANDOM_UUID_FILE" \
        2>/dev/null)" || return 1
    case "$_storage_walk_nonce" in
        ""|*[!A-Fa-f0-9-]*) return 1 ;;
    esac
    _storage_walk="$(
        {
            "$TIMEOUT_CMD" 5 find "$_storage_data_dir" -xdev \
                -mindepth 1 -maxdepth 1 -print 2>/dev/null
            _storage_walk_rc=$?
            printf '%s:%s\n' "$_storage_walk_nonce" "$_storage_walk_rc"
        } | head -n 66
    )"
    _storage_count=0
    _storage_complete=0
    while IFS= read -r _storage_leaf; do
        if [ "$_storage_leaf" = "${_storage_walk_nonce}:0" ]; then
            _storage_complete=$((_storage_complete + 1))
            continue
        fi
        _storage_count=$((_storage_count + 1))
        [ "$_storage_count" -le 64 ] || return 1
        _storage_name="${_storage_leaf##*/}"
        case "$_storage_name" in
            history.db|history.db-wal|history.db-shm|history.db-journal|\
            syslog.txt|syslog.txt.old|iface_snapshot.current|\
            iface_snapshot.last)
                ;;
            syslog.txt.[1-9]|syslog.txt.[1-9][0-9]*)
                case "${_storage_name#syslog.txt.}" in
                    *[!0-9]*) return 1 ;;
                esac
                ;;
            *)
                return 1
                ;;
        esac
        _storage_leaf_meta="$("$STAT_CMD" -c '%F|%u|%g|%h|%a' \
            "$_storage_leaf" 2>/dev/null)" || return 1
        IFS='|' read -r _storage_leaf_type _storage_leaf_uid \
            _storage_leaf_gid _storage_leaf_links _storage_leaf_mode <<EOF
$_storage_leaf_meta
EOF
        [ "$_storage_leaf_type" = "regular file" ] &&
            [ "$_storage_leaf_uid" = "$EXPECTED_STORAGE_UID" ] &&
            [ "$_storage_leaf_gid" = "$EXPECTED_STORAGE_GID" ] &&
            [ "$_storage_leaf_links" = "1" ] || return 1
        case "$_storage_leaf_mode" in
            ""|*[!0-9]*|*[2367][0-7]|*[0-7][2367]) return 1 ;;
        esac
    done <<EOF
$_storage_walk
EOF
    [ "$_storage_complete" -eq 1 ]
}

legacy_storage_leaf_is_safe() {
    _legacy_check_path="$1"
    _legacy_check_meta="$("$STAT_CMD" -c '%F|%u|%g|%h|%a' \
        "$_legacy_check_path" 2>/dev/null)" || return 1
    IFS='|' read -r _legacy_check_type _legacy_check_uid \
        _legacy_check_gid _legacy_check_links _legacy_check_mode <<EOF
$_legacy_check_meta
EOF
    [ "$_legacy_check_type" = "regular file" ] &&
        [ "$_legacy_check_uid" = "$EXPECTED_STORAGE_UID" ] &&
        [ "$_legacy_check_gid" = "$EXPECTED_STORAGE_GID" ] &&
        [ "$_legacy_check_links" = "1" ] || return 1
    case "$_legacy_check_mode" in
        ""|*[!0-9]*|*[2367][0-7]|*[0-7][2367]) return 1 ;;
    esac
}

migrate_legacy_syslog_rotations() {
    _legacy_data_dir="$1"
    [ -d "$_legacy_data_dir" ] && [ ! -L "$_legacy_data_dir" ] ||
        return 1
    _legacy_dir_meta="$("$STAT_CMD" -c '%F|%u|%g|%a' \
        "$_legacy_data_dir" 2>/dev/null)" || return 1
    [ "$_legacy_dir_meta" = \
        "directory|${EXPECTED_STORAGE_UID}|${EXPECTED_STORAGE_GID}|700" ] ||
        return 1
    require_data_mount || return 1
    storage_leaf_names_are_line_safe \
        "$_legacy_data_dir" "$LEGACY_SYSLOG_SCAN_TIMEOUT_SECONDS" || return 1

    _legacy_scan="$("$MKTEMP_CMD" \
        "${RUNTIME_DIR}/legacy-syslog-scan.XXXXXX" 8>&- 9>&-)" ||
        return 1
    chmod 0600 "$_legacy_scan" 8>&- 9>&- || {
        rm -f "$_legacy_scan"
        return 1
    }
    if ! (
        ulimit -c 0 || exit 125
        ulimit -f "$LEGACY_SYSLOG_SCAN_BLOCKS" || exit 125
        exec "$TIMEOUT_CMD" -s TERM -k 2 \
            "$LEGACY_SYSLOG_SCAN_TIMEOUT_SECONDS" \
            find -H "$_legacy_data_dir" -xdev \
                -mindepth 1 -maxdepth 1 -print
    ) > "$_legacy_scan" 2>/dev/null; then
        rm -f "$_legacy_scan"
        return 1
    fi

    _legacy_count=0
    _legacy_rotation_count=0
    _legacy_newest_path=""
    _legacy_newest_epoch=0
    _legacy_old_present=0
    while IFS= read -r _legacy_leaf; do
        _legacy_count=$((_legacy_count + 1))
        [ "$_legacy_count" -le "$LEGACY_SYSLOG_MAX_LEAVES" ] || {
            rm -f "$_legacy_scan"
            return 1
        }
        _legacy_name="${_legacy_leaf##*/}"
        case "$_legacy_name" in
            history.db|history.db-wal|history.db-shm|history.db-journal|\
            syslog.txt|iface_snapshot.current|iface_snapshot.last)
                ;;
            syslog.txt.old)
                _legacy_old_present=1
                ;;
            syslog.txt.[1-9]|syslog.txt.[1-9][0-9]*)
                _legacy_epoch="${_legacy_name#syslog.txt.}"
                case "$_legacy_epoch" in
                    ""|*[!0-9]*)
                        rm -f "$_legacy_scan"
                        return 1
                        ;;
                esac
                [ "${#_legacy_epoch}" -le 18 ] || {
                    rm -f "$_legacy_scan"
                    return 1
                }
                _legacy_rotation_count=$((_legacy_rotation_count + 1))
                if [ "$_legacy_epoch" -gt "$_legacy_newest_epoch" ]; then
                    _legacy_newest_epoch="$_legacy_epoch"
                    _legacy_newest_path="$_legacy_leaf"
                fi
                ;;
            *)
                rm -f "$_legacy_scan"
                return 1
                ;;
        esac
        legacy_storage_leaf_is_safe "$_legacy_leaf" || {
            rm -f "$_legacy_scan"
            return 1
        }
    done < "$_legacy_scan"

    [ "$_legacy_rotation_count" -gt 0 ] || {
        rm -f "$_legacy_scan"
        return 0
    }
    require_data_mount || {
        rm -f "$_legacy_scan"
        return 1
    }

    _legacy_keep_path=""
    if [ "$_legacy_old_present" -eq 0 ]; then
        [ -n "$_legacy_newest_path" ] || {
            rm -f "$_legacy_scan"
            return 1
        }
        _legacy_keep_path="$_legacy_newest_path"
        legacy_storage_leaf_is_safe "$_legacy_keep_path" || {
            rm -f "$_legacy_scan"
            return 1
        }
        [ ! -e "${_legacy_data_dir}/syslog.txt.old" ] &&
            [ ! -L "${_legacy_data_dir}/syslog.txt.old" ] || {
                rm -f "$_legacy_scan"
                return 1
            }
        mv -f "$_legacy_keep_path" "${_legacy_data_dir}/syslog.txt.old" ||
            {
                rm -f "$_legacy_scan"
                return 1
            }
        legacy_storage_leaf_is_safe \
            "${_legacy_data_dir}/syslog.txt.old" || {
                rm -f "$_legacy_scan"
                return 1
            }
    fi
    # Make preservation of the fixed archive durable before retiring any
    # redundant legacy copy. If this barrier fails, no legacy archive is
    # deleted; a later start can safely revalidate and resume.
    storage_sync_barrier || {
        rm -f "$_legacy_scan"
        return 1
    }

    while IFS= read -r _legacy_leaf; do
        _legacy_name="${_legacy_leaf##*/}"
        case "$_legacy_name" in
            syslog.txt.[1-9]|syslog.txt.[1-9][0-9]*)
                [ "$_legacy_leaf" = "$_legacy_keep_path" ] && continue
                _legacy_epoch="${_legacy_name#syslog.txt.}"
                case "$_legacy_epoch" in
                    ""|*[!0-9]*) rm -f "$_legacy_scan"; return 1 ;;
                esac
                legacy_storage_leaf_is_safe "$_legacy_leaf" ||
                    { rm -f "$_legacy_scan"; return 1; }
                rm -f "$_legacy_leaf" ||
                    { rm -f "$_legacy_scan"; return 1; }
                ;;
        esac
    done < "$_legacy_scan"
    rm -f "$_legacy_scan"
    storage_sync_barrier || return 1
    require_data_mount || return 1
    logger -t jammonitor \
        "Migrated $_legacy_rotation_count legacy syslog rotations to one bounded archive"
    return 0
}

if [ "$LIB_ONLY" != "1" ]; then
    for _storage_required_command in \
        "$TIMEOUT_CMD" "$STAT_CMD" "$UCI_CMD" "$BLOCK_CMD" "$MKTEMP_CMD" \
        "$SYNC_CMD"
    do
        command -v "$_storage_required_command" >/dev/null 2>&1 || {
            logger -t jammonitor \
                "FATAL: storage authority command is unavailable: $_storage_required_command"
            exit 1
        }
    done
    require_data_mount || {
        exit 1
    }
    # Hold the verified mount for the collector lifetime. If the filesystem is
    # unmounted or detached later, descriptor-relative paths remain bound to
    # that original mount and can never fall through to the router overlay.
    exec 8<"$MOUNT_POINT" || {
        logger -t jammonitor "FATAL: Cannot pin mounted storage"
        exit 1
    }
    # Spend the first complete proof only after the mount descriptor is open.
    # The second proof below must match this exact mount ID/source/UUID/root
    # generation and the descriptor's kernel mnt_id.
    PINNED_STORAGE_TOKEN="$PROVED_STORAGE_TOKEN"
    PINNED_STORAGE_SOURCE="$PROVED_STORAGE_SOURCE"
    PINNED_STORAGE_UUID="$PROVED_STORAGE_UUID"
    PINNED_STORAGE_KERNEL_ID="$PROVED_STORAGE_KERNEL_ID"
    PINNED_STORAGE_MOUNT_ID="$PROVED_STORAGE_MOUNT_ID"
    require_data_mount || {
        logger -t jammonitor \
            "FATAL: storage mount changed while it was being pinned"
        exit 1
    }
    _pinned_data_dir="${FD_ROOT}/8/jammonitor"
    if [ -L "$_pinned_data_dir" ]; then
        logger -t jammonitor \
            "FATAL: mounted storage data directory is a symlink"
        exit 1
    fi
    if [ ! -e "$_pinned_data_dir" ]; then
        mkdir -m 0700 "$_pinned_data_dir" 2>/dev/null || {
            logger -t jammonitor \
                "FATAL: Cannot create data directory on mounted storage"
            exit 1
        }
    fi
    if [ ! -d "$_pinned_data_dir" ] ||
       [ -L "$_pinned_data_dir" ] ||
       ! chmod 0700 "$_pinned_data_dir" ||
       ! migrate_legacy_syslog_rotations "$_pinned_data_dir" ||
       ! storage_data_tree_is_safe "$_pinned_data_dir"; then
        logger -t jammonitor \
            "FATAL: mounted storage data tree is not root-confined"
        exit 1
    fi

    # Pin the verified data directory itself. All persistent leaf paths are
    # now descriptor-relative with no attacker-controlled intermediate
    # component. Descriptor 5 only bridges the dup while descriptor 8 still
    # pins the parent mount.
    exec 5<"$_pinned_data_dir" || {
        logger -t jammonitor "FATAL: Cannot pin verified data directory"
        exit 1
    }
    exec 8<&-
    exec 8<&5
    exec 5<&-
    DATA_DIR="${FD_ROOT}/8"
    DB_PATH="${DATA_DIR}/history.db"
    LOG_PATH="${DATA_DIR}/syslog.txt"
fi

# SQLite single-quoted string literals escape only single quotes. Backslash
# escaping double quotes corrupts JSON by storing the backslash literally.
sql_escape() {
    printf '%s' "$1" | sed -e "s/'/''/g"
}

is_uint() {
    case "${1:-}" in
        0|[1-9]|[1-9][0-9]*)
            [ "${#1}" -le 18 ]
            ;;
        *)
            return 1
            ;;
    esac
}

pin_watchdog_snapshot() {
    _watchdog_source="${1:-}"
    release_watchdog_snapshot

    # Reject symlinks and every non-regular source before the bounded copy.
    # The producer publishes by rename, so dd's single source open remains on
    # one inode even if the public pathname is replaced during this cycle.
    [ -f "$_watchdog_source" ] && [ ! -L "$_watchdog_source" ] ||
        return 1
    WATCHDOG_SNAPSHOT_FILE="$("$MKTEMP_CMD" \
        "${RUNTIME_DIR}/tailscale-watchdog.snapshot.XXXXXX" 8>&- 9>&-)" ||
        return 1
    chmod 0600 "$WATCHDOG_SNAPSHOT_FILE" 8>&- 9>&- || {
        release_watchdog_snapshot
        return 1
    }

    if ! "$TIMEOUT_CMD" "$WATCHDOG_COPY_TIMEOUT_SECONDS" \
        "$DD_CMD" if="$_watchdog_source" of="$WATCHDOG_SNAPSHOT_FILE" \
        bs=$((WATCHDOG_SNAPSHOT_MAX_BYTES + 1)) count=1 \
        8>&- 9>&- 2>/dev/null; then
        release_watchdog_snapshot
        return 1
    fi
    [ -f "$WATCHDOG_SNAPSHOT_FILE" ] &&
        [ ! -L "$WATCHDOG_SNAPSHOT_FILE" ] || {
        release_watchdog_snapshot
        return 1
    }
    _watchdog_snapshot_bytes="$(
        wc -c < "$WATCHDOG_SNAPSHOT_FILE" 8>&- 9>&-
    )"
    _watchdog_snapshot_bytes="$(
        printf '%s' "$_watchdog_snapshot_bytes" | tr -d '[:space:]'
    )"
    if ! is_uint "$_watchdog_snapshot_bytes" ||
       [ "$_watchdog_snapshot_bytes" -eq 0 ] ||
       [ "$_watchdog_snapshot_bytes" -gt "$WATCHDOG_SNAPSHOT_MAX_BYTES" ]; then
        release_watchdog_snapshot
        return 1
    fi
    return 0
}

pin_root_volatile_snapshot() {
    _volatile_source="${1:-}"
    _volatile_label="${2:-}"
    _volatile_max_bytes="${3:-}"
    release_volatile_snapshot

    case "$_volatile_label" in
        dhcp|resolv) ;;
        *) return 1 ;;
    esac
    is_uint "$_volatile_max_bytes" &&
        [ "$_volatile_max_bytes" -gt 0 ] || return 1
    [ -f "$_volatile_source" ] && [ ! -L "$_volatile_source" ] ||
        return 1
    _volatile_before="$(
        "$STAT_CMD" -c '%u:%F:%d:%i:%s:%Y' \
            "$_volatile_source" 8>&- 9>&- 2>/dev/null
    )" || return 1
    [ "${_volatile_before%%:*}" = "$EXPECTED_VOLATILE_UID" ] || return 1

    VOLATILE_SNAPSHOT_FILE="$("$MKTEMP_CMD" \
        "${RUNTIME_DIR}/volatile.${_volatile_label}.XXXXXX" 8>&- 9>&-)" ||
        return 1
    chmod 0600 "$VOLATILE_SNAPSHOT_FILE" 8>&- 9>&- || {
        release_volatile_snapshot
        return 1
    }
    if ! "$TIMEOUT_CMD" "$VOLATILE_COPY_TIMEOUT_SECONDS" \
        "$DD_CMD" if="$_volatile_source" of="$VOLATILE_SNAPSHOT_FILE" \
        bs=$((_volatile_max_bytes + 1)) count=1 \
        8>&- 9>&- 2>/dev/null; then
        release_volatile_snapshot
        return 1
    fi
    _volatile_after="$(
        "$STAT_CMD" -c '%u:%F:%d:%i:%s:%Y' \
            "$_volatile_source" 8>&- 9>&- 2>/dev/null
    )" || {
        release_volatile_snapshot
        return 1
    }
    [ "$_volatile_after" = "$_volatile_before" ] || {
        release_volatile_snapshot
        return 1
    }
    _volatile_snapshot_bytes="$(
        wc -c < "$VOLATILE_SNAPSHOT_FILE" 8>&- 9>&-
    )"
    _volatile_snapshot_bytes="$(
        printf '%s' "$_volatile_snapshot_bytes" | tr -d '[:space:]'
    )"
    if ! is_uint "$_volatile_snapshot_bytes" ||
       [ "$_volatile_snapshot_bytes" -gt "$_volatile_max_bytes" ]; then
        release_volatile_snapshot
        return 1
    fi
    return 0
}

watchdog_json_value() {
    jsonfilter -i "$WATCHDOG_SNAPSHOT_FILE" -e "$1" 8>&- 9>&- 2>/dev/null
}

watchdog_json_type() {
    jsonfilter -i "$WATCHDOG_SNAPSHOT_FILE" -t "$1" 8>&- 9>&- 2>/dev/null
}

is_process_generation() {
    _generation="${1:-}"
    [ "${#_generation}" -le 64 ] || return 1
    case "$_generation" in
        *:*)
            _generation_pid="${_generation%%:*}"
            _generation_ticks="${_generation#*:}"
            case "$_generation_ticks" in *:*) return 1 ;; esac
            [ "${#_generation_pid}" -le 18 ] &&
                [ "${#_generation_ticks}" -le 18 ] ||
                return 1
            is_uint "$_generation_pid" &&
                is_uint "$_generation_ticks" &&
                [ "$_generation_pid" -gt 1 ] &&
                [ "$_generation_ticks" -gt 0 ]
            ;;
        *)
            return 1
            ;;
    esac
}

if ! is_uint "$SQLITE_TIMEOUT_SECONDS" ||
   [ "$SQLITE_TIMEOUT_SECONDS" -lt 1 ]; then
