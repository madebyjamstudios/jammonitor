sqlite_command() {
    if [ "$LIB_ONLY" != "1" ]; then
        require_data_mount || return 1
    fi
    "$SQLITE_TIMEOUT_CMD" "$SQLITE_TIMEOUT_SECONDS" \
        "$SQLITE_CMD" "$DB_PATH" "$1"
}

sqlite_read() {
    sqlite_command "$1" 2>/dev/null
}

ITERATION_WRITE_FAILED=0

sqlite_write() {
    _sql="$1"
    if _error="$(sqlite_command "PRAGMA busy_timeout=5000; $_sql" 2>&1)"; then
        return 0
    fi
    ITERATION_WRITE_FAILED=1
    logger -t jammonitor "SQLite write failed: $(printf '%s' "$_error" | head -c 240)"
    return 1
}

COLLECTOR_STARTED_AT="$(date +%s)"
LAST_SAMPLE_AT=0
LAST_SUCCESS_AT=0
CONSECUTIVE_WRITE_FAILURES=0
QUICK_CHECK="unknown"

run_quick_check() {
    QUICK_CHECK="$(sqlite_read "PRAGMA quick_check;" | head -n 1)"
    [ "$QUICK_CHECK" = "ok" ]
}

publish_collector_status() {
    _now="$(date +%s)"
    _mounted=false
    _writable=false
    _healthy=false
    storage_authority_is_current && _mounted=true
    [ -w "$MOUNT_POINT" ] && _writable=true

    if [ "$LAST_SAMPLE_AT" -gt 0 ]; then
        _sample_age=$((_now - LAST_SAMPLE_AT))
        [ "$_sample_age" -lt 0 ] && _sample_age=0
    else
        _sample_age=-1
    fi

    if [ "$_mounted" = true ] &&
       [ "$_writable" = true ] &&
       [ "$QUICK_CHECK" = "ok" ] &&
       [ "$CONSECUTIVE_WRITE_FAILURES" -eq 0 ] &&
       [ "$LAST_SUCCESS_AT" -ge "$COLLECTOR_STARTED_AT" ] &&
       [ "$_sample_age" -ge 0 ] &&
       [ "$_sample_age" -le 180 ]; then
        _healthy=true
    fi

    _tmp="${STATUS_FILE}.tmp.$$"
    {
        printf '{'
        printf '"schema":1,'
        printf '"observed_at":%s,' "$_now"
        printf '"started_at":%s,' "$COLLECTOR_STARTED_AT"
        printf '"healthy":%s,' "$_healthy"
        printf '"mounted":%s,' "$_mounted"
        printf '"writable":%s,' "$_writable"
        printf '"mount_source":"%s",' "$PINNED_STORAGE_SOURCE"
        printf '"mount_uuid":"%s",' "$PINNED_STORAGE_UUID"
        printf '"mount_kernel_id":"%s",' "$PINNED_STORAGE_KERNEL_ID"
        printf '"mount_generation":"%s",' "$PINNED_STORAGE_MOUNT_ID"
        printf '"database_quick_check":"%s",' "$QUICK_CHECK"
        printf '"last_sample_at":%s,' "$LAST_SAMPLE_AT"
        printf '"last_success_at":%s,' "$LAST_SUCCESS_AT"
        printf '"sample_age_secs":%s,' "$_sample_age"
        printf '"consecutive_write_failures":%s' "$CONSECUTIVE_WRITE_FAILURES"
        printf '}\n'
    } > "$_tmp" && mv "$_tmp" "$STATUS_FILE"
}

# Match only RFC1918 addresses and Tailscale's assigned 100.64.0.0/10 range.
# Treating all of 100.0.0.0/8 as local can attribute public CGNAT-adjacent
# traffic to clients that do not exist.
is_local_client_ip() {
    _ip="$1"
    _old_ifs="$IFS"
    IFS=.
    set -- $_ip
    IFS="$_old_ifs"
    [ "$#" -eq 4 ] || return 1

    for _octet in "$@"; do
        is_uint "$_octet" || return 1
        [ "$_octet" -le 255 ] || return 1
    done

    case "$1" in
        10) return 0 ;;
        172) [ "$2" -ge 16 ] && [ "$2" -le 31 ] ;;
        192) [ "$2" -eq 168 ] ;;
        100) [ "$2" -ge 64 ] && [ "$2" -le 127 ] ;;
        *) return 1 ;;
    esac
}

is_ipv4_octet() {
    _ip_octet="${1:-}"
    case "$_ip_octet" in
        0|[1-9]|[1-9][0-9]|[1-9][0-9][0-9]) ;;
        *) return 1 ;;
    esac
    [ "$_ip_octet" -le 255 ]
}

ipv6_part_group_count() {
    _ipv6_part="${1:-}"
    IPV6_GROUP_COUNT=0
    [ -n "$_ipv6_part" ] || return 0
    case "$_ipv6_part" in
        :*|*:|*::*|*[!0-9a-f:]*) return 1 ;;
    esac

    _ipv6_old_ifs="$IFS"
    IFS=:
    set -- $_ipv6_part
    IFS="$_ipv6_old_ifs"
    for _ipv6_group in "$@"; do
        [ -n "$_ipv6_group" ] &&
            [ "${#_ipv6_group}" -le 4 ] || return 1
    done
    IPV6_GROUP_COUNT="$#"
}

is_tailscale_ip() {
    _candidate="${1:-}"
    [ -n "$_candidate" ] && [ "${#_candidate}" -le 39 ] || return 1
    case "$_candidate" in
        *:*)
            case "$_candidate" in *[!0-9A-Fa-f:]*) return 1 ;; esac
            _candidate="$(printf '%s' "$_candidate" | tr 'A-F' 'a-f')"
            case "$_candidate" in
                fd7a:115c:a1e0:*) ;;
                *) return 1 ;;
            esac

            case "$_candidate" in
                *::*)
                    _ipv6_left="${_candidate%%::*}"
                    _ipv6_right="${_candidate#*::}"
                    case "$_ipv6_right" in *::*) return 1 ;; esac
                    ipv6_part_group_count "$_ipv6_left" || return 1
                    _ipv6_left_count="$IPV6_GROUP_COUNT"
                    ipv6_part_group_count "$_ipv6_right" || return 1
                    _ipv6_right_count="$IPV6_GROUP_COUNT"
                    [ $((_ipv6_left_count + _ipv6_right_count)) -lt 8 ]
                    ;;
                *)
                    ipv6_part_group_count "$_candidate" &&
                        [ "$IPV6_GROUP_COUNT" -eq 8 ]
                    ;;
            esac
            ;;
        *.*)
            case "$_candidate" in
                .*|*.|*..*|*[!0-9.]*) return 1 ;;
            esac
            _ip_old_ifs="$IFS"
            IFS=.
            set -- $_candidate
            IFS="$_ip_old_ifs"
            [ "$#" -eq 4 ] || return 1
            for _octet in "$@"; do
                is_ipv4_octet "$_octet" || return 1
            done
            [ "$1" = "100" ] &&
                [ "$2" -ge 64 ] &&
                [ "$2" -le 127 ]
            ;;
        *)
            return 1
            ;;
    esac
}

# Get WAN interface list (dynamic or fallback)
get_wan_list() {
    if [ -f "$WAN_CONFIG" ]; then
        cat "$WAN_CONFIG" | tr '\n' ' '
    else
        echo "wan wan1 wan2 wan3 wan4"
    fi
}

# Initialize database with all tables and WAL mode
service_health_has_column() {
    _required_column="$1"
    sqlite_read "PRAGMA table_info(service_health);" |
        awk -F'|' -v required="$_required_column" '$2 == required { found = 1 }
            END { exit(found ? 0 : 1) }'
}

ensure_service_health_column() {
    _required_column="$1"
    _column_declaration="$2"
    service_health_has_column "$_required_column" && return 0
    sqlite_command "ALTER TABLE service_health ADD COLUMN $_column_declaration;" \
        >/dev/null
}

init_db() {
    sqlite_command "
        PRAGMA journal_mode=WAL;
        PRAGMA busy_timeout=5000;
        CREATE TABLE IF NOT EXISTS metrics (
            ts INTEGER PRIMARY KEY,
            load TEXT,
            ram_pct REAL,
            temp INTEGER,
            wan_pings TEXT,
            iface_status TEXT
        );
        CREATE TABLE IF NOT EXISTS snapshots (
            ts INTEGER PRIMARY KEY,
            mptcp TEXT,
            vpn TEXT,
            routes TEXT,
            conntrack_count INTEGER,
            dns TEXT
        );
        CREATE TABLE IF NOT EXISTS client_traffic (
            ts INTEGER,
            ip TEXT,
            mac TEXT,
            hostname TEXT,
            rx_bytes INTEGER,
            tx_bytes INTEGER,
            PRIMARY KEY (ts, ip)
        );
        CREATE TABLE IF NOT EXISTS client_traffic_hourly (
            hour_ts INTEGER,
            ip TEXT,
            mac TEXT,
            hostname TEXT,
            rx_bytes INTEGER,
            tx_bytes INTEGER,
            PRIMARY KEY (hour_ts, ip)
        );
        CREATE TABLE IF NOT EXISTS interface_traffic (
            ts INTEGER,
            iface TEXT,
            rx_bytes INTEGER,
            tx_bytes INTEGER,
            PRIMARY KEY (ts, iface)
        );
        CREATE TABLE IF NOT EXISTS service_health (
            ts INTEGER,
            service TEXT,
            boot_id TEXT,
            status TEXT,
            reason TEXT,
            healthy INTEGER,
            connected INTEGER,
            degraded INTEGER,
            local_api_responsive INTEGER,
            control_online INTEGER,
            process_generation TEXT,
            process_uptime_seconds INTEGER,
            backend_state TEXT,
            key_expiry TEXT,
            condition_since_at INTEGER,
            connected_since_at INTEGER,
            connectivity_uptime_seconds INTEGER,
            peer_state TEXT,
            peer_reachable INTEGER,
            recovery_attempted INTEGER,
            recovery_count INTEGER,
            PRIMARY KEY (ts, service)
        );
        CREATE INDEX IF NOT EXISTS idx_metrics_ts ON metrics(ts);
        CREATE INDEX IF NOT EXISTS idx_snapshots_ts ON snapshots(ts);
        CREATE INDEX IF NOT EXISTS idx_client_ts ON client_traffic(ts);
        CREATE INDEX IF NOT EXISTS idx_client_hourly_ts ON client_traffic_hourly(hour_ts);
        CREATE INDEX IF NOT EXISTS idx_iface_ts ON interface_traffic(ts);
        CREATE INDEX IF NOT EXISTS idx_service_health_ts ON service_health(ts);

        -- v4 incorrectly inserted backslashes before every JSON double quote.
        -- This migration is idempotent and repairs only the generated JSON
        -- columns whose valid representation must begin with an object brace.
        UPDATE metrics
           SET wan_pings = replace(wan_pings, char(92) || char(34), char(34))
         WHERE wan_pings LIKE '{' || char(92) || char(34) || '%';
        UPDATE metrics
           SET iface_status = replace(iface_status, char(92) || char(34), char(34))
         WHERE iface_status LIKE '{' || char(92) || char(34) || '%';
    " >/dev/null || return 1

    # CREATE TABLE does not add fields to an existing router database. Keep
    # these additive migrations explicit so older USB histories remain usable.
    ensure_service_health_column control_online "control_online INTEGER" ||
        return 1
    ensure_service_health_column process_generation "process_generation TEXT" ||
        return 1
    ensure_service_health_column process_uptime_seconds \
        "process_uptime_seconds INTEGER" || return 1
}

# Collect metrics (every minute)
collect_metrics() {
    TS=$(date +%s)
    LOAD=$(cat /proc/loadavg | cut -d' ' -f1-3)
    RAM=$(free | awk '/Mem:/{printf "%.1f", $3/$2*100}')
    TEMP=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0)

    # Pings with timeout protection
    P1=$(timeout 2 ping -c1 -W1 1.1.1.1 2>/dev/null | grep -oE 'time=[0-9.]+' | cut -d= -f2)
    P2=$(timeout 2 ping -c1 -W1 8.8.8.8 2>/dev/null | grep -oE 'time=[0-9.]+' | cut -d= -f2)
    [ -z "$P1" ] && P1="null"
    [ -z "$P2" ] && P2="null"

    # VPS ping: detect IP from WireGuard endpoint or UCI config
    VPS_IP=""
    if command -v wg >/dev/null 2>&1; then
        VPS_IP=$(wg show all endpoints 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    fi
    [ -z "$VPS_IP" ] && VPS_IP=$(uci get openmptcprouter.vps.ip 2>/dev/null)
    [ -z "$VPS_IP" ] && VPS_IP=$(uci get glorytun.vpn.host 2>/dev/null)
    P_VPS=""
    if [ -n "$VPS_IP" ]; then
        P_VPS=$(timeout 2 ping -c1 -W1 "$VPS_IP" 2>/dev/null | grep -oE 'time=[0-9.]+' | cut -d= -f2)
        [ -z "$P_VPS" ] && P_VPS="null"
    fi

    # Tunnel ping: detect IP from tun0 peer, route gateway, or subnet .1
    TUNNEL_IP=""
    TUNNEL_IP=$(ip addr show dev tun0 2>/dev/null | grep -oE 'peer [0-9.]+' | cut -d' ' -f2)
    [ -z "$TUNNEL_IP" ] && TUNNEL_IP=$(ip route show dev tun0 2>/dev/null | grep -oE 'via [0-9.]+' | head -1 | cut -d' ' -f2)
    if [ -z "$TUNNEL_IP" ]; then
        TUN0_IP=$(ip addr show dev tun0 2>/dev/null | grep -oE 'inet [0-9.]+' | cut -d' ' -f2)
        [ -n "$TUN0_IP" ] && TUNNEL_IP=$(echo "$TUN0_IP" | sed 's/\.[0-9]*$/.1/')
    fi
    P_TUNNEL=""
    if [ -n "$TUNNEL_IP" ]; then
        P_TUNNEL=$(timeout 2 ping -c1 -W1 "$TUNNEL_IP" 2>/dev/null | grep -oE 'time=[0-9.]+' | cut -d= -f2)
        [ -z "$P_TUNNEL" ] && P_TUNNEL="null"
    fi

    # Build PINGS JSON with optional VPS/tunnel entries
    PINGS="{\"1.1.1.1\":$P1,\"8.8.8.8\":$P2"
    [ -n "$P_VPS" ] && PINGS="$PINGS,\"vps\":$P_VPS"
    [ -n "$P_TUNNEL" ] && PINGS="$PINGS,\"tunnel\":$P_TUNNEL"
    PINGS="$PINGS}"

    # Interface status (dynamic list)
    IFACES="{"
    FIRST=1
    for iface in $(get_wan_list); do
        UP=$(timeout 2 ifstatus $iface 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)
        [ $FIRST -eq 0 ] && IFACES="$IFACES,"
        [ "$UP" = "true" ] && IFACES="$IFACES\"$iface\":1" || IFACES="$IFACES\"$iface\":0"
        FIRST=0
    done
    IFACES="$IFACES}"

    # Escape values for SQL safety
    LOAD_ESC=$(sql_escape "$LOAD")
    PINGS_ESC=$(sql_escape "$PINGS")
    IFACES_ESC=$(sql_escape "$IFACES")

    sqlite_write "INSERT OR REPLACE INTO metrics VALUES ($TS, '$LOAD_ESC', $RAM, $TEMP, '$PINGS_ESC', '$IFACES_ESC');"
}

# Collect slow snapshots (every minute)
collect_slow() {
    TS=$(date +%s)

    # MPTCP endpoints and limits (with timeout)
    MPTCP_EP=$(timeout 5 ip mptcp endpoint show 2>/dev/null | head -20 | tr '\n' '|')
    MPTCP_LIM=$(timeout 2 ip mptcp limits 2>/dev/null | tr '\n' '|')
    MPTCP="$MPTCP_EP;;$MPTCP_LIM"

    # VPN status (simplified)
    VPN=""
    if command -v wg >/dev/null 2>&1; then
        VPN=$(timeout 2 wg show interfaces 2>/dev/null | tr '\n' ',')
    fi
    GT=$(pgrep -c glorytun 2>/dev/null || echo 0)
    OV=$(pgrep -c openvpn 2>/dev/null || echo 0)
    VPN="wg:$VPN|gt:$GT|ovpn:$OV"

    # Routes summary (default routes only)
    ROUTES=$(ip route show default 2>/dev/null | head -10 | tr '\n' '|')

    # Conntrack count
    CT_COUNT=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo 0)

    # DNS servers
    DNS=""
    if pin_root_volatile_snapshot \
        "$RESOLV_CONF" resolv "$RESOLV_CONF_MAX_BYTES"; then
        DNS=$(grep nameserver "$VOLATILE_SNAPSHOT_FILE" 2>/dev/null |
            awk '{print $2}' | tr '\n' ',' | sed 's/,$//')
        release_volatile_snapshot
    fi

    # Escape all values for SQL safety
    MPTCP_ESC=$(sql_escape "$MPTCP")
    VPN_ESC=$(sql_escape "$VPN")
    ROUTES_ESC=$(sql_escape "$ROUTES")
    DNS_ESC=$(sql_escape "$DNS")

    sqlite_write "INSERT OR REPLACE INTO snapshots VALUES ($TS, '$MPTCP_ESC', '$VPN_ESC', '$ROUTES_ESC', $CT_COUNT, '$DNS_ESC');"
}

watchdog_snapshot_is_valid() {
    [ "$_snapshot_schema_type" = "int" ] || return 1
    [ "$_observed_type" = "int" ] && is_uint "$OBSERVED" || return 1
    case "$_snapshot_schema" in 2|3) ;; *) return 1 ;; esac
    [ "$_snapshot_status_type" = "string" ] &&
        [ "$_snapshot_reason_type" = "string" ] &&
        [ "$_snapshot_backend_type" = "string" ] &&
        [ "$_snapshot_ip_type" = "string" ] &&
        [ "$_key_expiry_type" = "string" ] || return 1
    case "$_snapshot_status" in
        not_installed|watchdog_error|disabled|maintenance|daemon_missing|\
        daemon_unresponsive|socket_missing|running|running_degraded|needs_login|\
        needs_machine_auth|stopped|starting|unsupported_backend) ;;
        *) return 1 ;;
    esac
    [ -n "$_snapshot_reason" ] || return 1

    case "${_healthy_type}:${_healthy}" in
        boolean:true|boolean:false) ;; *) return 1 ;;
    esac
    case "${_connected_type}:${_connected}" in
        boolean:true|boolean:false|null:null) ;; *) return 1 ;;
    esac
    case "${_degraded_type}:${_degraded}" in
        boolean:true|boolean:false) ;; *) return 1 ;;
    esac
    case "${_local_api_type}:${_local_api}" in
        boolean:true|boolean:false|null:null) ;; *) return 1 ;;
    esac
    case "${_control_online_type}:${_control_online}" in
        boolean:true|boolean:false|null:null) ;; *) return 1 ;;
    esac
    case "${_installed_type}:${_installed}" in
        boolean:true|boolean:false) ;; *) return 1 ;;
    esac
    case "${_service_enabled_type}:${_service_enabled}" in
        boolean:true|boolean:false) ;; *) return 1 ;;
    esac
    case "${_service_running_type}:${_service_running}" in
        boolean:true|boolean:false) ;; *) return 1 ;;
    esac
    case "${_tun_type}:${_tun}" in
        boolean:true|boolean:false|null:null) ;; *) return 1 ;;
    esac
    [ "$_health_warnings_type" = "int" ] &&
        is_uint "$_health_warnings" || return 1
    [ "$_peer_configured_type" = "boolean" ] || return 1
    case "$_peer_configured" in true|false) ;; *) return 1 ;; esac
    [ "$_peer_state_type" = "string" ] || return 1
    case "$_peer_state" in
        not_configured|unknown|reachable|unreachable|invalid_configuration) ;;
        *) return 1 ;;
    esac
    case "${_peer_type}:${_peer}" in
        boolean:true|boolean:false|null:null) ;;
        *) return 1 ;;
    esac
    case "${_peer_configured}:${_peer_state}:${_peer}" in
        false:not_configured:null|\
        true:unknown:null|\
        true:reachable:true|\
        true:unreachable:false|\
        true:invalid_configuration:false) ;;
        *) return 1 ;;
    esac
    if [ "$_snapshot_schema" = "2" ]; then
        case "${_in_engine_type}:${_in_engine}" in
            boolean:true|boolean:false) ;;
            *) return 1 ;;
        esac
        if [ "$_connected" = "true" ] || [ "$_healthy" = "true" ]; then
            [ "$_in_engine" = "true" ] || return 1
        fi
    fi
    case "${_process_generation_type}:${_process_generation}" in
        null:null)
            [ "${_process_uptime_type}:${_process_uptime}" = "null:null" ] ||
                return 1
            ;;
        string:*)
            is_process_generation "$_process_generation" &&
                [ "$_process_uptime_type" = "int" ] &&
                is_uint "$_process_uptime" &&
                [ "${#_process_uptime}" -le 18 ] || return 1
            ;;
        *)
            return 1
            ;;
    esac
    for _typed_uint in \
        "${_condition_since_type}:${_condition_since}" \
        "${_connected_since_type}:${_connected_since}" \
        "${_attempted_type}:${_attempted}" \
        "${_recovery_type}:${_recovery}"
    do
        [ "${_typed_uint%%:*}" = "int" ] &&
            is_uint "${_typed_uint#*:}" || return 1
    done
    case "${_connectivity_uptime_type}:${_connectivity_uptime}" in
        null:null) ;;
        int:*) is_uint "$_connectivity_uptime" || return 1 ;;
        *) return 1 ;;
    esac

    # A later/faulty producer must not be able to turn a syntactically fresh
    # file into false historical uptime. Healthy and connected states require
    # the complete set of delivery prerequisites in the watchdog contract.
    if [ "$_connected" = "true" ]; then
        [ "$_peer_configured" != "true" ] ||
            [ "$_peer" = "true" ] || return 1
        [ "$_installed" = "true" ] &&
            [ "$_service_enabled" = "true" ] &&
            [ "$_service_running" = "true" ] &&
            [ "$_local_api" = "true" ] &&
            [ "$_snapshot_backend" = "Running" ] &&
            [ "$_tun" = "true" ] &&
            is_tailscale_ip "$_snapshot_ip" || return 1
        [ "$_connected_since" -gt 0 ] &&
            [ "$_connectivity_uptime_type" = "int" ] || return 1
    else
        [ "$_connected_since" = "0" ] &&
            [ "${_connectivity_uptime_type}:${_connectivity_uptime}" = \
                "null:null" ] || return 1
    fi

    if [ "$_healthy" = "true" ]; then
        [ "$_snapshot_status" = "running" ] &&
            [ "$_snapshot_reason" = "ok" ] &&
            [ "$_connected" = "true" ] &&
            [ "$_control_online" = "true" ] &&
            [ "$_health_warnings" = "0" ] &&
            is_process_generation "$_process_generation" &&
            [ "$_degraded" = "false" ] || return 1
    fi

    case "$_snapshot_status" in
        running)
            [ "$_healthy" = "true" ] || return 1
            ;;
        running_degraded)
            [ "$_snapshot_backend" = "Running" ] &&
                [ "$_local_api" = "true" ] &&
                [ "$_healthy" = "false" ] &&
                [ "$_degraded" = "true" ] || return 1
            ;;
        *)
            [ "$_healthy" = "false" ] &&
                [ "$_connected" != "true" ] || return 1
            ;;
    esac

    [ "$_service_running" != "true" ] ||
        [ "$_service_enabled" = "true" ] || return 1
    [ "$_service_enabled" != "true" ] ||
        [ "$_installed" = "true" ] || return 1
    [ "$_local_api" != "true" ] ||
        [ "$_service_running" = "true" ] || return 1
    return 0
}

collect_tailscale_health() {
    TS=$(date +%s)
    WATCHDOG_STATUS="${RUNTIME_DIR}/tailscale-watchdog.json"
    BOOT_ID="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null | tr -cd 'A-Fa-f0-9-' | cut -c1-40)"
    STATUS="watchdog_unavailable"
    REASON="status_missing"
    BACKEND_STATE=""
    HEALTHY=0
    CONNECTED="NULL"
    DEGRADED=0
    LOCAL_API_RESPONSIVE="NULL"
    CONTROL_ONLINE="NULL"
    PROCESS_GENERATION=""
    PROCESS_UPTIME="NULL"
    KEY_EXPIRY=""
    CONDITION_SINCE_AT=0
    CONNECTED_SINCE_AT=0
    CONNECTIVITY_UPTIME="NULL"
    PEER_STATE="unknown"
    PEER_REACHABLE="NULL"
    RECOVERY_ATTEMPTED=0
    RECOVERY_COUNT=0

    if { [ -e "$WATCHDOG_STATUS" ] || [ -L "$WATCHDOG_STATUS" ]; } &&
       command -v jsonfilter >/dev/null 2>&1; then
        if ! pin_watchdog_snapshot "$WATCHDOG_STATUS"; then
            STATUS="watchdog_invalid"
            REASON="status_invalid"
        else
            OBSERVED="$(watchdog_json_value '@.observed_at')"
            _observed_type="$(watchdog_json_type '@.observed_at')"
            if is_uint "$OBSERVED" && [ "$OBSERVED" -le $((TS + 5)) ] && [ $((TS - OBSERVED)) -le 45 ]; then
            _snapshot_schema="$(watchdog_json_value '@.schema')"
            _snapshot_schema_type="$(watchdog_json_type '@.schema')"
            _snapshot_status="$(watchdog_json_value '@.status')"
            _snapshot_status_type="$(watchdog_json_type '@.status')"
            _snapshot_reason="$(watchdog_json_value '@.reason')"
            _snapshot_reason_type="$(watchdog_json_type '@.reason')"
            _snapshot_backend="$(watchdog_json_value '@.backend_state')"
            _snapshot_backend_type="$(watchdog_json_type '@.backend_state')"
            _snapshot_ip="$(watchdog_json_value '@.tailscale_ip')"
            _snapshot_ip_type="$(watchdog_json_type '@.tailscale_ip')"
            _healthy="$(watchdog_json_value '@.healthy')"
            _healthy_type="$(watchdog_json_type '@.healthy')"
            _connected="$(watchdog_json_value '@.connected')"
            _connected_type="$(watchdog_json_type '@.connected')"
            _degraded="$(watchdog_json_value '@.degraded')"
            _degraded_type="$(watchdog_json_type '@.degraded')"
            _local_api="$(watchdog_json_value '@.local_api_responsive')"
            _local_api_type="$(watchdog_json_type '@.local_api_responsive')"
            _control_online="$(watchdog_json_value '@.control_online')"
            _control_online_type="$(watchdog_json_type '@.control_online')"
            _process_generation="$(watchdog_json_value '@.process_generation')"
            _process_generation_type="$(watchdog_json_type '@.process_generation')"
            _process_uptime="$(watchdog_json_value '@.process_uptime_seconds')"
            _process_uptime_type="$(watchdog_json_type '@.process_uptime_seconds')"
            _installed="$(watchdog_json_value '@.installed')"
            _installed_type="$(watchdog_json_type '@.installed')"
            _service_enabled="$(watchdog_json_value '@.service_enabled')"
            _service_enabled_type="$(watchdog_json_type '@.service_enabled')"
            _service_running="$(watchdog_json_value '@.service_running')"
            _service_running_type="$(watchdog_json_type '@.service_running')"
            _tun="$(watchdog_json_value '@.tun_available')"
            _tun_type="$(watchdog_json_type '@.tun_available')"
            _health_warnings="$(watchdog_json_value '@.health_warnings')"
            _health_warnings_type="$(watchdog_json_type '@.health_warnings')"
            _in_engine="$(watchdog_json_value '@.in_engine')"
            _in_engine_type="$(watchdog_json_type '@.in_engine')"
            KEY_EXPIRY="$(watchdog_json_value '@.key_expiry')"
            _key_expiry_type="$(watchdog_json_type '@.key_expiry')"
            _condition_since="$(watchdog_json_value '@.condition_since_at')"
            _condition_since_type="$(watchdog_json_type '@.condition_since_at')"
            _connected_since="$(watchdog_json_value '@.connected_since_at')"
            _connected_since_type="$(watchdog_json_type '@.connected_since_at')"
            _connectivity_uptime="$(watchdog_json_value '@.connectivity_uptime_seconds')"
            _connectivity_uptime_type="$(watchdog_json_type '@.connectivity_uptime_seconds')"
            _peer_configured="$(watchdog_json_value '@.peer_configured')"
            _peer_configured_type="$(watchdog_json_type '@.peer_configured')"
            _peer_state="$(watchdog_json_value '@.peer_state')"
            _peer_state_type="$(watchdog_json_type '@.peer_state')"
            _peer="$(watchdog_json_value '@.peer_reachable')"
            _peer_type="$(watchdog_json_type '@.peer_reachable')"
            [ "$_peer_type" = "null" ] && _peer=null
            _attempted="$(watchdog_json_value '@.recovery_attempted')"
            _attempted_type="$(watchdog_json_type '@.recovery_attempted')"
            _recovery="$(watchdog_json_value '@.recovery_count')"
            _recovery_type="$(watchdog_json_type '@.recovery_count')"
            if watchdog_snapshot_is_valid; then
                STATUS="$_snapshot_status"
                REASON="$_snapshot_reason"
                BACKEND_STATE="$_snapshot_backend"
                [ "$_healthy" = "true" ] && HEALTHY=1
                [ "$_connected" = "true" ] && CONNECTED=1
                [ "$_connected" = "false" ] && CONNECTED=0
                [ "$_degraded" = "true" ] && DEGRADED=1
                [ "$_local_api" = "true" ] && LOCAL_API_RESPONSIVE=1
                [ "$_local_api" = "false" ] && LOCAL_API_RESPONSIVE=0
                [ "$_control_online" = "true" ] && CONTROL_ONLINE=1
                [ "$_control_online" = "false" ] && CONTROL_ONLINE=0
                is_process_generation "$_process_generation" &&
                    PROCESS_GENERATION="$_process_generation"
                is_uint "$_process_uptime" &&
                    [ "${#_process_uptime}" -le 18 ] &&
                    PROCESS_UPTIME="$_process_uptime"
                is_uint "$_condition_since" && CONDITION_SINCE_AT="$_condition_since"
                is_uint "$_connected_since" && CONNECTED_SINCE_AT="$_connected_since"
                is_uint "$_connectivity_uptime" && CONNECTIVITY_UPTIME="$_connectivity_uptime"
                PEER_STATE="$_peer_state"
                [ "$_peer" = "true" ] && PEER_REACHABLE=1
                [ "$_peer" = "false" ] && PEER_REACHABLE=0
                is_uint "$_attempted" && RECOVERY_ATTEMPTED="$_attempted"
                is_uint "$_recovery" && RECOVERY_COUNT="$_recovery"
            else
                STATUS="watchdog_invalid"
                REASON="status_invalid"
                KEY_EXPIRY=""
            fi
        else
            STATUS="watchdog_stale"
            REASON="status_stale"
        fi
            release_watchdog_snapshot
        fi
    fi

    STATUS_ESC="$(sql_escape "$(printf '%s' "$STATUS" | tr -cd 'A-Za-z0-9_.:-' | cut -c1-80)")"
    REASON_ESC="$(sql_escape "$(printf '%s' "$REASON" | tr -cd 'A-Za-z0-9_.:-' | cut -c1-80)")"
    BACKEND_ESC="$(sql_escape "$(printf '%s' "$BACKEND_STATE" | tr -cd 'A-Za-z0-9_.:-' | cut -c1-80)")"
    KEY_EXPIRY_ESC="$(sql_escape "$(printf '%s' "$KEY_EXPIRY" | tr -cd 'A-Za-z0-9_.:+-' | cut -c1-64)")"
    PROCESS_GENERATION_ESC="$(sql_escape "$(printf '%s' "$PROCESS_GENERATION" | tr -cd '0-9:' | cut -c1-64)")"
    PROCESS_GENERATION_SQL="NULL"
    if is_process_generation "$PROCESS_GENERATION_ESC"; then
        PROCESS_GENERATION_SQL="'$PROCESS_GENERATION_ESC'"
    fi
    PEER_STATE_ESC="$(sql_escape "$(printf '%s' "$PEER_STATE" | tr -cd 'A-Za-z0-9_.:-' | cut -c1-80)")"
    BOOT_ESC="$(sql_escape "$BOOT_ID")"

    sqlite_write "INSERT OR REPLACE INTO service_health
        (ts, service, boot_id, status, reason, healthy, connected, degraded,
         local_api_responsive, control_online, process_generation,
         process_uptime_seconds, backend_state, key_expiry,
         condition_since_at, connected_since_at, connectivity_uptime_seconds,
         peer_state, peer_reachable,
         recovery_attempted, recovery_count)
        VALUES ($TS, 'tailscale', '$BOOT_ESC', '$STATUS_ESC', '$REASON_ESC',
                $HEALTHY, $CONNECTED, $DEGRADED, $LOCAL_API_RESPONSIVE,
                $CONTROL_ONLINE, $PROCESS_GENERATION_SQL, $PROCESS_UPTIME,
                '$BACKEND_ESC', '$KEY_EXPIRY_ESC', $CONDITION_SINCE_AT,
                $CONNECTED_SINCE_AT, $CONNECTIVITY_UPTIME, '$PEER_STATE_ESC',
                $PEER_REACHABLE,
                $RECOVERY_ATTEMPTED, $RECOVERY_COUNT);"
}

# Collect per-client traffic (every minute)
# Tracks delta bytes per IP since last sample
collect_client_traffic() {
    TS=$(date +%s)
    CURRENT_FILE="${CLIENT_SNAPSHOT}.current"
    LAST_FILE="${CLIENT_SNAPSHOT}.last"

    # Build MAC->hostname lookup from DHCP leases
    # Format: timestamp mac ip hostname clientid
    HOSTNAME_MAP=""
    if pin_root_volatile_snapshot \
        "$DHCP_LEASES" dhcp "$DHCP_LEASES_MAX_BYTES"; then
        while read -r exp mac ip host rest; do
            [ -n "$mac" ] && [ -n "$host" ] && [ "$host" != "*" ] && \
                HOSTNAME_MAP="${HOSTNAME_MAP}${mac}=${host}
"
        done < "$VOLATILE_SNAPSHOT_FILE"
        release_volatile_snapshot
    fi

    # Build IP->MAC lookup from ARP table
    MAC_MAP=""
    if [ -r "$ARP_TABLE" ]; then
        while read -r ip type flags mac mask iface; do
            [ "$ip" = "IP" ] && continue  # Skip header
            [ -n "$ip" ] && [ -n "$mac" ] && [ "$mac" != "00:00:00:00:00:00" ] && \
                MAC_MAP="${MAC_MAP}${ip}=${mac}
"
        done < "$ARP_TABLE"
    fi

    # Parse conntrack and aggregate bytes per source IP
    # conntrack format: ... src=IP ... bytes=X ... bytes=Y ...
    # First bytes is TX (outgoing), second is RX (incoming)
    CONNTRACK_DUMP="${CLIENT_SNAPSHOT}.conntrack"
    > "$CURRENT_FILE"
    if ! (
        ulimit -c 0 || exit 125
        ulimit -f "$CONNTRACK_SNAPSHOT_BLOCKS" || exit 125
        exec "$TIMEOUT_CMD" -s TERM -k 2 "$CONNTRACK_TIMEOUT_SECONDS" \
            "$CONNTRACK_CMD" -L
    ) > "$CONNTRACK_DUMP" 2>/dev/null; then
        rm -f "$CURRENT_FILE" "$CONNTRACK_DUMP" 2>/dev/null
        ITERATION_WRITE_FAILED=1
        logger -t jammonitor "Conntrack snapshot failed or exceeded ${CONNTRACK_TIMEOUT_SECONDS}s"
        return 1
    fi

    head -1000 "$CONNTRACK_DUMP" | while read -r line; do
        # Extract source IP (local client)
        src=$(echo "$line" | grep -oE 'src=[0-9.]+' | head -1 | cut -d= -f2)
        [ -z "$src" ] && continue

        # Skip non-local IPs (external sources).
        is_local_client_ip "$src" || continue

        # Extract bytes (first=TX, second=RX from client perspective)
        bytes=$(echo "$line" | grep -oE 'bytes=[0-9]+' | cut -d= -f2 | tr '\n' ' ')
        tx=$(echo "$bytes" | awk '{print $1}')
        rx=$(echo "$bytes" | awk '{print $2}')
        [ -z "$tx" ] && tx=0
        [ -z "$rx" ] && rx=0

        echo "${src} ${tx} ${rx}" >> "$CURRENT_FILE"
    done
    rm -f "$CONNTRACK_DUMP" 2>/dev/null

    # Aggregate by IP (sum all entries for same IP)
    AGGREGATED_FILE="${CLIENT_SNAPSHOT}.agg"
    awk '{
        ip=$1; tx=$2; rx=$3
        total_tx[ip] += tx
        total_rx[ip] += rx
    } END {
        for (ip in total_tx) {
            print ip, total_tx[ip], total_rx[ip]
        }
    }' "$CURRENT_FILE" > "$AGGREGATED_FILE" 2>/dev/null

    # Compare with last snapshot to get deltas
    CLIENT_SQL="BEGIN IMMEDIATE;"
    CLIENT_INSERTS=0
    if [ -f "$LAST_FILE" ]; then
        while read -r ip tx rx; do
            [ -z "$ip" ] && continue

            # Get previous values
            prev=$(grep "^${ip} " "$LAST_FILE" 2>/dev/null | head -1)
            if [ -n "$prev" ]; then
                prev_tx=$(echo "$prev" | awk '{print $2}')
                prev_rx=$(echo "$prev" | awk '{print $3}')
            else
                prev_tx=0
                prev_rx=0
            fi

            # Calculate delta (handle counter reset)
            delta_tx=$((tx - prev_tx))
            delta_rx=$((rx - prev_rx))
            [ $delta_tx -lt 0 ] && delta_tx=$tx
            [ $delta_rx -lt 0 ] && delta_rx=$rx

            # Skip if no traffic
            [ $delta_tx -eq 0 ] && [ $delta_rx -eq 0 ] && continue

            # Resolve MAC and hostname
            mac=$(printf '%s' "$MAC_MAP" | grep "^${ip}=" | head -1 | cut -d= -f2)
            [ -z "$mac" ] && mac="unknown"
            hostname="*"
            if [ "$mac" != "unknown" ]; then
                hostname=$(printf '%s' "$HOSTNAME_MAP" | grep -i "^${mac}=" | head -1 | cut -d= -f2)
                [ -z "$hostname" ] && hostname="*"
            fi

            # Escape for SQL
            ip_esc=$(sql_escape "$ip")
            mac_esc=$(sql_escape "$mac")
            host_esc=$(sql_escape "$hostname")

            CLIENT_SQL="${CLIENT_SQL}
INSERT OR REPLACE INTO client_traffic
    VALUES ($TS, '$ip_esc', '$mac_esc', '$host_esc', $delta_rx, $delta_tx);"
            CLIENT_INSERTS=$((CLIENT_INSERTS + 1))

        done < "$AGGREGATED_FILE"
    fi

    # Commit every row as one batch, then advance the counter baseline. If the
    # database rejects any row, retain the previous baseline so the full delta
    # can be retried instead of being silently discarded.
    if [ "$CLIENT_INSERTS" -gt 0 ]; then
        CLIENT_SQL="${CLIENT_SQL}
COMMIT;"
        if ! sqlite_write "$CLIENT_SQL"; then
            rm -f "$CURRENT_FILE" "$AGGREGATED_FILE" 2>/dev/null
            return 1
        fi
    fi
    if ! mv "$AGGREGATED_FILE" "$LAST_FILE" 2>/dev/null; then
        ITERATION_WRITE_FAILED=1
        rm -f "$CURRENT_FILE" "$AGGREGATED_FILE" 2>/dev/null
        logger -t jammonitor "Failed to advance client traffic baseline"
        return 1
    fi
    rm -f "$CURRENT_FILE" 2>/dev/null
}

# Collect interface-level traffic totals (every minute)
# Used to calculate unattributed traffic (total - client sum)
collect_interface_traffic() {
    TS=$(date +%s)
    IFACE_SNAPSHOT="${DATA_DIR}/iface_snapshot"
    CURRENT_IFACE="${IFACE_SNAPSHOT}.current"
    LAST_IFACE="${IFACE_SNAPSHOT}.last"

    # Collect current interface byte counters
    > "$CURRENT_IFACE"
    for iface in $(ls /sys/class/net/ 2>/dev/null); do
        # Skip loopback and virtual interfaces we don't care about
        case "$iface" in
            lo|docker*|veth*|br-*) continue ;;
        esac
        RX=$(cat /sys/class/net/$iface/statistics/rx_bytes 2>/dev/null || echo 0)
        TX=$(cat /sys/class/net/$iface/statistics/tx_bytes 2>/dev/null || echo 0)
        echo "$iface $RX $TX" >> "$CURRENT_IFACE"
    done

    # If we have a previous snapshot, calculate deltas
    IFACE_SQL="BEGIN IMMEDIATE;"
    IFACE_INSERTS=0
    if [ -f "$LAST_IFACE" ]; then
        while read -r iface curr_rx curr_tx; do
            # Find this interface in last snapshot
            last_line=$(grep "^$iface " "$LAST_IFACE" 2>/dev/null)
            if [ -n "$last_line" ]; then
                last_rx=$(echo "$last_line" | awk '{print $2}')
                last_tx=$(echo "$last_line" | awk '{print $3}')

                # Calculate delta (handle counter wrap)
                delta_rx=$((curr_rx - last_rx))
                delta_tx=$((curr_tx - last_tx))
                [ "$delta_rx" -lt 0 ] && delta_rx=0
                [ "$delta_tx" -lt 0 ] && delta_tx=0

                # Store if non-zero
                if [ "$delta_rx" -gt 0 ] || [ "$delta_tx" -gt 0 ]; then
                    iface_esc=$(sql_escape "$iface")
                    IFACE_SQL="${IFACE_SQL}
INSERT OR REPLACE INTO interface_traffic
    (ts, iface, rx_bytes, tx_bytes)
    VALUES ($TS, '$iface_esc', $delta_rx, $delta_tx);"
                    IFACE_INSERTS=$((IFACE_INSERTS + 1))
                fi
            fi
        done < "$CURRENT_IFACE"
    fi

    if [ "$IFACE_INSERTS" -gt 0 ]; then
        IFACE_SQL="${IFACE_SQL}
COMMIT;"
        if ! sqlite_write "$IFACE_SQL"; then
            rm -f "$CURRENT_IFACE" 2>/dev/null
            return 1
        fi
    fi
    if ! mv "$CURRENT_IFACE" "$LAST_IFACE" 2>/dev/null; then
        ITERATION_WRITE_FAILED=1
        rm -f "$CURRENT_IFACE" 2>/dev/null
        logger -t jammonitor "Failed to advance interface traffic baseline"
        return 1
    fi
}

# Stream each log record once. The previous once-per-minute `tail -100`
# snapshot duplicated the same ring-buffer lines thousands of times and
# repeatedly overwrote the only archive.
syslog_stream_guard() {
    _syslog_parent_pid="$1"
    _syslog_parent_ticks="$2"
    _syslog_child_pid=""

    # Open the descriptor-relative path while the verified mount pin is still
    # available, then drop both collector-owned descriptors. The guardian and
    # logread must not preserve either the singleton lock or the mount pin
    # after a collector SIGKILL.
    exec 7>>"$LOG_PATH" || return 1
    exec 8<&-
    exec 9>&-
    exec 6<>"$SYSLOG_LOCK_FILE" || return 1

    _syslog_child_cleanup() {
        if [ -n "$_syslog_child_pid" ]; then
            kill "$_syslog_child_pid" 2>/dev/null || true
            _syslog_stop_remaining="$SYSLOG_STOP_GRACE_SECONDS"
            while kill -0 "$_syslog_child_pid" 2>/dev/null &&
                  [ "$_syslog_stop_remaining" -gt 0 ]
            do
                sleep 1 6>&- 7>&-
                _syslog_stop_remaining=$((_syslog_stop_remaining - 1))
            done
            if kill -0 "$_syslog_child_pid" 2>/dev/null; then
                kill -KILL "$_syslog_child_pid" 2>/dev/null || true
            fi
            wait "$_syslog_child_pid" 2>/dev/null || true
            _syslog_child_pid=""
        fi
    }
    trap 'exit 0' HUP INT TERM
    trap '_syslog_child_cleanup' EXIT

    # Serialize a prior orphan guardian and its successor. A nonblocking loop
    # lets this guardian keep proving its own parent generation while it waits.
    while collector_generation_is_live \
        "$_syslog_parent_pid" "$_syslog_parent_ticks" 6>&- 7>&-
    do
        if "$FLOCK_CMD" -n 6 7>&-; then
            break
        fi
        sleep 1 6>&- 7>&-
    done
    collector_generation_is_live \
        "$_syslog_parent_pid" "$_syslog_parent_ticks" 6>&- 7>&- ||
        return 0

    # Only the append descriptor is inherited. In particular, logread cannot
    # keep the stream lock, collector lock, or mount pin alive.
    "$LOGREAD_CMD" -f 6>&- 8>&- 9>&- >&7 2>/dev/null &
    _syslog_child_pid=$!

    while collector_generation_is_live \
        "$_syslog_parent_pid" "$_syslog_parent_ticks" 6>&- 7>&-
    do
        if ! kill -0 "$_syslog_child_pid" 2>/dev/null; then
            _syslog_child_cleanup
            return 0
        fi
        sleep 1 6>&- 7>&-
    done
    # Run cleanup while descriptor 6 is unquestionably still open and locked.
    # Deferring this solely to an EXIT trap can let a shell release nonstandard
    # descriptors before the trap has reaped logread.
    _syslog_child_cleanup
    return 0
}

start_syslog_stream() {
    syslog_stream_guard "$$" "$COLLECTOR_START_TICKS" &
    SYSLOG_PID=$!
}

stop_syslog_stream() {
    if [ -n "$SYSLOG_PID" ]; then
        kill "$SYSLOG_PID" 2>/dev/null || true
        wait "$SYSLOG_PID" 2>/dev/null || true
        SYSLOG_PID=""
    fi
}

maintain_syslog_stream() {
    if [ -z "$SYSLOG_PID" ] || ! kill -0 "$SYSLOG_PID" 2>/dev/null; then
        stop_syslog_stream
        start_syslog_stream
    fi

    [ -f "$LOG_PATH" ] || return
    SIZE=$(stat -c%s "$LOG_PATH" 2>/dev/null || stat -f%z "$LOG_PATH" 2>/dev/null || echo 0)
    if [ "$SIZE" -gt "$MAX_LOG_SIZE" ]; then
        stop_syslog_stream
        # One fixed archive bounds steady-state fanout. Atomic replacement
        # also retires any legacy symlink name without following its target.
        ROTATED="${LOG_PATH}.old"
        if mv -f "$LOG_PATH" "$ROTATED"; then
            start_syslog_stream
        else
            start_syslog_stream
            ITERATION_WRITE_FAILED=1
            logger -t jammonitor "Syslog rotation failed"
            return 1
        fi
    fi
}

# Rollup old per-client traffic to hourly summaries
rollup_client_traffic() {
    CUTOFF_RAW=$(($(date +%s) - RETENTION_DAYS_RAW * 86400))

    # Check if there's data to roll up
    COUNT=$(sqlite_read "SELECT COUNT(*) FROM client_traffic WHERE ts < $CUTOFF_RAW;")
    [ -z "$COUNT" ] || [ "$COUNT" -eq 0 ] && return

    logger -t jammonitor "Rolling up $COUNT old client_traffic entries to hourly"

    # Aggregate into hourly buckets (use INSERT OR IGNORE + UPDATE to merge)
    sqlite_write "
        BEGIN IMMEDIATE;
        INSERT OR REPLACE INTO client_traffic_hourly (hour_ts, ip, mac, hostname, rx_bytes, tx_bytes)
        SELECT
            (ts / 3600) * 3600 as hour_ts,
            ip,
            mac,
            hostname,
            COALESCE((SELECT rx_bytes FROM client_traffic_hourly WHERE hour_ts = (ts / 3600) * 3600 AND ip = client_traffic.ip), 0) + SUM(rx_bytes),
            COALESCE((SELECT tx_bytes FROM client_traffic_hourly WHERE hour_ts = (ts / 3600) * 3600 AND ip = client_traffic.ip), 0) + SUM(tx_bytes)
        FROM client_traffic
        WHERE ts < $CUTOFF_RAW
        GROUP BY (ts / 3600) * 3600, ip;

        DELETE FROM client_traffic WHERE ts < $CUTOFF_RAW;
        COMMIT;
    "
}

# Dynamic cleanup when disk usage exceeds threshold
dynamic_cleanup() {
    # Get disk usage percentage for the exact configured data mount.
    USAGE=$(df "$MOUNT_POINT" 2>/dev/null | awk 'NR==2 {gsub(/%/,""); print $5}')
    [ -z "$USAGE" ] && return

    if [ "$USAGE" -gt "$DISK_THRESHOLD" ]; then
        # Delete oldest week of hourly rollups
        OLDEST=$(sqlite_read "SELECT MIN(hour_ts) FROM client_traffic_hourly;")
        [ -z "$OLDEST" ] || [ "$OLDEST" = "" ] && return

        CUTOFF=$((OLDEST + 7 * 86400))
        sqlite_write "DELETE FROM client_traffic_hourly WHERE hour_ts < $CUTOFF;"
        logger -t jammonitor "Cleaned old hourly rollups, disk was ${USAGE}%"

        # Also run vacuum to reclaim space
        sqlite_write "VACUUM;"
    fi
}

# Cleanup old data
cleanup_syslog_archive() {
    [ -f "${LOG_PATH}.old" ] || return 0
    OLDTIME=$(stat -c%Y "${LOG_PATH}.old" 2>/dev/null ||
        stat -f%m "${LOG_PATH}.old" 2>/dev/null || echo 0)
    NOW=$(date +%s)
    if [ $((NOW - OLDTIME)) -gt $((RETENTION_DAYS * 86400)) ]; then
        rm -f "${LOG_PATH}.old"
    fi
}

cleanup() {
    CUTOFF=$(($(date +%s) - RETENTION_DAYS * 86400))
    sqlite_write "DELETE FROM metrics WHERE ts < $CUTOFF;"
    sqlite_write "DELETE FROM snapshots WHERE ts < $CUTOFF;"
    sqlite_write "DELETE FROM service_health WHERE ts < $CUTOFF;"

    # Rollup and cleanup per-client traffic
    rollup_client_traffic
    dynamic_cleanup

    # Pre-start migration collapses every legacy timestamped rotation. The
    # running producer owns only this fixed descriptor-relative archive.
    cleanup_syslog_archive
}

# Stop after defining functions when sourced by the regression suite.
if [ "$LIB_ONLY" = "1" ]; then
    return 0 2>/dev/null || exit 0
fi

# Main
if ! init_db; then
    logger -t jammonitor "FATAL: failed to initialize $DB_PATH"
    QUICK_CHECK="failed"
    publish_collector_status
    exit 1
fi

LAST_SAMPLE_AT="$(sqlite_read "SELECT COALESCE(MAX(ts), 0) FROM metrics;")"
is_uint "$LAST_SAMPLE_AT" || LAST_SAMPLE_AT=0
run_quick_check || {
    logger -t jammonitor "FATAL: SQLite quick_check returned ${QUICK_CHECK:-no result}"
    publish_collector_status
    exit 1
}

start_syslog_stream
publish_collector_status

COUNTER=0

while true; do
    if ! require_data_mount; then
        publish_collector_status
        exit 1
    fi

    ITERATION_WRITE_FAILED=0
    METRIC_WRITE_OK=0

    # Collect metrics, snapshots, per-client and per-interface traffic every minute.
    # A successful metrics row is necessary but not sufficient: any failed
    # essential SQLite write makes the complete collection cycle unhealthy.
    if collect_metrics; then
        LAST_SAMPLE_AT="$TS"
        METRIC_WRITE_OK=1
    fi

    collect_slow || true
    collect_tailscale_health || true
    collect_client_traffic || true
    collect_interface_traffic || true
    maintain_syslog_stream

    COUNTER=$((COUNTER + 1))

    # Cleanup every hour (60 iterations)
    if [ $COUNTER -ge 60 ]; then
        if ! run_quick_check; then
            logger -t jammonitor "FATAL: hourly SQLite quick_check returned ${QUICK_CHECK:-no result}"
            publish_collector_status
            exit 1
        fi
        cleanup
        COUNTER=0
    fi

    if [ "$METRIC_WRITE_OK" -eq 1 ] &&
       [ "$ITERATION_WRITE_FAILED" -eq 0 ]; then
        LAST_SUCCESS_AT="$LAST_SAMPLE_AT"
        CONSECUTIVE_WRITE_FAILURES=0
    else
        CONSECUTIVE_WRITE_FAILURES=$((CONSECUTIVE_WRITE_FAILURES + 1))
    fi
    publish_collector_status

    if [ "$CONSECUTIVE_WRITE_FAILURES" -ge 3 ]; then
        logger -t jammonitor "FATAL: three consecutive essential collection writes failed; exiting for supervised recovery"
        exit 1
    fi

    # A parent crash must not leave sleep holding either the singleton lock or
    # the descriptor that pins the verified USB mount.
    sleep 60 8>&- 9>&-
done
