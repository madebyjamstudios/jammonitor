#!/bin/sh /etc/rc.common
START=99
STOP=20
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/jammonitor-collect
    # Missing/read-only USB and corrupt SQLite are deterministic faults. Keep
    # retries finite so they remain visible instead of creating a log storm.
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 15
    procd_close_instance
}
