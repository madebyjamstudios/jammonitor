#!/bin/sh
#
# JamMonitor Tailscale semantic watchdog
#
# procd owns process crash recovery. This watchdog observes delivered local
# Tailscale state and permits at most three cooldown-separated supervisor
# restart attempts per proven local failure episode. Authentication, approval,
# control-plane, health-warning, and peer failures remain visible operator
# conditions and never cause restart loops.
#
# Only a small fixed-schema snapshot crosses into JamMonitor. Raw status JSON,
# AuthURL, users, keys, endpoints, peer targets, Health text, and CLI errors are
# held in private temporary files and deleted after every observation.

PATH="/usr/sbin:/usr/bin:/sbin:/bin"
LC_ALL=C
export LC_ALL

TAILSCALE_CLI="${TAILSCALE_CLI:-/usr/sbin/tailscale}"
TAILSCALE_INIT="${TAILSCALE_INIT:-/etc/init.d/tailscale}"
TAILSCALE_SOCKET="${TAILSCALE_SOCKET:-/var/run/tailscale/tailscaled.sock}"
STATE_DIR="${WATCHDOG_STATE_DIR:-/var/run/jammonitor}"
STATUS_FILE="${WATCHDOG_STATUS_FILE:-${STATE_DIR}/tailscale-watchdog.json}"
MEMORY_FILE="${WATCHDOG_MEMORY_FILE:-${STATE_DIR}/tailscale-watchdog.memory}"
CONTINUITY_BREAK_FILE="${WATCHDOG_CONTINUITY_BREAK_FILE:-${STATE_DIR}/tailscale-watchdog.continuity-broken}"
MAINTENANCE_FILE="${WATCHDOG_MAINTENANCE_FILE:-${STATE_DIR}/tailscale-maintenance}"
CRITICAL_PEER_FILE="${WATCHDOG_CRITICAL_PEER_FILE:-/etc/jammonitor/tailscale-critical-peer}"
LOCK_FILE="${WATCHDOG_LOCK_FILE:-${STATE_DIR}/tailscale-watchdog.lock}"
INSTALL_LOCK_FILE="${WATCHDOG_INSTALL_LOCK_FILE:-${STATE_DIR}/router-install.lock}"
PROC_ROOT="${WATCHDOG_PROC_ROOT:-/proc}"
FD_ROOT="${WATCHDOG_FD_ROOT:-/proc/self/fd}"
UPTIME_FILE="${WATCHDOG_UPTIME_FILE:-/proc/uptime}"
PROCESS_NAME="${WATCHDOG_PROCESS_NAME:-tailscaled}"
PROCESS_BINARY="${WATCHDOG_PROCESS_BINARY:-/usr/sbin/tailscaled}"
ROUTER_MANIFEST="${WATCHDOG_ROUTER_MANIFEST:-/usr/share/jammonitor/router-files.sha256}"
ROUTER_MANIFEST_DIGEST="${WATCHDOG_ROUTER_MANIFEST_DIGEST:-/usr/share/jammonitor/router-files.sha256.sha256}"
EXPECTED_ROOT_UID="${WATCHDOG_EXPECTED_ROOT_UID:-0}"
EXPECTED_ROOT_GID="${WATCHDOG_EXPECTED_ROOT_GID:-0}"

CHECK_INTERVAL="${WATCHDOG_INTERVAL:-15}"
STATUS_TIMEOUT="${WATCHDOG_STATUS_TIMEOUT:-5}"
PEER_TIMEOUT="${WATCHDOG_PEER_TIMEOUT:-5}"
FAILURE_THRESHOLD="${WATCHDOG_FAILURE_THRESHOLD:-3}"
VALID_STREAK_REQUIRED="${WATCHDOG_VALID_STREAK_REQUIRED:-5}"
BOOT_GRACE="${WATCHDOG_BOOT_GRACE:-120}"
RESTART_TIMEOUT="${WATCHDOG_RESTART_TIMEOUT:-30}"
# Logging is diagnostic only. Never let a blocked local logging stack stall
# observations, recovery decisions, or singleton handoff.
LOGGER_TIMEOUT=2
# Recovery authority is a fixed safety contract, not a tunable threshold.
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_RETRY_SHORT=60
RECOVERY_RETRY_LONG=300
MAINTENANCE_MAX_FUTURE="${WATCHDOG_MAINTENANCE_MAX_FUTURE:-3600}"
CLOCK_TICKS="${WATCHDOG_CLOCK_TICKS:-100}"
CONTINUITY_MAX_GAP="${WATCHDOG_CONTINUITY_MAX_GAP:-30}"
# POSIX ulimit -f uses 512-byte blocks. Keep raw LocalAPI output at 64 KiB.
STATUS_FILE_BLOCKS=128
# This accommodates the complete fixed schema with 100 maximum-width members
# in each projected array. It rejects pathological type vectors before ash can
# spend thousands of interpreted iterations on attacker-shaped LocalAPI data.
PROJECTION_TYPE_HEADER_MAX_BYTES=2048

TIMEOUT_CMD="${WATCHDOG_TIMEOUT_CMD:-timeout}"
LOGGER_CMD="${WATCHDOG_LOGGER_CMD:-logger}"
SLEEP_CMD="${WATCHDOG_SLEEP_CMD:-sleep}"
JSONFILTER_CMD="${WATCHDOG_JSONFILTER_CMD:-jsonfilter}"
FLOCK_CMD="${WATCHDOG_FLOCK_CMD:-flock}"
READLINK_CMD="${WATCHDOG_READLINK_CMD:-readlink}"
STAT_CMD="${WATCHDOG_STAT_CMD:-stat}"
SHA256_CMD="${WATCHDOG_SHA256_CMD:-sha256sum}"

RUN_ONCE=0
if [ "${1:-}" = "--once" ]; then
    RUN_ONCE=1
elif [ "$#" -gt 0 ]; then
    echo "Usage: $0 [--once]" >&2
    exit 2
fi

is_uint() {
    case "${1:-}" in
        0|[1-9]|[1-9][0-9]*)
            [ "${#1}" -le 18 ]
            ;;
        *)
            return 1
            ;;
    esac
}

is_safe_token() {
    _safe_token="${1:-}"
    [ -n "$_safe_token" ] &&
        [ "${#_safe_token}" -le 128 ] || return 1
    case "$_safe_token" in
        *[!A-Za-z0-9_.:-]*) return 1 ;;
    esac
}

is_sha256() {
    _sha256="${1:-}"
    [ "${#_sha256}" -eq 64 ] || return 1
    case "$_sha256" in
        *[!0-9a-f]*) return 1 ;;
    esac
}

is_ipv4_octet() {
    _ip_octet="${1:-}"
    case "$_ip_octet" in
        0|[1-9]|[1-9][0-9]|[1-9][0-9][0-9]) ;;
        *) return 1 ;;
    esac
    [ "$_ip_octet" -le 255 ]
}

ipv6_part_group_count() {
    _ipv6_part="${1:-}"
    IPV6_GROUP_COUNT=0
    [ -n "$_ipv6_part" ] || return 0
    case "$_ipv6_part" in
        :*|*:|*::*|*[!0-9a-f:]*) return 1 ;;
    esac

    _ipv6_old_ifs="$IFS"
    IFS=:
    set -- $_ipv6_part
    IFS="$_ipv6_old_ifs"
    for _ipv6_group in "$@"; do
        [ -n "$_ipv6_group" ] &&
            [ "${#_ipv6_group}" -le 4 ] || return 1
    done
    IPV6_GROUP_COUNT="$#"
}

is_tailscale_ip() {
    _candidate="${1:-}"
    [ -n "$_candidate" ] && [ "${#_candidate}" -le 39 ] || return 1
    case "$_candidate" in
        *:*)
            case "$_candidate" in *[!0-9A-Fa-f:]*) return 1 ;; esac
            _candidate="$(printf '%s' "$_candidate" | tr 'A-F' 'a-f')"
            case "$_candidate" in
                fd7a:115c:a1e0:*) ;;
                *) return 1 ;;
            esac

            case "$_candidate" in
                *::*)
                    _ipv6_left="${_candidate%%::*}"
                    _ipv6_right="${_candidate#*::}"
                    case "$_ipv6_right" in *::*) return 1 ;; esac
                    ipv6_part_group_count "$_ipv6_left" || return 1
                    _ipv6_left_count="$IPV6_GROUP_COUNT"
                    ipv6_part_group_count "$_ipv6_right" || return 1
                    _ipv6_right_count="$IPV6_GROUP_COUNT"
                    [ $((_ipv6_left_count + _ipv6_right_count)) -lt 8 ]
                    ;;
                *)
                    ipv6_part_group_count "$_candidate" &&
                        [ "$IPV6_GROUP_COUNT" -eq 8 ]
                    ;;
            esac
            ;;
        *.*)
            case "$_candidate" in
                .*|*.|*..*|*[!0-9.]*) return 1 ;;
            esac
            _ip_old_ifs="$IFS"
            IFS=.
            set -- $_candidate
            IFS="$_ip_old_ifs"
            [ "$#" -eq 4 ] || return 1
            for _octet in "$@"; do
                is_ipv4_octet "$_octet" || return 1
            done
            [ "$1" = "100" ] &&
                [ "$2" -ge 64 ] &&
                [ "$2" -le 127 ]
            ;;
        *)
            return 1
            ;;
    esac
}

append_normalized_ipv6_part() {
    _ipv6_append_part="${1:-}"
    [ -n "$_ipv6_append_part" ] || return
    _ipv6_append_old_ifs="$IFS"
    IFS=:
    set -- $_ipv6_append_part
    IFS="$_ipv6_append_old_ifs"
    for _ipv6_append_group in "$@"; do
        case "${#_ipv6_append_group}" in
            1) _ipv6_padded="000${_ipv6_append_group}" ;;
            2) _ipv6_padded="00${_ipv6_append_group}" ;;
            3) _ipv6_padded="0${_ipv6_append_group}" ;;
            4) _ipv6_padded="$_ipv6_append_group" ;;
            *) return 1 ;;
        esac
        _ipv6_normalized="${_ipv6_normalized}${_ipv6_padded}:"
    done
}

tailscale_ip_key() {
    _ip_key_candidate="${1:-}"
    is_tailscale_ip "$_ip_key_candidate" || return 1
    case "$_ip_key_candidate" in
        *.*)
            printf '%s' "$_ip_key_candidate"
            return
            ;;
    esac

    _ip_key_candidate="$(
        printf '%s' "$_ip_key_candidate" | tr 'A-F' 'a-f'
    )"
    _ipv6_normalized=""
    case "$_ip_key_candidate" in
        *::*)
            _ipv6_key_left="${_ip_key_candidate%%::*}"
            _ipv6_key_right="${_ip_key_candidate#*::}"
            ipv6_part_group_count "$_ipv6_key_left" || return 1
            _ipv6_key_left_count="$IPV6_GROUP_COUNT"
            ipv6_part_group_count "$_ipv6_key_right" || return 1
            _ipv6_key_right_count="$IPV6_GROUP_COUNT"
            _ipv6_missing=$((8 - _ipv6_key_left_count - _ipv6_key_right_count))
            append_normalized_ipv6_part "$_ipv6_key_left" || return 1
            while [ "$_ipv6_missing" -gt 0 ]; do
                _ipv6_normalized="${_ipv6_normalized}0000:"
                _ipv6_missing=$((_ipv6_missing - 1))
            done
            append_normalized_ipv6_part "$_ipv6_key_right" || return 1
            ;;
        *)
            append_normalized_ipv6_part "$_ip_key_candidate" || return 1
            ;;
    esac
    printf '%s' "${_ipv6_normalized%:}"
}

is_process_generation() {
    _generation="${1:-}"
    [ "${#_generation}" -le 64 ] || return 1
    case "$_generation" in
        *:*)
            _generation_pid="${_generation%%:*}"
            _generation_ticks="${_generation#*:}"
            case "$_generation_ticks" in
                *:*) return 1 ;;
            esac
            [ "${#_generation_pid}" -le 18 ] &&
                [ "${#_generation_ticks}" -le 18 ] &&
                is_uint "$_generation_pid" &&
                [ "$_generation_pid" -gt 1 ] &&
                is_uint "$_generation_ticks" &&
                [ "$_generation_ticks" -gt 0 ]
            ;;
        *)
            return 1
            ;;
    esac
}

positive_or() {
    _value="$1"
    _fallback="$2"
    if ! is_uint "$_value" || [ "$_value" -lt 1 ]; then
        printf '%s' "$_fallback"
    else
        printf '%s' "$_value"
    fi
}

nonnegative_or() {
    _value="$1"
    _fallback="$2"
    if ! is_uint "$_value"; then
        printf '%s' "$_fallback"
    else
        printf '%s' "$_value"
    fi
}

CHECK_INTERVAL="$(positive_or "$CHECK_INTERVAL" 15)"
STATUS_TIMEOUT="$(positive_or "$STATUS_TIMEOUT" 5)"
PEER_TIMEOUT="$(positive_or "$PEER_TIMEOUT" 5)"
FAILURE_THRESHOLD="$(positive_or "$FAILURE_THRESHOLD" 3)"
VALID_STREAK_REQUIRED="$(positive_or "$VALID_STREAK_REQUIRED" 5)"
BOOT_GRACE="$(nonnegative_or "$BOOT_GRACE" 120)"
RESTART_TIMEOUT="$(positive_or "$RESTART_TIMEOUT" 30)"
MAINTENANCE_MAX_FUTURE="$(positive_or "$MAINTENANCE_MAX_FUTURE" 3600)"
CLOCK_TICKS="$(positive_or "$CLOCK_TICKS" 100)"
CONTINUITY_MAX_GAP="$(positive_or "$CONTINUITY_MAX_GAP" 30)"

umask 077
mkdir -p "$STATE_DIR" || exit 1
chmod 0700 "$STATE_DIR" 2>/dev/null || true

ACTIVE_CHILD=""
ACTIVE_LOG_CHILD=""
INSTALL_LOCK_TRUSTED=0
INSTALL_LOCK_IDENTITY=""
INSTALL_LOCK_HELD=0
INSTALL_TRANSACTION_STATE="unknown"
STATUS_OUTPUT="${STATE_DIR}/tailscale-status.$$"
STATUS_ERROR="${STATE_DIR}/tailscale-status-error.$$"
STATUS_PROJECTION="${STATE_DIR}/tailscale-status-projection.$$"

terminate_child_pid() {
    _terminate_pid="$1"
    if [ -n "$_terminate_pid" ]; then
        kill -TERM "$_terminate_pid" 2>/dev/null || true
        (
            /bin/sleep 1
            kill -KILL "$_terminate_pid" 2>/dev/null || true
        ) 7>&- 9>&- &
        _terminate_killer=$!
        wait "$_terminate_pid" 2>/dev/null || true
        kill "$_terminate_killer" 2>/dev/null || true
        wait "$_terminate_killer" 2>/dev/null || true
    fi
}

terminate_active_child() {
    terminate_child_pid "$ACTIVE_LOG_CHILD"
    ACTIVE_LOG_CHILD=""
    terminate_child_pid "$ACTIVE_CHILD"
    ACTIVE_CHILD=""
}

clear_status_artifacts() {
    _clear_status_rc=0
    clear_raw_status_artifacts || _clear_status_rc=1
    clear_projection_artifact || _clear_status_rc=1
    [ "$_clear_status_rc" -eq 0 ]
}

clear_raw_status_artifacts() {
    rm -f "$STATUS_OUTPUT" "$STATUS_ERROR" 9>&- || return 1
    [ ! -e "$STATUS_OUTPUT" ] && [ ! -L "$STATUS_OUTPUT" ] &&
        [ ! -e "$STATUS_ERROR" ] && [ ! -L "$STATUS_ERROR" ]
}

clear_projection_artifact() {
    rm -f "$STATUS_PROJECTION" 9>&- || return 1
    [ ! -e "$STATUS_PROJECTION" ] && [ ! -L "$STATUS_PROJECTION" ]
}

remove_stale_status_artifacts() {
    for _stale_path in \
        "$STATE_DIR"/tailscale-status.[0-9]* \
        "$STATE_DIR"/tailscale-status-error.[0-9]* \
        "$STATE_DIR"/tailscale-status-projection.[0-9]*
    do
        [ -e "$_stale_path" ] || [ -L "$_stale_path" ] || continue
        _stale_basename="${_stale_path##*/}"
        case "$_stale_basename" in
            tailscale-status-error.*)
                _stale_suffix="${_stale_basename#tailscale-status-error.}"
                ;;
            tailscale-status-projection.*)
                _stale_suffix="${_stale_basename#tailscale-status-projection.}"
                ;;
            tailscale-status.*)
                _stale_suffix="${_stale_basename#tailscale-status.}"
                ;;
            *)
                continue
                ;;
        esac
        case "$_stale_suffix" in
            ""|*[!0-9]*) continue ;;
        esac
        rm -f "$_stale_path" 9>&- || return 1
        [ ! -e "$_stale_path" ] && [ ! -L "$_stale_path" ] ||
            return 1
    done
}

cleanup() {
    terminate_active_child
    release_install_lock
    clear_status_artifacts 2>/dev/null || true
    # Neither persistent lock inode is removed. Descriptors 7 and 9 are
    # released atomically by close or process exit.
}

handle_signal() {
    trap - INT TERM
    terminate_active_child
    exit 0
}

trap cleanup EXIT
trap handle_signal INT TERM

acquire_lock() {
    exec 9<>"$LOCK_FILE" || return 1
    if ! "$FLOCK_CMD" -n 9; then
        return 2
    fi

    # Metadata is diagnostic only. Stale contents, live PID reuse, and a
    # simultaneous start cannot grant ownership without the held kernel lock.
    {
        printf 'pid=%s\n' "$$"
        printf 'identity=jammonitor-tailscale-watchdog\n'
    } > "$LOCK_FILE" || return 1
    return 0
}

prepare_install_lock() {
    _install_lock_created=0
    if [ ! -e "$INSTALL_LOCK_FILE" ] &&
       [ ! -L "$INSTALL_LOCK_FILE" ]; then
        if (
            set -C
            umask 077
            : > "$INSTALL_LOCK_FILE"
        ) 2>/dev/null; then
            _install_lock_created=1
        fi
    fi

    [ -f "$INSTALL_LOCK_FILE" ] &&
        [ ! -L "$INSTALL_LOCK_FILE" ] ||
        return 1
    if [ "$_install_lock_created" -eq 1 ]; then
        chmod 0600 "$INSTALL_LOCK_FILE" || return 1
    fi
    _install_lock_metadata="$(
        "$STAT_CMD" -c '%u:%g:%a:%h:%d:%i:%s' \
            "$INSTALL_LOCK_FILE" 2>/dev/null
    )" || return 1
    _old_ifs="$IFS"
    IFS=:
    set -- $_install_lock_metadata
    IFS="$_old_ifs"
    [ "$#" -eq 7 ] &&
        [ "$1" = "$EXPECTED_ROOT_UID" ] &&
        [ "$2" = "$EXPECTED_ROOT_GID" ] &&
        [ "$3" = "600" ] &&
        [ "$4" = "1" ] &&
        is_uint "$5" &&
        is_uint "$6" &&
        is_uint "$7" &&
        [ "$7" -le 1024 ] ||
        return 1
    INSTALL_LOCK_IDENTITY="$_install_lock_metadata"
    INSTALL_LOCK_TRUSTED=1
}

release_install_lock() {
    if [ "$INSTALL_LOCK_HELD" -eq 1 ]; then
        exec 7>&-
        INSTALL_LOCK_HELD=0
    fi
}

acquire_install_lock() {
    [ "$INSTALL_LOCK_TRUSTED" -eq 1 ] &&
        [ -n "$INSTALL_LOCK_IDENTITY" ] ||
        return 2
    _install_lock_before="$(
        "$STAT_CMD" -c '%u:%g:%a:%h:%d:%i:%s' \
            "$INSTALL_LOCK_FILE" 2>/dev/null
    )" || return 2
    [ "$_install_lock_before" = "$INSTALL_LOCK_IDENTITY" ] ||
        return 2
    exec 7<>"$INSTALL_LOCK_FILE" || return 2
    _install_lock_fd="$(
        "$STAT_CMD" -L -c '%u:%g:%a:%h:%d:%i:%s' \
            "$FD_ROOT/7" 2>/dev/null
    )" || {
        exec 7>&-
        return 2
    }
    _install_lock_after="$(
        "$STAT_CMD" -c '%u:%g:%a:%h:%d:%i:%s' \
            "$INSTALL_LOCK_FILE" 2>/dev/null
    )" || {
        exec 7>&-
        return 2
    }
    if [ "$_install_lock_fd" != "$INSTALL_LOCK_IDENTITY" ] ||
       [ "$_install_lock_after" != "$INSTALL_LOCK_IDENTITY" ]; then
        exec 7>&-
        return 2
    fi

    "$FLOCK_CMD" -n 7
    _install_lock_rc=$?
    if [ "$_install_lock_rc" -eq 0 ]; then
        # The pathname can be replaced after the pre-flock join while this
        # descriptor still names the original inode. Rejoin both sides after
        # kernel ownership is established, before granting restart authority.
        _install_lock_fd="$(
            "$STAT_CMD" -L -c '%u:%g:%a:%h:%d:%i:%s' \
                "$FD_ROOT/7" 2>/dev/null
        )" || {
            exec 7>&-
            return 2
        }
        _install_lock_after="$(
            "$STAT_CMD" -c '%u:%g:%a:%h:%d:%i:%s' \
                "$INSTALL_LOCK_FILE" 2>/dev/null
        )" || {
            exec 7>&-
            return 2
        }
        if [ "$_install_lock_fd" != "$INSTALL_LOCK_IDENTITY" ] ||
           [ "$_install_lock_after" != "$INSTALL_LOCK_IDENTITY" ]; then
            exec 7>&-
            return 2
        fi
        INSTALL_LOCK_HELD=1
        return 0
    fi
    exec 7>&-
    if [ "$_install_lock_rc" -eq 1 ]; then
        return 1
    fi
    return 2
}

inspect_install_transaction() {
    INSTALL_TRANSACTION_STATE="unknown"
    acquire_install_lock
    _install_lock_rc=$?
    case "$_install_lock_rc" in
        0)
            INSTALL_TRANSACTION_STATE="idle"
            release_install_lock
            return 0
            ;;
        1)
            INSTALL_TRANSACTION_STATE="active"
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

command -v "$FLOCK_CMD" >/dev/null 2>&1 || {
    printf 'jammonitor-tailscale-watchdog: flock command unavailable: %s\n' \
        "$FLOCK_CMD" >&2
    exit 1
}
acquire_lock
_lock_rc=$?
if [ "$_lock_rc" -eq 2 ]; then
    exit 0
elif [ "$_lock_rc" -ne 0 ]; then
    printf 'jammonitor-tailscale-watchdog: cannot acquire %s\n' \
        "$LOCK_FILE" >&2
    exit 1
fi
prepare_install_lock || INSTALL_LOCK_TRUSTED=0
remove_stale_status_artifacts || {
    printf '%s\n' \
        'jammonitor-tailscale-watchdog: cannot clear stale status artifacts' \
        >&2
    exit 1
}

sanitize_token() {
    printf '%s' "${1:-}" | tr -cd 'A-Za-z0-9_.:-' | cut -c1-128
}

read_memory() {
    _key="$1"
    [ -f "$MEMORY_FILE" ] || return 0
    sed -n "s/^${_key}=//p" "$MEMORY_FILE" 2>/dev/null | tail -n 1
}

load_uint() {
    _loaded="$(read_memory "$1")"
    if is_uint "$_loaded"; then
        printf '%s' "$_loaded"
    else
        printf '0'
    fi
}

CONSECUTIVE_FAILURES="$(load_uint consecutive_failures)"
RECOVERY_ATTEMPTED="$(load_uint recovery_attempted)"
RECOVERY_COUNT="$(load_uint recovery_count)"
VALID_STREAK="$(load_uint valid_streak)"
CONDITION_SINCE_AT="$(load_uint condition_since_at)"
CONDITION_SINCE_MONO="$(load_uint condition_since_mono)"
CONNECTED_SINCE_AT="$(load_uint connected_since_at)"
CONNECTED_SINCE_MONO="$(load_uint connected_since_mono)"
LAST_CONNECTED_AT="$(load_uint last_connected_at)"
PEER_LAST_SUCCESS_AT="$(load_uint peer_last_success_at)"
PREVIOUS_STATUS="$(sanitize_token "$(read_memory last_status)")"
PREVIOUS_PROCESS_GENERATION="$(sanitize_token "$(read_memory process_generation)")"
PREVIOUS_OBSERVED_MONO="$(load_uint last_observed_monotonic)"
PREVIOUS_PEER_CONTRACT_KEY="$(
    sanitize_token "$(read_memory peer_contract_key)"
)"
if [ -e "$CONTINUITY_BREAK_FILE" ] ||
   [ -L "$CONTINUITY_BREAK_FILE" ]; then
    CONTINUITY_BROKEN=1
else
    CONTINUITY_BROKEN=0
fi

memory_key_count() {
    _memory_count="$(
        grep -c "^${1}=" "$MEMORY_FILE" 2>/dev/null
    )"
    is_uint "$_memory_count" || _memory_count=0
    printf '%s\n' "$_memory_count"
}

load_recovery_retry_state() {
    RECOVERY_ATTEMPT_COUNT=0
    RECOVERY_NEXT_RETRY_MONO=0
    RECOVERY_RETRY_STATE_INVALID=0

    if [ ! -e "$MEMORY_FILE" ] && [ ! -L "$MEMORY_FILE" ]; then
        RECOVERY_ATTEMPTED=0
        return
    fi
    if [ -L "$MEMORY_FILE" ] || [ ! -f "$MEMORY_FILE" ]; then
        RECOVERY_RETRY_STATE_INVALID=1
    else
        _retry_latch_count="$(memory_key_count recovery_attempted)"
        _retry_count_count="$(memory_key_count recovery_attempt_count)"
        _retry_deadline_count="$(memory_key_count recovery_next_retry_monotonic)"
        _retry_latch="$(read_memory recovery_attempted)"
        case "$_retry_latch_count:$_retry_latch" in
            1:0|1:1) ;;
            *) RECOVERY_RETRY_STATE_INVALID=1 ;;
        esac

        if [ "$RECOVERY_RETRY_STATE_INVALID" -eq 0 ] &&
           [ "$_retry_count_count" -eq 0 ] &&
           [ "$_retry_deadline_count" -eq 0 ]; then
            # Safe migration from the old one-shot state. A spent legacy latch
            # has unknown retry history, so it becomes operator-only.
            RECOVERY_ATTEMPTED="$_retry_latch"
            if [ "$RECOVERY_ATTEMPTED" -eq 1 ]; then
                RECOVERY_ATTEMPT_COUNT="$RECOVERY_MAX_ATTEMPTS"
            fi
        elif [ "$RECOVERY_RETRY_STATE_INVALID" -eq 0 ] &&
             [ "$_retry_count_count" -eq 1 ] &&
             [ "$_retry_deadline_count" -eq 1 ]; then
            _retry_count="$(read_memory recovery_attempt_count)"
            _retry_deadline="$(read_memory recovery_next_retry_monotonic)"
            if ! is_uint "$_retry_count" ||
               ! is_uint "$_retry_deadline"; then
                RECOVERY_RETRY_STATE_INVALID=1
            else
                RECOVERY_ATTEMPTED="$_retry_latch"
                RECOVERY_ATTEMPT_COUNT="$_retry_count"
                RECOVERY_NEXT_RETRY_MONO="$_retry_deadline"
                case "$RECOVERY_ATTEMPTED:$RECOVERY_ATTEMPT_COUNT:$RECOVERY_NEXT_RETRY_MONO" in
                    0:0:0) ;;
                    1:*:*)
                        if [ "$RECOVERY_ATTEMPT_COUNT" -lt 1 ] ||
                           [ "$RECOVERY_ATTEMPT_COUNT" -gt \
                               "$RECOVERY_MAX_ATTEMPTS" ] ||
                           { [ "$RECOVERY_ATTEMPT_COUNT" -lt \
                                   "$RECOVERY_MAX_ATTEMPTS" ] &&
                             [ "$RECOVERY_NEXT_RETRY_MONO" -eq 0 ]; } ||
                           { [ "$RECOVERY_ATTEMPT_COUNT" -eq \
                                   "$RECOVERY_MAX_ATTEMPTS" ] &&
                             [ "$RECOVERY_NEXT_RETRY_MONO" -ne 0 ]; }; then
                            RECOVERY_RETRY_STATE_INVALID=1
                        fi
                        ;;
                    *) RECOVERY_RETRY_STATE_INVALID=1 ;;
                esac
            fi
        elif [ "$RECOVERY_RETRY_STATE_INVALID" -eq 0 ]; then
            RECOVERY_RETRY_STATE_INVALID=1
        fi
    fi

    if [ "$RECOVERY_RETRY_STATE_INVALID" -eq 1 ]; then
        # Unknown bytes might represent already-spent restart authority.
        RECOVERY_ATTEMPTED=1
        RECOVERY_ATTEMPT_COUNT="$RECOVERY_MAX_ATTEMPTS"
        RECOVERY_NEXT_RETRY_MONO=0
        CONSECUTIVE_FAILURES=0
        VALID_STREAK=0
        CONNECTED_SINCE_AT=0
        CONNECTED_SINCE_MONO=0
        CONTINUITY_BROKEN=1
    fi
}

load_recovery_retry_state

now_epoch() {
    if is_uint "${WATCHDOG_NOW_EPOCH:-}"; then
        printf '%s' "$WATCHDOG_NOW_EPOCH"
    else
        date +%s
    fi
}

now_monotonic() {
    if is_uint "${WATCHDOG_NOW_MONO:-}"; then
        printf '%s' "$WATCHDOG_NOW_MONO"
        return
    fi
    _uptime="$(cut -d. -f1 /proc/uptime 2>/dev/null)"
    if is_uint "$_uptime"; then
        printf '%s' "$_uptime"
    else
        printf '0'
    fi
}

log_event() {
    "$TIMEOUT_CMD" -s TERM -k 2 "$LOGGER_TIMEOUT" \
        "$LOGGER_CMD" -t jammonitor-tailscale-watchdog -- "$*" \
        </dev/null >/dev/null 2>&1 7>&- 9>&- &
    ACTIVE_LOG_CHILD=$!
    wait "$ACTIVE_LOG_CHILD" 2>/dev/null || true
    ACTIVE_LOG_CHILD=""
}

save_memory() {
    _tmp="${MEMORY_FILE}.tmp.$$"
    rm -f "$_tmp" 2>/dev/null || return 1

    # Never let mv reinterpret a non-regular destination as a directory, and
    # never replace or follow a link at this private state boundary.
    if [ -e "$MEMORY_FILE" ] || [ -L "$MEMORY_FILE" ]; then
        [ -f "$MEMORY_FILE" ] && [ ! -L "$MEMORY_FILE" ] || return 1
    fi

    if ! {
        printf 'consecutive_failures=%s\n' "$CONSECUTIVE_FAILURES"
        printf 'recovery_attempted=%s\n' "$RECOVERY_ATTEMPTED"
        printf 'recovery_attempt_count=%s\n' "$RECOVERY_ATTEMPT_COUNT"
        printf 'recovery_next_retry_monotonic=%s\n' \
            "$RECOVERY_NEXT_RETRY_MONO"
        printf 'recovery_count=%s\n' "$RECOVERY_COUNT"
        printf 'valid_streak=%s\n' "$VALID_STREAK"
        printf 'condition_since_at=%s\n' "$CONDITION_SINCE_AT"
        printf 'condition_since_mono=%s\n' "$CONDITION_SINCE_MONO"
        printf 'connected_since_at=%s\n' "$CONNECTED_SINCE_AT"
        printf 'connected_since_mono=%s\n' "$CONNECTED_SINCE_MONO"
        printf 'last_connected_at=%s\n' "$LAST_CONNECTED_AT"
        printf 'peer_last_success_at=%s\n' "$PEER_LAST_SUCCESS_AT"
        printf 'process_generation=%s\n' "$PROCESS_GENERATION"
        printf 'last_observed_monotonic=%s\n' "$NOW_MONO"
        printf 'peer_contract_key=%s\n' "$PEER_CONTRACT_KEY"
        printf 'last_status=%s\n' "$STATUS"
    } > "$_tmp"; then
        rm -f "$_tmp" 2>/dev/null || true
        return 1
    fi
    if ! chmod 0600 "$_tmp" 2>/dev/null ||
       ! mv -f "$_tmp" "$MEMORY_FILE"; then
        rm -f "$_tmp" 2>/dev/null || true
        return 1
    fi
    return 0
}

mark_continuity_broken() {
    CONTINUITY_BROKEN=1
    if [ ! -e "$CONTINUITY_BREAK_FILE" ] &&
       [ ! -L "$CONTINUITY_BREAK_FILE" ]; then
        (
            set -C
            umask 077
            : > "$CONTINUITY_BREAK_FILE"
        ) 2>/dev/null || true
    fi
}

clear_continuity_break() {
    if [ ! -e "$CONTINUITY_BREAK_FILE" ] &&
       [ ! -L "$CONTINUITY_BREAK_FILE" ]; then
        CONTINUITY_BROKEN=0
        return 0
    fi
    [ -f "$CONTINUITY_BREAK_FILE" ] &&
        [ ! -L "$CONTINUITY_BREAK_FILE" ] || return 1
    rm -f "$CONTINUITY_BREAK_FILE" || return 1
    CONTINUITY_BROKEN=0
}

persist_memory() {
    if save_memory && clear_continuity_break; then
        return 0
    fi
    mark_continuity_broken
    return 1
}

update_time_state() {
    if [ "$PEER_CONTRACT_KEY" != "$PREVIOUS_PEER_CONTRACT_KEY" ]; then
        # Last-delivery evidence belongs to the exact configured peer contract
        # and must never be inherited by another peer.
        LAST_CONNECTED_AT=0
        PEER_LAST_SUCCESS_AT=0
    fi

    if [ "$STATUS" != "$PREVIOUS_STATUS" ] ||
       [ "$CONDITION_SINCE_MONO" -eq 0 ] ||
       [ "$NOW_MONO" -lt "$CONDITION_SINCE_MONO" ]; then
        CONDITION_SINCE_AT="$NOW_EPOCH"
        CONDITION_SINCE_MONO="$NOW_MONO"
    fi

    if [ "$CONNECTED" = "true" ]; then
        if [ "$CONTINUITY_BROKEN" -eq 1 ] ||
           [ "$PREVIOUS_OBSERVED_MONO" -eq 0 ] ||
           [ "$NOW_MONO" -lt "$PREVIOUS_OBSERVED_MONO" ] ||
           [ $((NOW_MONO - PREVIOUS_OBSERVED_MONO)) -ge \
               "$CONTINUITY_MAX_GAP" ] ||
           [ "$PEER_CONTRACT_KEY" != "$PREVIOUS_PEER_CONTRACT_KEY" ] ||
           [ "$CONNECTED_SINCE_MONO" -eq 0 ] ||
           [ "$NOW_MONO" -lt "$CONNECTED_SINCE_MONO" ]; then
            CONNECTED_SINCE_AT="$NOW_EPOCH"
            CONNECTED_SINCE_MONO="$NOW_MONO"
        fi
        LAST_CONNECTED_AT="$NOW_EPOCH"
    else
        # Unknown is not evidence of continuity. A later successful check must
        # begin a new delivered-connectivity interval instead of spanning an
        # unobserved LocalAPI or schema gap.
        CONNECTED_SINCE_AT=0
        CONNECTED_SINCE_MONO=0
    fi

    CONDITION_UPTIME=$((NOW_MONO - CONDITION_SINCE_MONO))
    [ "$CONDITION_UPTIME" -lt 0 ] && CONDITION_UPTIME=0

    CONNECTIVITY_UPTIME="null"
    if [ "$CONNECTED" = "true" ] && [ "$CONNECTED_SINCE_MONO" -gt 0 ]; then
        CONNECTIVITY_UPTIME=$((NOW_MONO - CONNECTED_SINCE_MONO))
        [ "$CONNECTIVITY_UPTIME" -lt 0 ] && CONNECTIVITY_UPTIME=0
    fi
}

publish_status() {
    STATUS="$(sanitize_token "$STATUS")"
    REASON="$(sanitize_token "$REASON")"
    BACKEND_STATE="$(sanitize_token "$BACKEND_STATE")"
    TAILSCALE_IP="$(sanitize_token "$TAILSCALE_IP")"
    KEY_EXPIRY="$(sanitize_token "$KEY_EXPIRY")"
    RECOVERY_STATE="$(sanitize_token "$RECOVERY_STATE")"
    PEER_STATE="$(sanitize_token "$PEER_STATE")"
    PROCESS_GENERATION="$(sanitize_token "$PROCESS_GENERATION")"
    PROCESS_GENERATION_JSON=null
    if [ "$PEER_STATE" = "invalid_configuration" ]; then
        # This invariant applies even when an earlier dependency or LocalAPI
        # branch determined the primary status.
        CONNECTED=false
        HEALTHY=false
    fi
    if is_uint "$PROCESS_UPTIME_SECONDS" &&
       is_process_generation "$PROCESS_GENERATION"; then
        PROCESS_GENERATION_JSON="\"$PROCESS_GENERATION\""
    else
        # Uptime without the exact PID:start_ticks generation that produced it
        # is not a valid observation and must not cross the schema boundary.
        PROCESS_UPTIME_SECONDS=null
    fi
    update_time_state
    _memory_persisted=0
    if persist_memory; then
        _memory_persisted=1
    else
        # A point-in-time observation cannot authorize uptime or recovery when
        # the episode/continuity memory did not cross its atomic boundary.
        STATUS="watchdog_error"
        REASON="state_persistence_failed"
        HEALTHY=false
        CONNECTED=false
        DEGRADED=true
        RECOVERABLE=false
        CONSECUTIVE_FAILURES=0
        VALID_STREAK=0
        CONNECTED_SINCE_AT=0
        CONNECTED_SINCE_MONO=0
        CONNECTIVITY_UPTIME=null
        CONDITION_SINCE_AT="$NOW_EPOCH"
        CONDITION_SINCE_MONO="$NOW_MONO"
        CONDITION_UPTIME=0
    fi

    _tmp="${STATUS_FILE}.tmp.$$"
    if [ -e "$STATUS_FILE" ] || [ -L "$STATUS_FILE" ]; then
        [ -f "$STATUS_FILE" ] && [ ! -L "$STATUS_FILE" ] || {
            rm -f "$_tmp" 2>/dev/null || true
            return 1
        }
    fi
    if ! {
        printf '{'
        printf '"schema":3,'
        printf '"observed_at":%s,' "$NOW_EPOCH"
        printf '"monotonic_seconds":%s,' "$NOW_MONO"
        printf '"status":"%s",' "$STATUS"
        printf '"reason":"%s",' "$REASON"
        printf '"healthy":%s,' "$HEALTHY"
        printf '"connected":%s,' "$CONNECTED"
        printf '"degraded":%s,' "$DEGRADED"
        printf '"local_api_responsive":%s,' "$LOCAL_API_RESPONSIVE"
        printf '"installed":%s,' "$INSTALLED"
        printf '"service_enabled":%s,' "$SERVICE_ENABLED"
        printf '"service_running":%s,' "$SERVICE_RUNNING"
        printf '"backend_state":"%s",' "$BACKEND_STATE"
        printf '"tailscale_ip":"%s",' "$TAILSCALE_IP"
        printf '"key_expiry":"%s",' "$KEY_EXPIRY"
        printf '"control_online":%s,' "$CONTROL_ONLINE"
        printf '"tun_available":%s,' "$TUN_AVAILABLE"
        printf '"health_warnings":%s,' "$HEALTH_WARNINGS"
        printf '"condition_since_at":%s,' "$CONDITION_SINCE_AT"
        printf '"condition_uptime_seconds":%s,' "$CONDITION_UPTIME"
        printf '"connected_since_at":%s,' "$CONNECTED_SINCE_AT"
        printf '"connectivity_uptime_seconds":%s,' "$CONNECTIVITY_UPTIME"
        printf '"last_connected_at":%s,' "$LAST_CONNECTED_AT"
        printf '"process_generation":%s,' "$PROCESS_GENERATION_JSON"
        printf '"process_uptime_seconds":%s,' "$PROCESS_UPTIME_SECONDS"
        printf '"recoverable":%s,' "$RECOVERABLE"
        printf '"consecutive_failures":%s,' "$CONSECUTIVE_FAILURES"
        printf '"recovery_attempted":%s,' "$RECOVERY_ATTEMPTED"
        printf '"recovery_state":"%s",' "$RECOVERY_STATE"
        printf '"recovery_count":%s,' "$RECOVERY_COUNT"
        printf '"valid_response_streak":%s,' "$VALID_STREAK"
        printf '"peer_configured":%s,' "$PEER_CONFIGURED"
        printf '"peer_state":"%s",' "$PEER_STATE"
        printf '"peer_reachable":%s,' "$PEER_REACHABLE"
        printf '"peer_last_success_at":%s,' "$PEER_LAST_SUCCESS_AT"
        printf '"maintenance_state":"%s",' "$MAINTENANCE_STATE"
        printf '"maintenance_expires_at":%s' "$MAINTENANCE_EXPIRES_AT"
        printf '}\n'
    } > "$_tmp"; then
        rm -f "$_tmp" 2>/dev/null || true
        return 1
    fi
    if ! chmod 0600 "$_tmp" 2>/dev/null ||
       ! mv -f "$_tmp" "$STATUS_FILE"; then
        rm -f "$_tmp" 2>/dev/null || true
        return 1
    fi
    [ -f "$STATUS_FILE" ] && [ ! -L "$STATUS_FILE" ] || return 1

    if [ "$STATUS" != "$PREVIOUS_STATUS" ]; then
        log_event "state ${PREVIOUS_STATUS:-unknown} -> ${STATUS} (${REASON})"
    fi
    if [ "$_memory_persisted" -eq 1 ]; then
        PREVIOUS_OBSERVED_MONO="$NOW_MONO"
        PREVIOUS_PEER_CONTRACT_KEY="$PEER_CONTRACT_KEY"
        PREVIOUS_STATUS="$STATUS"
        PREVIOUS_PROCESS_GENERATION="$PROCESS_GENERATION"
    fi
    [ "$_memory_persisted" -eq 1 ]
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

query_init_state() {
    _init_action="$1"
    INIT_QUERY_STATE="unknown"
    [ -x "$TAILSCALE_INIT" ] || return

    "$TIMEOUT_CMD" -s TERM -k 2 "$STATUS_TIMEOUT" \
        "$TAILSCALE_INIT" "$_init_action" \
        7>&- 9>&- >/dev/null 2>&1 &
    ACTIVE_CHILD=$!
    wait "$ACTIVE_CHILD"
    _init_rc=$?
    ACTIVE_CHILD=""

    case "$_init_rc" in
        0) INIT_QUERY_STATE="true" ;;
        1) INIT_QUERY_STATE="false" ;;
    esac
}

run_projection_capture() {
    : > "$STATUS_PROJECTION" || {
        PROJECTION_FAILURE_REASON="status_parse_error"
        return 1
    }
    PROJECTION_STARTED_CENTISECONDS="$(command_monotonic)"
    "$TIMEOUT_CMD" -s TERM -k 2 "$STATUS_TIMEOUT" \
        /bin/sh -c \
        'ulimit -f "$1" || exit 125; shift; exec "$@"' \
        jammonitor-projection-limit "$STATUS_FILE_BLOCKS" \
        "$JSONFILTER_CMD" -i "$STATUS_OUTPUT" "$@" \
        7>&- 9>&- >"$STATUS_PROJECTION" 2>/dev/null &
    ACTIVE_CHILD=$!
    wait "$ACTIVE_CHILD"
    PROJECTION_RC=$?
    ACTIVE_CHILD=""
    PROJECTION_FINISHED_CENTISECONDS="$(command_monotonic)"
    PROJECTION_DEADLINE_REACHED=false
    if is_uint "$PROJECTION_STARTED_CENTISECONDS" &&
       is_uint "$PROJECTION_FINISHED_CENTISECONDS" &&
       [ "$PROJECTION_STARTED_CENTISECONDS" -gt 0 ] &&
       [ "$PROJECTION_FINISHED_CENTISECONDS" -ge \
           "$PROJECTION_STARTED_CENTISECONDS" ] &&
       [ $((PROJECTION_FINISHED_CENTISECONDS -
               PROJECTION_STARTED_CENTISECONDS)) -ge \
           $((STATUS_TIMEOUT * 100)) ]; then
        PROJECTION_DEADLINE_REACHED=true
    fi

    case "$PROJECTION_RC" in
        0|1)
            ;;
        124|137|143)
            if [ "$PROJECTION_DEADLINE_REACHED" = "true" ]; then
                PROJECTION_FAILURE_REASON="status_parse_timeout"
            else
                PROJECTION_FAILURE_REASON="status_parse_error"
            fi
            return 1
            ;;
        *)
            PROJECTION_FAILURE_REASON="status_parse_error"
            return 1
            ;;
    esac

    _projection_size="$(
        exec 9>&-
        wc -c < "$STATUS_PROJECTION" 2>/dev/null | tr -d ' \r\n'
    )" || {
        PROJECTION_FAILURE_REASON="status_parse_error"
        return 1
    }
    is_uint "$_projection_size" &&
        [ "$_projection_size" -le 65536 ] || {
            PROJECTION_FAILURE_REASON="status_parse_error"
            return 1
        }
}

projection_type_is_valid() {
    case "$1" in
        string|boolean|array|object|null|int|double) ;;
        *) return 1 ;;
    esac
}

parse_projection_type_sequence() {
    _type_sequence="$1"
    PROJECTED_MEMBER_TYPES=""
    PROJECTED_MEMBER_COUNT=0
    while [ -n "$_type_sequence" ]; do
        case "$_type_sequence" in
            *\\\ *)
                _member_type="${_type_sequence%%\\ *}"
                _type_sequence="${_type_sequence#*\\ }"
                ;;
            *)
                _member_type="$_type_sequence"
                _type_sequence=""
                ;;
        esac
        projection_type_is_valid "$_member_type" || return 1
        PROJECTED_MEMBER_COUNT=$((PROJECTED_MEMBER_COUNT + 1))
        PROJECTED_MEMBER_TYPES="${PROJECTED_MEMBER_TYPES}${_member_type} "
    done
}

parse_projection_type_header() {
    _type_header="$1"
    case "$_type_header" in
        object)
            _type_exports=""
            ;;
        *'; object')
            _type_exports="${_type_header% object} "
            ;;
        *)
            return 1
            ;;
    esac

    TYPE_BACKEND=""
    TYPE_IP_ARRAY=""
    TYPE_KEY_EXPIRY=""
    TYPE_ONLINE=""
    TYPE_TUN=""
    TYPE_HEALTH=""
    TYPE_IP_MEMBERS=""
    TYPE_HEALTH_MEMBERS=""
    TYPE_IP_MEMBERS_NORMALIZED=""
    TYPE_HEALTH_MEMBERS_NORMALIZED=""
    _last_type_index=0

    while [ -n "$_type_exports" ]; do
        case "$_type_exports" in
            'export '*'; '*)
                _type_entry="${_type_exports%%; *}"
                _type_exports="${_type_exports#*"$_type_entry; "}"
                ;;
            *)
                return 1
                ;;
        esac
        _type_assignment="${_type_entry#export }"
        _type_name="${_type_assignment%%=*}"
        _type_value="${_type_assignment#*=}"
        [ "$_type_name" != "$_type_assignment" ] || return 1

        case "$_type_name" in
            JM_BT) _type_index=1; TYPE_BACKEND="$_type_value" ;;
            JM_IAT) _type_index=2; TYPE_IP_ARRAY="$_type_value" ;;
            JM_KT) _type_index=3; TYPE_KEY_EXPIRY="$_type_value" ;;
            JM_OT) _type_index=4; TYPE_ONLINE="$_type_value" ;;
            JM_TT) _type_index=5; TYPE_TUN="$_type_value" ;;
            JM_HT) _type_index=6; TYPE_HEALTH="$_type_value" ;;
            JM_IPT) _type_index=7; TYPE_IP_MEMBERS="$_type_value" ;;
            JM_HET) _type_index=8; TYPE_HEALTH_MEMBERS="$_type_value" ;;
            *) return 1 ;;
        esac
        [ "$_type_index" -gt "$_last_type_index" ] || return 1
        _last_type_index="$_type_index"
        case "$_type_name" in
            JM_IPT)
                parse_projection_type_sequence "$_type_value" || return 1
                TYPE_IP_MEMBERS_NORMALIZED="$PROJECTED_MEMBER_TYPES"
                ;;
            JM_HET)
                parse_projection_type_sequence "$_type_value" || return 1
                TYPE_HEALTH_MEMBERS_NORMALIZED="$PROJECTED_MEMBER_TYPES"
                ;;
            *)
                projection_type_is_valid "$_type_value" || return 1
                ;;
        esac
    done
}

type_emits_value() {
    [ -n "$1" ] && [ "$1" != "null" ]
}

reset_projected_status_fields() {
    BACKEND_STATE=""
    TAILSCALE_IP=""
    SELF_IP_KEYS=""
    KEY_EXPIRY=""
    CONTROL_ONLINE=null
    TUN_AVAILABLE=null
    HEALTH_WARNINGS=0
    HEALTH_SCHEMA_VALID=false
}

project_status_fields() {
    PROJECTION_FAILURE_REASON=""
    reset_projected_status_fields
    grep -Fq '\u0000' "$STATUS_OUTPUT" 2>/dev/null 9>&-
    _raw_nul_scan_rc=$?
    case "$_raw_nul_scan_rc" in
        0)
            PROJECTION_FAILURE_REASON="invalid_status_json"
            if ! clear_raw_status_artifacts; then
                PROJECTION_FAILURE_REASON="status_artifact_cleanup_failed"
            fi
            return 1
            ;;
        1)
            ;;
        *)
            PROJECTION_FAILURE_REASON="status_parse_error"
            if ! clear_raw_status_artifacts; then
                PROJECTION_FAILURE_REASON="status_artifact_cleanup_failed"
            fi
            return 1
            ;;
    esac

    _projection_capture_valid=true
    if ! run_projection_capture \
        -t 'JM_BT=@.BackendState' \
        -t 'JM_IAT=@.Self.TailscaleIPs' \
        -t 'JM_KT=@.Self.KeyExpiry' \
        -t 'JM_OT=@.Self.Online' \
        -t 'JM_TT=@.TUN' \
        -t 'JM_HT=@.Health' \
        -t 'JM_IPT=@.Self.TailscaleIPs[*]' \
        -t 'JM_HET=@.Health[*]' \
        -t '@' \
        -e '@.BackendState' \
        -e '@.Self.KeyExpiry' \
        -e '@.Self.Online' \
        -e '@.TUN' \
        -t '@' \
        -e '@.Self.TailscaleIPs[*]' \
        -t '@' \
        -e '@.Health[*]' \
        -t '@'; then
        _projection_capture_valid=false
        _projection_capture_failure="$PROJECTION_FAILURE_REASON"
    fi
    if ! clear_raw_status_artifacts; then
        PROJECTION_FAILURE_REASON="status_artifact_cleanup_failed"
        return 1
    fi
    if [ "$_projection_capture_valid" != "true" ]; then
        PROJECTION_FAILURE_REASON="$_projection_capture_failure"
        return 1
    fi

    exec 8< "$STATUS_PROJECTION" || {
        PROJECTION_FAILURE_REASON="invalid_status_json"
        return 1
    }
    IFS= read -r _type_header <&8 || {
        exec 8<&-
        PROJECTION_FAILURE_REASON="invalid_status_json"
        return 1
    }
    if [ "${#_type_header}" -gt "$PROJECTION_TYPE_HEADER_MAX_BYTES" ]; then
        exec 8<&-
        PROJECTION_FAILURE_REASON="invalid_status_json"
        return 1
    fi
    parse_projection_type_header "$_type_header" || {
        exec 8<&-
        PROJECTION_FAILURE_REASON="invalid_status_json"
        return 1
    }

    BACKEND_STATE=""
    KEY_EXPIRY=""
    CONTROL_ONLINE=null
    TUN_AVAILABLE=null
    for _scalar_name in backend key online tun; do
        case "$_scalar_name" in
            backend) _scalar_type="$TYPE_BACKEND" ;;
            key) _scalar_type="$TYPE_KEY_EXPIRY" ;;
            online) _scalar_type="$TYPE_ONLINE" ;;
            tun) _scalar_type="$TYPE_TUN" ;;
        esac
        _scalar_value=""
        if type_emits_value "$_scalar_type"; then
            IFS= read -r _scalar_value <&8 || {
                exec 8<&-
                PROJECTION_FAILURE_REASON="invalid_status_json"
                return 1
            }
        fi
        case "$_scalar_name:$_scalar_type" in
            backend:string) BACKEND_STATE="$_scalar_value" ;;
            key:string)
                KEY_EXPIRY="$(
                    sanitize_token "$_scalar_value" 8>&- 9>&-
                )"
                ;;
            online:boolean)
                case "$_scalar_value" in
                    true|false) CONTROL_ONLINE="$_scalar_value" ;;
                esac
                ;;
            tun:boolean)
                case "$_scalar_value" in
                    true|false) TUN_AVAILABLE="$_scalar_value" ;;
                esac
                ;;
        esac
    done
    IFS= read -r _scalar_anchor <&8 &&
        [ "$_scalar_anchor" = "object" ] || {
            exec 8<&-
            PROJECTION_FAILURE_REASON="invalid_status_json"
            return 1
        }
    if [ "$TYPE_BACKEND" != "string" ] ||
       ! is_safe_token "$BACKEND_STATE"; then
        exec 8<&-
        PROJECTION_FAILURE_REASON="invalid_status_json"
        return 1
    fi

    TAILSCALE_IP=""
    SELF_IP_KEYS=""
    _ip_projection_valid=true
    _ip_index=0
    _ip_types_normalized="$TYPE_IP_MEMBERS_NORMALIZED"
    for _ip_member_type in $_ip_types_normalized; do
        _ip_index=$((_ip_index + 1))
        _ip_member=""
        if type_emits_value "$_ip_member_type"; then
            IFS= read -r _ip_member <&8 || {
                exec 8<&-
                PROJECTION_FAILURE_REASON="invalid_status_json"
                return 1
            }
        fi
        [ "$_ip_member_type" = "string" ] ||
            _ip_projection_valid=false
        if [ "$_ip_member_type" = "string" ]; then
            if is_tailscale_ip "$_ip_member" 8>&- 9>&-; then
                _ip_key="$(
                    tailscale_ip_key "$_ip_member" 8>&- 9>&-
                )" ||
                    _ip_projection_valid=false
                [ "$_ip_index" -eq 1 ] && TAILSCALE_IP="$_ip_member"
                SELF_IP_KEYS="${SELF_IP_KEYS}${_ip_key} "
            else
                _ip_projection_valid=false
            fi
        fi
    done
    IFS= read -r _ip_anchor <&8 &&
        [ "$_ip_anchor" = "object" ] || {
            exec 8<&-
            PROJECTION_FAILURE_REASON="invalid_status_json"
            return 1
        }
    if [ "$TYPE_IP_ARRAY" != "array" ] ||
       [ "$_ip_projection_valid" != "true" ] ||
       [ "$_ip_index" -eq 0 ] ||
       [ "$_ip_index" -gt 100 ]; then
        TAILSCALE_IP=""
        SELF_IP_KEYS=""
    fi

    HEALTH_WARNINGS=0
    HEALTH_SCHEMA_VALID=false
    _health_projection_valid=true
    _health_count=0
    _health_types_normalized="$TYPE_HEALTH_MEMBERS_NORMALIZED"
    for _health_member_type in $_health_types_normalized; do
        _health_value=""
        if type_emits_value "$_health_member_type"; then
            IFS= read -r _health_value <&8 || {
                exec 8<&-
                PROJECTION_FAILURE_REASON="invalid_status_json"
                return 1
            }
        fi
        _health_count=$((_health_count + 1))
        [ "$_health_member_type" = "string" ] &&
            [ "${#_health_value}" -le 512 ] ||
            _health_projection_valid=false
    done
    IFS= read -r _health_anchor <&8 &&
        [ "$_health_anchor" = "object" ] || {
            exec 8<&-
            PROJECTION_FAILURE_REASON="invalid_status_json"
            return 1
        }
    if IFS= read -r _projection_extra <&8; then
        exec 8<&-
        PROJECTION_FAILURE_REASON="invalid_status_json"
        return 1
    fi
    exec 8<&-

    if [ "$TYPE_HEALTH" = "array" ] &&
       [ "$_health_projection_valid" = "true" ] &&
       [ "$_health_count" -le 100 ]; then
        HEALTH_WARNINGS="$_health_count"
        HEALTH_SCHEMA_VALID=true
    fi
}

command_monotonic() {
    _command_uptime=""
    IFS=' ' read -r _command_uptime _command_ignored \
        <"$UPTIME_FILE" 2>/dev/null || {
        printf '0'
        return
    }

    case "$_command_uptime" in
        *.*)
            _command_seconds="${_command_uptime%%.*}"
            _command_fraction="${_command_uptime#*.}"
            case "$_command_fraction" in
                ""|*[!0-9]*|*.*)
                    printf '0'
                    return
                    ;;
            esac
            ;;
        *)
            _command_seconds="$_command_uptime"
            _command_fraction="0"
            ;;
    esac
    if ! is_uint "$_command_seconds" ||
       [ "${#_command_seconds}" -gt 15 ]; then
        printf '0'
        return
    fi
    _command_hundredths="$(
        printf '%s00' "$_command_fraction" | cut -c1-2
    )"
    case "$_command_hundredths" in
        [0-9][0-9]) ;;
        *)
            printf '0'
            return
            ;;
    esac
    _command_tens="${_command_hundredths%?}"
    _command_ones="${_command_hundredths#?}"
    # /proc/uptime is converted without floating-point arithmetic. Keeping
    # hundredths prevents a short rc137/143 on a whole-second boundary from
    # being mistaken for a timeout-owned signal exit.
    printf '%s' "$((_command_seconds * 100 +
        _command_tens * 10 + _command_ones))"
}

run_status_query() {
    : > "$STATUS_OUTPUT"
    : > "$STATUS_ERROR"
    STATUS_STARTED_CENTISECONDS="$(command_monotonic)"
    "$TIMEOUT_CMD" -s TERM -k 2 "$STATUS_TIMEOUT" \
        /bin/sh -c \
        'ulimit -f "$1" || exit 125; shift; exec "$@"' \
        jammonitor-status-limit "$STATUS_FILE_BLOCKS" "$TAILSCALE_CLI" \
        --socket="$TAILSCALE_SOCKET" status --json --peers=false \
        7>&- 9>&- >"$STATUS_OUTPUT" 2>"$STATUS_ERROR" &
    ACTIVE_CHILD=$!
    wait "$ACTIVE_CHILD"
    STATUS_RC=$?
    ACTIVE_CHILD=""
    STATUS_FINISHED_CENTISECONDS="$(command_monotonic)"
    STATUS_DEADLINE_REACHED=false
    if is_uint "$STATUS_STARTED_CENTISECONDS" &&
       is_uint "$STATUS_FINISHED_CENTISECONDS" &&
       [ "$STATUS_STARTED_CENTISECONDS" -gt 0 ] &&
       [ "$STATUS_FINISHED_CENTISECONDS" -ge \
           "$STATUS_STARTED_CENTISECONDS" ] &&
       [ $((STATUS_FINISHED_CENTISECONDS -
               STATUS_STARTED_CENTISECONDS)) -ge \
           $((STATUS_TIMEOUT * 100)) ]; then
        STATUS_DEADLINE_REACHED=true
    fi
}

inspect_critical_peer_config() {
    CRITICAL_PEER=""
    PEER_CONTRACT_ID="invalid"

    if ! read_critical_peer_contract; then
        PEER_CONFIGURED="$CURRENT_PEER_PRESENT"
        if [ "$PEER_CONFIGURED" = "true" ]; then
            PEER_STATE="invalid_configuration"
            PEER_REACHABLE=false
            PEER_CONTRACT_KEY="invalid"
        fi
        return
    fi
    if [ "$CURRENT_PEER_PRESENT" != "true" ]; then
        PEER_CONTRACT_ID="absent"
        return
    fi

    PEER_CONFIGURED=true
    CRITICAL_PEER="$CURRENT_PEER_VALUE"
    PEER_CONTRACT_KEY="$CURRENT_PEER_KEY"
    PEER_CONTRACT_ID="$CURRENT_PEER_CONTRACT_ID"
    PEER_STATE="unknown"
    PEER_REACHABLE=null
}

read_critical_peer_contract() {
    CURRENT_PEER_PRESENT=false
    CURRENT_PEER_VALUE=""
    CURRENT_PEER_KEY=""
    CURRENT_PEER_CONTRACT_ID="absent"

    # Only a genuinely absent path makes peer proof optional. Any other
    # filesystem object is an operator contract and therefore fails closed.
    if [ ! -e "$CRITICAL_PEER_FILE" ] &&
       [ ! -L "$CRITICAL_PEER_FILE" ]; then
        return 0
    fi
    CURRENT_PEER_PRESENT=true
    CURRENT_PEER_CONTRACT_ID="invalid_object"

    [ ! -L "$CRITICAL_PEER_FILE" ] &&
        [ -f "$CRITICAL_PEER_FILE" ] &&
        [ -r "$CRITICAL_PEER_FILE" ] || return 1

    _critical_peer_before="$(
        "$STAT_CMD" -c '%u:%g:%a:%h:%d:%i:%s' \
            "$CRITICAL_PEER_FILE" 2>/dev/null
    )" || return 1
    _critical_peer_old_ifs="$IFS"
    IFS=:
    set -- $_critical_peer_before
    IFS="$_critical_peer_old_ifs"
    [ "$#" -eq 7 ] &&
        [ "$1" = "$EXPECTED_ROOT_UID" ] &&
        [ "$2" = "$EXPECTED_ROOT_GID" ] &&
        [ "$3" = "600" ] &&
        [ "$4" = "1" ] &&
        is_uint "$5" &&
        is_uint "$6" &&
        is_uint "$7" || return 1
    _critical_peer_size="$7"
    [ "$_critical_peer_size" -gt 0 ] &&
        [ "$_critical_peer_size" -le 254 ] || return 1

    _invalid_peer_bytes="$(
        LC_ALL=C tr -d '0123456789abcdefABCDEF:.\n' \
            <"$CRITICAL_PEER_FILE" 2>/dev/null |
            wc -c | tr -d ' \r\n'
    )"
    [ "$_invalid_peer_bytes" = "0" ] || return 1
    _critical_peer="$(head -n 1 "$CRITICAL_PEER_FILE" 2>/dev/null)" ||
        return 1
    [ -n "$_critical_peer" ] &&
        [ "${#_critical_peer}" -le 253 ] || return 1

    # Accept exactly TARGET or TARGET plus one LF. Metadata, including inode
    # and link count, must be identical across the bounded content read.
    if [ "$_critical_peer_size" -ne "${#_critical_peer}" ] &&
       [ "$_critical_peer_size" -ne $((${#_critical_peer} + 1)) ]; then
        return 1
    fi
    _critical_peer_key="$(tailscale_ip_key "$_critical_peer")" || return 1
    _critical_peer_after="$(
        "$STAT_CMD" -c '%u:%g:%a:%h:%d:%i:%s' \
            "$CRITICAL_PEER_FILE" 2>/dev/null
    )" || return 1
    [ "$_critical_peer_after" = "$_critical_peer_before" ] || return 1

    CURRENT_PEER_VALUE="$_critical_peer"
    CURRENT_PEER_KEY="$_critical_peer_key"
    CURRENT_PEER_CONTRACT_ID="${_critical_peer_before}:${_critical_peer}"
    return 0
}

critical_peer_contract_is_current() {
    _expected_peer_contract_id="$PEER_CONTRACT_ID"
    _expected_peer_value="$CRITICAL_PEER"
    _expected_peer_key="$PEER_CONTRACT_KEY"
    read_critical_peer_contract || return 1
    [ "$CURRENT_PEER_PRESENT" = "true" ] &&
        [ "$CURRENT_PEER_CONTRACT_ID" = "$_expected_peer_contract_id" ] &&
        [ "$CURRENT_PEER_VALUE" = "$_expected_peer_value" ] &&
        [ "$CURRENT_PEER_KEY" = "$_expected_peer_key" ]
}

mark_critical_peer_contract_changed() {
    CRITICAL_PEER=""
    PEER_CONTRACT_KEY="invalid"
    PEER_CONTRACT_ID="invalid"
    PEER_STATE="invalid_configuration"
    PEER_REACHABLE=false
    PEER_LAST_SUCCESS_AT="$PEER_LAST_SUCCESS_BEFORE_OBSERVATION"
}

capture_process_generation() {
    CAPTURED_PROCESS_GENERATION=""
    CAPTURED_PROCESS_UPTIME_SECONDS=null
    case "$PROCESS_NAME" in
        ""|*[!A-Za-z0-9_.-]*) return 1 ;;
    esac
    [ "${#PROCESS_NAME}" -le 15 ] || return 1
    case "$PROCESS_BINARY" in
        /*) ;;
        *) return 1 ;;
    esac
    [ -x "$PROCESS_BINARY" ] || return 1
    command_exists "$READLINK_CMD" || return 1

    _matches=0
    for _stat_path in "$PROC_ROOT"/[0-9]*/stat; do
        [ -r "$_stat_path" ] || continue
        _pid="${_stat_path%/stat}"
        _pid="${_pid##*/}"
        is_uint "$_pid" &&
            [ "${#_pid}" -le 18 ] &&
            [ "$_pid" -gt 1 ] || continue
        _stat_line=""
        IFS= read -r _stat_line < "$_stat_path" || continue
        case "$_stat_line" in
            "$_pid ($PROCESS_NAME) "*) ;;
            *) continue ;;
        esac

        _stat_tail="${_stat_line#*) }"
        set -- $_stat_tail
        [ "$#" -ge 20 ] || {
            continue
        }
        _process_state="$1"
        case "$_process_state" in
            R|S|D|T|t|K|W|P|I) ;;
            *) continue ;;
        esac
        shift 19
        _start_ticks="$1"
        is_uint "$_start_ticks" &&
            [ "${#_start_ticks}" -le 18 ] &&
            [ "$_start_ticks" -gt 0 ] || {
            continue
        }

        _exe_path="$(
            exec 7>&- 9>&-
            "$READLINK_CMD" "$PROC_ROOT/$_pid/exe" \
                2>/dev/null
        )" ||
            continue
        [ "$_exe_path" = "$PROCESS_BINARY" ] || continue

        # Bind the executable and start ticks to one stable /proc sample.
        # Re-reading both sides closes the ordinary PID-reuse race between
        # stat and exe.
        _stat_line_after=""
        IFS= read -r _stat_line_after < "$_stat_path" || continue
        [ "$_stat_line_after" = "$_stat_line" ] || continue
        _exe_path_after="$(
            exec 7>&- 9>&-
            "$READLINK_CMD" "$PROC_ROOT/$_pid/exe" \
                2>/dev/null
        )" || continue
        [ "$_exe_path_after" = "$PROCESS_BINARY" ] || continue

        _matches=$((_matches + 1))
        [ "$_matches" -eq 1 ] || {
            CAPTURED_PROCESS_GENERATION=""
            CAPTURED_PROCESS_UPTIME_SECONDS=null
            return 1
        }
        CAPTURED_PROCESS_GENERATION="${_pid}:${_start_ticks}"
    done

    [ "$_matches" -eq 1 ] &&
        [ -n "$CAPTURED_PROCESS_GENERATION" ] || return 1
    _start_ticks="${CAPTURED_PROCESS_GENERATION#*:}"
    _started_mono=$((_start_ticks / CLOCK_TICKS))
    if [ "$NOW_MONO" -lt "$_started_mono" ]; then
        CAPTURED_PROCESS_GENERATION=""
        CAPTURED_PROCESS_UPTIME_SECONDS=null
        return 1
    fi
    CAPTURED_PROCESS_UPTIME_SECONDS=$((NOW_MONO - _started_mono))
    return 0
}

apply_captured_process_generation() {
    PROCESS_GENERATION="$CAPTURED_PROCESS_GENERATION"
    PROCESS_UPTIME_SECONDS="$CAPTURED_PROCESS_UPTIME_SECONDS"

    if [ -z "$PREVIOUS_PROCESS_GENERATION" ]; then
        PROCESS_GENERATION_STATE="initialized"
    elif [ "$PREVIOUS_PROCESS_GENERATION" = "$PROCESS_GENERATION" ]; then
        PROCESS_GENERATION_STATE="stable"
    else
        PROCESS_GENERATION_STATE="changed"
    fi

    if [ "$PROCESS_GENERATION_STATE" != "stable" ]; then
        CONNECTED_SINCE_AT=0
        CONNECTED_SINCE_MONO=0
    fi
}

observe_process_generation() {
    PROCESS_GENERATION=""
    PROCESS_GENERATION_STATE="unknown"
    PROCESS_UPTIME_SECONDS=null
    capture_process_generation || return 1
    apply_captured_process_generation
}

verify_process_generation_join() {
    _expected_generation="${1:-}"
    PROCESS_JOIN_STATE="unknown"

    if ! capture_process_generation; then
        PROCESS_GENERATION=""
        PROCESS_GENERATION_STATE="unknown"
        PROCESS_UPTIME_SECONDS=null
        CONNECTED_SINCE_AT=0
        CONNECTED_SINCE_MONO=0
        return 1
    fi

    if [ -n "$_expected_generation" ] &&
       [ "$CAPTURED_PROCESS_GENERATION" = "$_expected_generation" ]; then
        PROCESS_GENERATION="$CAPTURED_PROCESS_GENERATION"
        PROCESS_UPTIME_SECONDS="$CAPTURED_PROCESS_UPTIME_SECONDS"
        PROCESS_JOIN_STATE="stable"
        return 0
    fi

    apply_captured_process_generation
    CONNECTED_SINCE_AT=0
    CONNECTED_SINCE_MONO=0
    if [ -n "$_expected_generation" ]; then
        PROCESS_JOIN_STATE="changed"
    fi
    return 1
}

set_process_join_failure() {
    STATUS="running_degraded"
    if [ "$PROCESS_JOIN_STATE" = "changed" ]; then
        REASON="process_restarted"
    else
        REASON="process_generation_unknown"
    fi
    HEALTHY=false
    CONNECTED=null
    DEGRADED=true
    LOCAL_API_RESPONSIVE=null
    BACKEND_STATE=""
    TAILSCALE_IP=""
    SELF_IP_KEYS=""
    KEY_EXPIRY=""
    CONTROL_ONLINE=null
    TUN_AVAILABLE=null
    HEALTH_WARNINGS=0
    HEALTH_SCHEMA_VALID=false
    if [ "$PEER_CONFIGURED" = "true" ] &&
       [ "$PEER_STATE" != "invalid_configuration" ]; then
        PEER_STATE="unknown"
        PEER_REACHABLE=null
        PEER_LAST_SUCCESS_AT="$PEER_LAST_SUCCESS_BEFORE_OBSERVATION"
    fi
    RECOVERABLE=false
    CONSECUTIVE_FAILURES=0
    record_invalid_response
}

publish_process_join_failure() {
    set_process_join_failure
    publish_status
}

publish_artifact_cleanup_failure() {
    STATUS="watchdog_error"
    REASON="status_artifact_cleanup_failed"
    HEALTHY=false
    CONNECTED=null
    DEGRADED=false
    LOCAL_API_RESPONSIVE=null
    reset_projected_status_fields
    RECOVERABLE=false
    record_invalid_response
    CONSECUTIVE_FAILURES=0
    publish_status
}

inspect_maintenance_marker() {
    MAINTENANCE_STATE="none"
    MAINTENANCE_EXPIRES_AT=0
    MAINTENANCE_LEASE_ID="absent"
    if [ ! -e "$MAINTENANCE_FILE" ] &&
       [ ! -L "$MAINTENANCE_FILE" ]; then
        return
    fi

    if [ -L "$MAINTENANCE_FILE" ] ||
       [ ! -f "$MAINTENANCE_FILE" ] ||
       [ ! -r "$MAINTENANCE_FILE" ]; then
        MAINTENANCE_STATE="malformed"
        MAINTENANCE_LEASE_ID="invalid_object"
        return
    fi

    _marker_before="$(
        exec 7>&- 9>&-
        "$STAT_CMD" -c '%u:%g:%a:%d:%i:%s' \
            "$MAINTENANCE_FILE" 2>/dev/null
    )" || {
        MAINTENANCE_STATE="malformed"
        MAINTENANCE_LEASE_ID="metadata_unknown"
        return
    }
    _old_ifs="$IFS"
    IFS=:
    set -- $_marker_before
    IFS="$_old_ifs"
    if [ "$#" -ne 6 ] ||
       [ "$1" != "$EXPECTED_ROOT_UID" ] ||
       [ "$2" != "$EXPECTED_ROOT_GID" ] ||
       [ "$3" != "600" ] ||
       ! is_uint "$4" || ! is_uint "$5" || ! is_uint "$6"; then
        MAINTENANCE_STATE="malformed"
        MAINTENANCE_LEASE_ID="metadata_invalid"
        return
    fi
    _marker_size="$6"
    _expiry=""
    IFS= read -r _expiry < "$MAINTENANCE_FILE" || {
        MAINTENANCE_STATE="malformed"
        MAINTENANCE_LEASE_ID="content_unreadable"
        return
    }
    _marker_after="$(
        exec 7>&- 9>&-
        "$STAT_CMD" -c '%u:%g:%a:%d:%i:%s' \
            "$MAINTENANCE_FILE" 2>/dev/null
    )" || {
        MAINTENANCE_STATE="malformed"
        MAINTENANCE_LEASE_ID="metadata_changed"
        return
    }
    if [ "$_marker_after" != "$_marker_before" ]; then
        MAINTENANCE_STATE="malformed"
        MAINTENANCE_LEASE_ID="metadata_changed"
        return
    fi
    MAINTENANCE_LEASE_ID="${_marker_before}:${_expiry}"
    if ! is_uint "$_expiry" ||
       [ "${#_expiry}" -gt 12 ] ||
       [ "$_marker_size" -ne $((${#_expiry} + 1)) ]; then
        MAINTENANCE_STATE="malformed"
        return
    fi

    MAINTENANCE_EXPIRES_AT="$_expiry"
    if [ "$_expiry" -le "$NOW_EPOCH" ]; then
        MAINTENANCE_STATE="expired"
    elif [ "$_expiry" -gt $((NOW_EPOCH + MAINTENANCE_MAX_FUTURE)) ]; then
        MAINTENANCE_STATE="out_of_bounds"
    else
        MAINTENANCE_STATE="active"
    fi
}

observe_peer() {
    [ "$PEER_CONFIGURED" = "true" ] &&
        [ "$PEER_STATE" = "unknown" ] &&
        [ -n "$CRITICAL_PEER" ] || return
    if ! critical_peer_contract_is_current; then
        mark_critical_peer_contract_changed
        return
    fi

    "$TIMEOUT_CMD" -s TERM -k 2 "$PEER_TIMEOUT" "$TAILSCALE_CLI" \
        --socket="$TAILSCALE_SOCKET" ping \
        --tsmp --c=1 --timeout=3s --until-direct=false -- "$CRITICAL_PEER" \
        7>&- 9>&- >/dev/null 2>&1 &
    ACTIVE_CHILD=$!
    wait "$ACTIVE_CHILD"
    _peer_rc=$?
    ACTIVE_CHILD=""

    if ! critical_peer_contract_is_current; then
        mark_critical_peer_contract_changed
    elif [ "$_peer_rc" -eq 0 ]; then
        PEER_STATE="reachable"
        PEER_REACHABLE=true
        PEER_LAST_SUCCESS_AT="$NOW_EPOCH"
    else
        PEER_STATE="unreachable"
        PEER_REACHABLE=false
    fi
}

critical_peer_is_self() {
    [ "$PEER_CONFIGURED" = "true" ] &&
        [ "$PEER_STATE" = "unknown" ] &&
        [ -n "$CRITICAL_PEER" ] || return 1
    _critical_peer_key="$(tailscale_ip_key "$CRITICAL_PEER")" || return 1

    for _self_ip_key in $SELF_IP_KEYS; do
        [ "$_critical_peer_key" = "$_self_ip_key" ] && return 0
    done
    return 1
}

record_valid_response() {
    CONSECUTIVE_FAILURES=0
    VALID_STREAK=$((VALID_STREAK + 1))
    if [ "$RECOVERY_ATTEMPTED" -eq 1 ] &&
       [ "$VALID_STREAK" -ge "$VALID_STREAK_REQUIRED" ]; then
        RECOVERY_ATTEMPTED=0
        RECOVERY_ATTEMPT_COUNT=0
        RECOVERY_NEXT_RETRY_MONO=0
        RECOVERY_STATE="rearmed"
        log_event "recovery circuit rearmed after ${VALID_STREAK} valid LocalAPI responses"
    fi
}

record_invalid_response() {
    VALID_STREAK=0
}

file_metadata_matches() {
    _metadata_path="$1"
    _metadata_mode="$2"
    [ -f "$_metadata_path" ] &&
        [ ! -L "$_metadata_path" ] || return 1
    _metadata="$(
        exec 7>&- 9>&-
        "$STAT_CMD" -c '%u:%g:%a' "$_metadata_path" \
            2>/dev/null
    )" || return 1
    [ "$_metadata" = \
        "${EXPECTED_ROOT_UID}:${EXPECTED_ROOT_GID}:${_metadata_mode}" ]
}

hash_regular_file() {
    _hash_path="$1"
    HASHED_FILE_SHA256=""
    [ -f "$_hash_path" ] &&
        [ ! -L "$_hash_path" ] || return 1
    _hash_output="$(
        exec 7>&- 9>&-
        "$SHA256_CMD" "$_hash_path" 2>/dev/null
    )" ||
        return 1
    set -- $_hash_output
    [ "$#" -ge 1 ] && is_sha256 "$1" || return 1
    HASHED_FILE_SHA256="$1"
}

verify_init_integrity() {
    is_uint "$EXPECTED_ROOT_UID" &&
        is_uint "$EXPECTED_ROOT_GID" || return 1
    command_exists "$STAT_CMD" &&
        command_exists "$SHA256_CMD" || return 1
    file_metadata_matches "$ROUTER_MANIFEST" 644 || return 1
    file_metadata_matches "$ROUTER_MANIFEST_DIGEST" 644 || return 1
    file_metadata_matches "$TAILSCALE_INIT" 755 || return 1

    _manifest_size="$(
        exec 7>&- 9>&-
        wc -c < "$ROUTER_MANIFEST" 2>/dev/null | tr -d ' \r\n'
    )"
    is_uint "$_manifest_size" &&
        [ "$_manifest_size" -gt 0 ] &&
        [ "$_manifest_size" -le 65536 ] || return 1
    _digest_size="$(
        exec 7>&- 9>&-
        wc -c < "$ROUTER_MANIFEST_DIGEST" 2>/dev/null |
            tr -d ' \r\n'
    )"
    [ "$_digest_size" = "65" ] || return 1
    IFS= read -r _saved_manifest_sha < "$ROUTER_MANIFEST_DIGEST" ||
        return 1
    is_sha256 "$_saved_manifest_sha" || return 1

    hash_regular_file "$ROUTER_MANIFEST" || return 1
    [ "$HASHED_FILE_SHA256" = "$_saved_manifest_sha" ] || return 1

    _init_manifest_matches=0
    _expected_init_sha=""
    while IFS=' ' read -r _manifest_sha _manifest_source _manifest_extra
    do
        [ "$_manifest_source" = "router/tailscale.init" ] || continue
        [ -z "$_manifest_extra" ] &&
            is_sha256 "$_manifest_sha" || return 1
        _init_manifest_matches=$((_init_manifest_matches + 1))
        [ "$_init_manifest_matches" -eq 1 ] || return 1
        _expected_init_sha="$_manifest_sha"
    done < "$ROUTER_MANIFEST"
    [ "$_init_manifest_matches" -eq 1 ] &&
        [ -n "$_expected_init_sha" ] || return 1

    # Recheck metadata after reading the trust files so a replacement cannot
    # be accepted across the validation window.
    file_metadata_matches "$ROUTER_MANIFEST" 644 || return 1
    file_metadata_matches "$ROUTER_MANIFEST_DIGEST" 644 || return 1
    file_metadata_matches "$TAILSCALE_INIT" 755 || return 1
    hash_regular_file "$ROUTER_MANIFEST" || return 1
    [ "$HASHED_FILE_SHA256" = "$_saved_manifest_sha" ] || return 1
    hash_regular_file "$TAILSCALE_INIT" || return 1
    [ "$HASHED_FILE_SHA256" = "$_expected_init_sha" ]
}

prove_process_generation_absent() {
    case "$PROCESS_NAME" in
        ""|*[!A-Za-z0-9_.-]*) return 1 ;;
    esac
    [ "${#PROCESS_NAME}" -le 15 ] || return 1
    for _absent_stat_path in "$PROC_ROOT"/[0-9]*/stat; do
        [ -r "$_absent_stat_path" ] || continue
        _absent_pid="${_absent_stat_path%/stat}"
        _absent_pid="${_absent_pid##*/}"
        is_uint "$_absent_pid" && [ "$_absent_pid" -gt 1 ] || return 1
        _absent_stat_line=""
        IFS= read -r _absent_stat_line < "$_absent_stat_path" || return 1
        case "$_absent_stat_line" in
            "$_absent_pid ($PROCESS_NAME) "*) return 1 ;;
        esac
    done
    return 0
}

rollback_unspent_restart_latch() {
    _rollback_state="$1"
    _rollback_message="$2"
    RECOVERY_ATTEMPTED="$_previous_recovery_attempted"
    RECOVERY_ATTEMPT_COUNT="$_previous_recovery_attempt_count"
    RECOVERY_NEXT_RETRY_MONO="$_previous_recovery_next_retry"
    RECOVERY_COUNT="$_previous_recovery_count"
    RECOVERY_STATE="$_rollback_state"
    RECOVERABLE=false
    CONSECUTIVE_FAILURES=0
    VALID_STREAK=0
    CONNECTED=false
    CONNECTED_SINCE_AT=0
    CONNECTED_SINCE_MONO=0
    CONNECTIVITY_UPTIME=null
    update_time_state
    if ! persist_memory; then
        # The durable provisional latch is safer than accidentally rearming
        # after a failed rollback write.
        # The provisional attempt was already durable. Keep its exact
        # count/deadline rather than accidentally granting fresh authority.
        RECOVERY_ATTEMPTED=1
        RECOVERY_STATE="latch_rollback_failed"
    fi
    log_event "recovery suppressed: $_rollback_message"
    return 1
}

final_restart_authority_is_valid() {
    FINAL_RESTART_SUPPRESSION=""

    # Acquire before every final mutable proof. A transaction that completed
    # between an earlier generation check and this lock could otherwise make
    # stale state look current. Proof helpers close descriptor 7 only in their
    # child context; this shell retains the kernel lock throughout.
    acquire_install_lock
    _final_install_lock_rc=$?
    case "$_final_install_lock_rc" in
        0)
            ;;
        1)
            FINAL_RESTART_SUPPRESSION="install_transaction_active"
            return 1
            ;;
        *)
            FINAL_RESTART_SUPPRESSION="install_lock_invalid"
            return 1
            ;;
    esac

    if ! verify_init_integrity; then
        release_install_lock
        FINAL_RESTART_SUPPRESSION="init_integrity_unknown"
        return 1
    fi

    query_init_state running
    case "$_restart_expected_running:$INIT_QUERY_STATE" in
        true:true)
            ;;
        false:false)
            ;;
        true:false|false:true)
            release_install_lock
            FINAL_RESTART_SUPPRESSION="supervisor_state_changed"
            return 1
            ;;
        *)
            release_install_lock
            FINAL_RESTART_SUPPRESSION="supervisor_state_unknown"
            return 1
            ;;
    esac

    # The query above executes the init. Authenticate the exact installed
    # bytes again after it returns while install authority is still held.
    if ! verify_init_integrity; then
        release_install_lock
        FINAL_RESTART_SUPPRESSION="init_integrity_unknown"
        return 1
    fi

    # Reinspect the manual lease after the executable and supervisor proofs.
    # A cooperating manual maintenance action also needs this lock, so it
    # cannot publish or remove a lease across this final section.
    inspect_maintenance_marker
    if [ "$MAINTENANCE_LEASE_ID" != "$STATUS_MAINTENANCE_LEASE_ID" ] ||
       [ "$MAINTENANCE_STATE" = "active" ]; then
        release_install_lock
        FINAL_RESTART_SUPPRESSION="maintenance_changed"
        if [ "$MAINTENANCE_STATE" = "active" ]; then
            STATUS="maintenance"
            REASON="operator_suppressed"
        fi
        return 1
    fi

    # Process generation is the final external proof. procd can recover a
    # daemon independently of the install lock, so checking it before the
    # second init hash or marker read would leave stale restart authority.
    case "$_restart_expected_running" in
        true)
            if ! verify_process_generation_join \
                "$_restart_expected_generation"; then
                release_install_lock
                FINAL_RESTART_SUPPRESSION="process_generation_changed"
                set_process_join_failure
                return 1
            fi
            ;;
        false)
            if ! prove_process_generation_absent; then
                release_install_lock
                FINAL_RESTART_SUPPRESSION="process_presence_unknown"
                return 1
            fi
            ;;
        *)
            release_install_lock
            FINAL_RESTART_SUPPRESSION="supervisor_state_unknown"
            return 1
            ;;
    esac

    # A successful return deliberately retains descriptor 7 through the
    # bounded restart. No installer or upgrader can enter between this proof
    # and the service action.
    return 0
}

restart_supervised_service_once() {
    _previous_recovery_count="$RECOVERY_COUNT"
    _previous_recovery_attempted="$RECOVERY_ATTEMPTED"
    _previous_recovery_attempt_count="$RECOVERY_ATTEMPT_COUNT"
    _previous_recovery_next_retry="$RECOVERY_NEXT_RETRY_MONO"
    _restart_expected_running="$SERVICE_RUNNING"
    _restart_expected_generation="$STATUS_PROCESS_GENERATION"
    RECOVERY_ATTEMPTED=1
    RECOVERY_ATTEMPT_COUNT=$((RECOVERY_ATTEMPT_COUNT + 1))
    if [ "$RECOVERY_ATTEMPT_COUNT" -eq 1 ]; then
        RECOVERY_NEXT_RETRY_MONO=$((NOW_MONO + RECOVERY_RETRY_SHORT))
    elif [ "$RECOVERY_ATTEMPT_COUNT" -lt "$RECOVERY_MAX_ATTEMPTS" ]; then
        RECOVERY_NEXT_RETRY_MONO=$((NOW_MONO + RECOVERY_RETRY_LONG))
    else
        RECOVERY_NEXT_RETRY_MONO=0
    fi
    RECOVERY_COUNT=$((RECOVERY_COUNT + 1))
    RECOVERY_STATE="restart_requested"
    CONSECUTIVE_FAILURES=0
    VALID_STREAK=0

    # A restart is a real connectivity gap. Reset this before invoking the
    # service so a signal or command failure cannot preserve false uptime.
    CONNECTED=false
    CONNECTED_SINCE_AT=0
    CONNECTED_SINCE_MONO=0

    # The episode latch is the authority that prevents restart loops. Commit
    # it atomically before the service action so a crash at any later
    # instruction leaves a successor safely latched.
    update_time_state
    if ! persist_memory; then
        RECOVERY_ATTEMPTED="$_previous_recovery_attempted"
        RECOVERY_ATTEMPT_COUNT="$_previous_recovery_attempt_count"
        RECOVERY_NEXT_RETRY_MONO="$_previous_recovery_next_retry"
        RECOVERY_COUNT="$_previous_recovery_count"
        RECOVERY_STATE="latch_persist_failed"
        RECOVERABLE=false
        CONSECUTIVE_FAILURES=0
        log_event "recovery suppressed: restart latch could not be persisted"
        publish_status
        return 1
    fi

    if ! final_restart_authority_is_valid; then
        case "$FINAL_RESTART_SUPPRESSION" in
            process_generation_changed)
                rollback_unspent_restart_latch \
                    "restart_generation_changed" \
                    "observed process generation changed"
                ;;
            supervisor_state_changed|process_presence_unknown)
                rollback_unspent_restart_latch \
                    "restart_state_changed" \
                    "supervisor or process state changed"
                ;;
            maintenance_changed)
                rollback_unspent_restart_latch \
                    "maintenance_started" \
                    "maintenance lease appeared or changed"
                ;;
            install_transaction_active)
                rollback_unspent_restart_latch \
                    "install_transaction_active" \
                    "router install or Tailscale upgrade transaction is active"
                ;;
            install_lock_invalid)
                rollback_unspent_restart_latch \
                    "install_lock_invalid" \
                    "shared install lock authority is unproven"
                ;;
            init_integrity_unknown)
                rollback_unspent_restart_latch \
                    "init_integrity_unknown" \
                    "installed init integrity is unproven"
                ;;
            *)
                rollback_unspent_restart_latch \
                    "restart_authority_unknown" \
                    "final restart authority is unknown"
                ;;
        esac
        return 1
    fi

    # Timeout retains descriptor 7 as a bounded guardian if the watchdog is
    # killed. The command child closes it before invoking procd, so neither
    # procd nor tailscaled can inherit the install authority. Descriptor 9 is
    # closed for the whole child tree.
    "$TIMEOUT_CMD" -s TERM -k 2 "$RESTART_TIMEOUT" \
        /bin/sh -c 'exec 7>&-; exec "$@"' \
        jammonitor-watchdog-restart "$TAILSCALE_INIT" restart \
        9>&- >/dev/null 2>&1 &
    ACTIVE_CHILD=$!
    publish_status
    log_event "recovery: requesting bounded supervisor restart attempt"
    wait "$ACTIVE_CHILD"
    _restart_rc=$?
    ACTIVE_CHILD=""
    release_install_lock

    if [ "$_restart_rc" -eq 0 ]; then
        RECOVERY_STATE="restart_completed"
    elif [ "$_restart_rc" -eq 124 ] || [ "$_restart_rc" -eq 137 ] || [ "$_restart_rc" -eq 143 ]; then
        RECOVERY_STATE="restart_timeout"
    else
        RECOVERY_STATE="restart_failed"
    fi
    publish_status
}

handle_eligible_failure() {
    RECOVERABLE=true
    CONSECUTIVE_FAILURES=$((CONSECUTIVE_FAILURES + 1))
    record_invalid_response

    if [ "$NOW_MONO" -lt "$BOOT_GRACE" ]; then
        RECOVERY_STATE="boot_grace"
        return
    fi
    if [ "$CONSECUTIVE_FAILURES" -lt "$FAILURE_THRESHOLD" ]; then
        RECOVERY_STATE="observing"
        return
    fi
    if [ "$RECOVERY_ATTEMPTED" -eq 1 ]; then
        if [ "$RECOVERY_ATTEMPT_COUNT" -ge \
             "$RECOVERY_MAX_ATTEMPTS" ]; then
            RECOVERY_STATE="recovery_exhausted"
            RECOVERABLE=false
            return
        elif [ "$NOW_MONO" -lt "$RECOVERY_NEXT_RETRY_MONO" ]; then
            RECOVERY_STATE="recovery_cooldown"
            return
        fi
    fi
    restart_supervised_service_once
}

reset_observation() {
    STATUS="unknown"
    REASON="unclassified"
    HEALTHY=false
    CONNECTED=null
    DEGRADED=false
    LOCAL_API_RESPONSIVE=null
    INSTALLED=false
    SERVICE_ENABLED=false
    SERVICE_RUNNING=false
    BACKEND_STATE=""
    TAILSCALE_IP=""
    KEY_EXPIRY=""
    CONTROL_ONLINE=null
    TUN_AVAILABLE=null
    HEALTH_WARNINGS=0
    HEALTH_SCHEMA_VALID=false
    RECOVERABLE=false
    RECOVERY_STATE="none"
    PEER_CONFIGURED=false
    PEER_STATE="not_configured"
    PEER_REACHABLE=null
    CRITICAL_PEER=""
    PEER_CONTRACT_KEY="none"
    PEER_CONTRACT_ID="absent"
    MAINTENANCE_STATE="none"
    MAINTENANCE_EXPIRES_AT=0
    MAINTENANCE_LEASE_ID="absent"
    PROCESS_GENERATION=""
    PROCESS_GENERATION_STATE="unknown"
    PROCESS_UPTIME_SECONDS=null
}

observe_once() {
    NOW_EPOCH="$(now_epoch)"
    NOW_MONO="$(now_monotonic)"
    reset_observation
    inspect_maintenance_marker
    STATUS_MAINTENANCE_LEASE_ID="$MAINTENANCE_LEASE_ID"
    inspect_critical_peer_config
    PEER_LAST_SUCCESS_BEFORE_OBSERVATION="$PEER_LAST_SUCCESS_AT"

    if [ ! -x "$TAILSCALE_CLI" ]; then
        STATUS="not_installed"
        REASON="cli_missing"
        CONNECTED=false
        record_invalid_response
        CONSECUTIVE_FAILURES=0
        publish_status
        return
    fi
    INSTALLED=true

    if [ ! -x "$TAILSCALE_INIT" ] ||
       ! command_exists "$TIMEOUT_CMD" ||
       ! command_exists "$JSONFILTER_CMD"; then
        STATUS="watchdog_error"
        REASON="dependency_missing"
        record_invalid_response
        CONSECUTIVE_FAILURES=0
        publish_status
        return
    fi
    # The OpenWrt init is executable code, including for `enabled` and
    # `running`. Never invoke a drifted script even for a nominally read-only
    # query.
    if ! verify_init_integrity; then
        STATUS="watchdog_error"
        REASON="init_integrity_unknown"
        RECOVERY_STATE="init_integrity_unknown"
        record_invalid_response
        CONSECUTIVE_FAILURES=0
        publish_status
        return
    fi

    query_init_state enabled
    case "$INIT_QUERY_STATE" in
        false)
            STATUS="disabled"
            REASON="service_disabled"
            CONNECTED=false
            record_invalid_response
            CONSECUTIVE_FAILURES=0
            publish_status
            return
            ;;
        true)
            ;;
        *)
            STATUS="watchdog_error"
            REASON="service_enabled_query_failed"
            record_invalid_response
            CONSECUTIVE_FAILURES=0
            publish_status
            return
            ;;
    esac
    SERVICE_ENABLED=true

    if [ "$MAINTENANCE_STATE" = "active" ]; then
        STATUS="maintenance"
        REASON="operator_suppressed"
        record_invalid_response
        CONSECUTIVE_FAILURES=0
        publish_status
        return
    fi

    if ! inspect_install_transaction; then
        STATUS="watchdog_error"
        REASON="install_lock_invalid"
        CONNECTED=false
        RECOVERABLE=false
        RECOVERY_STATE="install_lock_invalid"
        record_invalid_response
        CONSECUTIVE_FAILURES=0
        publish_status
        return
    fi
    if [ "$INSTALL_TRANSACTION_STATE" = "active" ]; then
        STATUS="watchdog_error"
        REASON="install_transaction_active"
        CONNECTED=false
        RECOVERABLE=false
        RECOVERY_STATE="install_transaction_active"
        record_invalid_response
        CONSECUTIVE_FAILURES=0
        publish_status
        return
    fi

    query_init_state running
    case "$INIT_QUERY_STATE" in
        false)
            STATUS="daemon_missing"
            REASON="supervisor_inactive"
            CONNECTED=false
            handle_eligible_failure
            publish_status
            return
            ;;
        true)
            ;;
        *)
            STATUS="watchdog_error"
            REASON="service_running_query_failed"
            record_invalid_response
            CONSECUTIVE_FAILURES=0
            publish_status
            return
            ;;
    esac
    SERVICE_RUNNING=true
    PROCESS_PROVEN=0
    if ! observe_process_generation; then
        # A generation that cannot be proven is an unobserved continuity gap,
        # even when the LocalAPI proves delivery at this instant.
        CONNECTED_SINCE_AT=0
        CONNECTED_SINCE_MONO=0
    else
        PROCESS_PROVEN=1
    fi
    STATUS_PROCESS_GENERATION="$PROCESS_GENERATION"

    # A supervisor-owned daemon with a proven live PID but no Unix LocalAPI
    # socket is a narrow, local daemon failure. Unlike arbitrary CLI errors,
    # this observation is strong enough to use the bounded episode recovery
    # circuit.
    if [ "$PROCESS_PROVEN" -eq 1 ] && [ ! -S "$TAILSCALE_SOCKET" ]; then
        if ! verify_process_generation_join "$STATUS_PROCESS_GENERATION"; then
            publish_process_join_failure
            return
        fi
        STATUS="socket_missing"
        REASON="localapi_socket_missing"
        LOCAL_API_RESPONSIVE=false
        handle_eligible_failure
        publish_status
        return
    fi

    run_status_query

    # Status is evidence about one exact tailscaled generation. A successful
    # payload or timeout exit cannot be joined to a daemon that appeared,
    # disappeared, or changed PID:start_ticks while the LocalAPI command ran.
    if ! verify_process_generation_join "$STATUS_PROCESS_GENERATION"; then
        if clear_status_artifacts 2>/dev/null; then
            publish_process_join_failure
        else
            publish_artifact_cleanup_failure
        fi
        return
    fi

    if { [ "$STATUS_RC" -eq 124 ] ||
         [ "$STATUS_RC" -eq 137 ] ||
         [ "$STATUS_RC" -eq 143 ]; } &&
       [ "$STATUS_DEADLINE_REACHED" = "true" ]; then
        if ! clear_status_artifacts 2>/dev/null; then
            publish_artifact_cleanup_failure
            return
        fi
        STATUS="daemon_unresponsive"
        REASON="localapi_timeout"
        LOCAL_API_RESPONSIVE=false
        handle_eligible_failure
        publish_status
        return
    fi

    if [ "$STATUS_RC" -ne 0 ]; then
        if ! clear_status_artifacts 2>/dev/null; then
            publish_artifact_cleanup_failure
            return
        fi
        STATUS="watchdog_error"
        REASON="localapi_command_error"
        LOCAL_API_RESPONSIVE=null
        record_invalid_response
        CONSECUTIVE_FAILURES=0
        publish_status
        return
    fi

    if ! project_status_fields; then
        _projection_failure="$PROJECTION_FAILURE_REASON"
        reset_projected_status_fields
        if ! clear_status_artifacts 2>/dev/null; then
            _projection_failure="status_artifact_cleanup_failed"
        fi
        if [ "$_projection_failure" = \
             "status_artifact_cleanup_failed" ]; then
            publish_artifact_cleanup_failure
            return
        fi
        if ! verify_process_generation_join "$STATUS_PROCESS_GENERATION"; then
            publish_process_join_failure
            return
        fi
        STATUS="watchdog_error"
        case "$_projection_failure" in
            status_parse_timeout|invalid_status_json|status_parse_error|\
            status_artifact_cleanup_failed)
                REASON="$_projection_failure"
                ;;
            *)
                REASON="status_parse_error"
                ;;
        esac
        LOCAL_API_RESPONSIVE=null
        record_invalid_response
        CONSECUTIVE_FAILURES=0
        publish_status
        return
    fi
    if ! clear_status_artifacts; then
        publish_artifact_cleanup_failure
        return
    fi
    if ! verify_process_generation_join "$STATUS_PROCESS_GENERATION"; then
        publish_process_join_failure
        return
    fi

    LOCAL_API_RESPONSIVE=true
    if [ "$PEER_CONFIGURED" = "true" ] &&
       [ "$PEER_STATE" = "unknown" ] &&
       ! critical_peer_contract_is_current; then
        mark_critical_peer_contract_changed
    fi
    if critical_peer_is_self; then
        CRITICAL_PEER=""
        PEER_CONTRACT_ID="invalid"
        PEER_STATE="invalid_configuration"
        PEER_REACHABLE=false
    fi

    case "$BACKEND_STATE" in
        Running)
            STATUS="running"
            REASON="ok"
            CONNECTED=null
            if [ "$PEER_STATE" = "invalid_configuration" ]; then
                STATUS="running_degraded"
                REASON="critical_peer_invalid"
                DEGRADED=true
                CONNECTED=false
            elif [ -z "$TAILSCALE_IP" ]; then
                STATUS="running_degraded"
                REASON="tailnet_ip_missing"
                DEGRADED=true
                CONNECTED=false
            elif [ "$TUN_AVAILABLE" = "false" ]; then
                STATUS="running_degraded"
                REASON="tun_unavailable"
                DEGRADED=true
                CONNECTED=false
            elif [ "$TUN_AVAILABLE" != "true" ]; then
                STATUS="running_degraded"
                REASON="tun_state_unknown"
                DEGRADED=true
            else
                CONNECTED=true
                HEALTHY=true
            fi

            if [ "$CONNECTED" = "true" ] && [ "$HEALTH_WARNINGS" -gt 0 ]; then
                STATUS="running_degraded"
                REASON="health_warning"
                DEGRADED=true
                HEALTHY=false
            fi
            if [ "$CONNECTED" = "true" ] &&
               [ "$HEALTH_SCHEMA_VALID" != "true" ]; then
                STATUS="running_degraded"
                REASON="health_state_unknown"
                DEGRADED=true
                HEALTHY=false
            fi

            if [ "$CONNECTED" = "true" ] &&
               [ "$CONTROL_ONLINE" = "false" ]; then
                STATUS="running_degraded"
                REASON="control_offline"
                DEGRADED=true
                HEALTHY=false
            elif [ "$CONNECTED" = "true" ] &&
                 [ "$CONTROL_ONLINE" != "true" ]; then
                STATUS="running_degraded"
                REASON="control_state_unknown"
                DEGRADED=true
                HEALTHY=false
            fi

            if [ "$CONNECTED" = "true" ]; then
                if [ "$PROCESS_GENERATION_STATE" = "unknown" ]; then
                    STATUS="running_degraded"
                    REASON="process_generation_unknown"
                    DEGRADED=true
                    HEALTHY=false
                elif [ "$PROCESS_GENERATION_STATE" = "changed" ]; then
                    STATUS="running_degraded"
                    REASON="process_restarted"
                    DEGRADED=true
                    HEALTHY=false
                fi

                observe_peer
                if [ "$PEER_CONFIGURED" = "true" ] &&
                   [ "$PEER_REACHABLE" = "false" ]; then
                    STATUS="running_degraded"
                    if [ "$PEER_STATE" = "invalid_configuration" ]; then
                        REASON="critical_peer_invalid"
                    else
                        REASON="critical_peer_unreachable"
                    fi
                    DEGRADED=true
                    HEALTHY=false
                    CONNECTED=false
                fi
            fi
            ;;
        NeedsLogin)
            STATUS="needs_login"
            REASON="authentication_required"
            CONNECTED=false
            ;;
        NeedsMachineAuth)
            STATUS="needs_machine_auth"
            REASON="approval_required"
            CONNECTED=false
            ;;
        Stopped)
            STATUS="stopped"
            REASON="administratively_stopped"
            CONNECTED=false
            ;;
        Starting|NoState|InUseOtherUser)
            STATUS="starting"
            REASON="backend_not_ready"
            CONNECTED=false
            ;;
        *)
            STATUS="unsupported_backend"
            REASON="backend_state_unknown"
            CONNECTED=false
            ;;
    esac

    # Peer observation is another bounded command against the LocalAPI. Join
    # the finished projection to the original generation one final time
    # before any healthy or delivered-connectivity claim is published.
    if ! verify_process_generation_join "$STATUS_PROCESS_GENERATION"; then
        publish_process_join_failure
        return
    fi
    if [ "$PEER_CONFIGURED" = "true" ] &&
       [ "$PEER_CONTRACT_ID" != "invalid" ] &&
       ! critical_peer_contract_is_current; then
        mark_critical_peer_contract_changed
        STATUS="running_degraded"
        REASON="critical_peer_invalid"
        DEGRADED=true
        HEALTHY=false
        CONNECTED=false
    fi
    record_valid_response

    if [ "$MAINTENANCE_STATE" != "none" ] &&
       [ "$MAINTENANCE_STATE" != "active" ] &&
       [ "$STATUS" = "running" ]; then
        STATUS="running_degraded"
        REASON="maintenance_marker_invalid"
        DEGRADED=true
        HEALTHY=false
    fi

    publish_status
}

while :; do
    observe_once
    [ "$RUN_ONCE" -eq 1 ] && break

    "$SLEEP_CMD" "$CHECK_INTERVAL" 7>&- 9>&- &
    ACTIVE_CHILD=$!
    wait "$ACTIVE_CHILD" 2>/dev/null || true
    ACTIVE_CHILD=""
done
