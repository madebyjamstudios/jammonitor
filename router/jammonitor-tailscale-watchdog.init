#!/bin/sh /etc/rc.common

START=96
STOP=01
USE_PROCD=1

start_service() {
    mkdir -p /var/run/jammonitor
    chmod 0700 /var/run/jammonitor

    procd_open_instance
    procd_set_param command /usr/bin/jammonitor-tailscale-watchdog
    # Use procd's finite default crash budget. The semantic watchdog has its
    # own one-attempt episode latch and must not become an infinite crash loop.
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 15
    procd_close_instance
}
