[Unit]
Description=Run the JamMonitor Tailscale semantic watchdog
Documentation=file:/usr/share/doc/jammonitor-tailscale-watchdog/README.md

[Timer]
OnBootSec=2min
OnUnitActiveSec=15s
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=jammonitor-tailscale-watchdog.service

[Install]
WantedBy=timers.target
